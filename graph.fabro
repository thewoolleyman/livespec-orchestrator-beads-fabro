digraph FabroEnemyAcpEscapedCommandLaunch {
    start [shape=Mdiamond, label="Start"]
    agent [shape=box, label="Agent", backend="acp", goal_gate=true, acp.command="EUT_ACP_CONFIG='{\"approval_policy\":\"never\",\"path\":\"a\\\\b\"}' python3 fabro-enemy-unit-tests/_fake_acp_agent.py env-probe /tmp/eut-acp-escaped-record.jsonl", prompt="say hi"]
    exit [shape=Msquare, label="Exit"]
    start -> agent
    agent -> exit
}
