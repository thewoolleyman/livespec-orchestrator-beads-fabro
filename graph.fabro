digraph P4Resources {
    start [shape=Mdiamond, label="Start"]
    check [shape=parallelogram, label="Check", goal_gate=true, script="n=$(nproc); m=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo none); echo \"nproc=$n memory.max=$m cpu.max=$(cat /sys/fs/cgroup/cpu.max 2>/dev/null || echo none)\" >&2; test \"$n\" -eq 2 && test \"$m\" = 4294967296"]
    exit [shape=Msquare, label="Exit"]
    start -> check
    check -> exit
}
