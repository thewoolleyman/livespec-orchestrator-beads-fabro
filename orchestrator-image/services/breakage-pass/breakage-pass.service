# Template rendered by install.sh.  The environment wrapper is essential: the
# pass writes the tenant through file_captured_work_item and therefore needs the
# host's bare BEADS_DOLT_PASSWORD.

[Unit]
Description=livespec breakage-pass — capture failed scheduled workflow jobs
Documentation=https://github.com/thewoolleyman/livespec-orchestrator-beads-fabro
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@RUN_AS_USER@
WorkingDirectory=@PRIMARY_REPO@
ExecStart=/usr/local/bin/with-livespec-env.sh -- /usr/bin/python3 @PLUGIN_ROOT@/scripts/bin/dispatcher.py breakage-pass --repo @PRIMARY_REPO@
TimeoutStartSec=300
Restart=no
