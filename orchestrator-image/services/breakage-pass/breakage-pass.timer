# Fires the one-shot watched-workflow survey every thirty minutes.  The pass
# does not poll: this timer, rather than an in-command loop, provides repeats.

[Unit]
Description=Run livespec scheduled-workflow breakage pass every 30 minutes
Documentation=https://github.com/thewoolleyman/livespec-orchestrator-beads-fabro

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
AccuracySec=1min
Persistent=true
Unit=breakage-pass.service

[Install]
WantedBy=timers.target
