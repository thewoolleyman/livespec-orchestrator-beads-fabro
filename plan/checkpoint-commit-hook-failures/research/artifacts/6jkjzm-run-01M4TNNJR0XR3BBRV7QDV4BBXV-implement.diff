+"""What one failed engine checkpoint is attributed to, as one typed value.
+
+Every surface a checkpoint failure reaches — the dispatch outcome detail, the
+`checkpoint-failure` journal row, the durable ledger comment — renders FROM this
+record and none of them re-derives a field of it. That is the same
+resolve-once-project-everywhere rule the integration contract is held to, and for
+the same reason: several readings of one tail cannot be proven to agree, and a
+disagreement between an outcome detail and the journal row beside it is invisible
+because both are well-formed.
+
+THE ATTRIBUTION IS A CLOSED SET OF FOUR, and each member names the EVIDENCE that
+earned it rather than the severity of the failure:
+
+- `failed-targets` — a structured summary was recognized in the output tail, so
+  the targets and failed hook commands it named ARE the attribution.
+- `observation` — a tail was recorded and no summary in it was recognized. A
+  bounded excerpt is carried, labelled as an observation, and NOTHING in it is
+  asserted to be the cause.
+- `budget-expiry` — the engine reported that the checkpoint operation budget was
+  exceeded. The configured budget and the engine's own measurement are the
+  attribution, and they are kept apart.
+- `engine-error` — no tail was recorded at all, as with `git add failed`. The
+  engine's checkpoint error is the whole attribution.
+
+`observation_excerpt` is non-null only under `observation`, and the budget fields
+only under `budget-expiry`, because each is a claim its own arm earned and no
+other arm holds the evidence for it.
+
+THE CONFIGURED BUDGET AND THE ENGINE'S MEASUREMENT ARE SEPARATE FIELDS AND MUST
+STAY SO. One is what the submitted run configuration asked for and the other is
+what the engine says it spent; presenting the second as the first tells an
+operator the budget is a figure they never configured, which sends them editing
+the wrong thing. And a budget that could not be READ is its own field —
+`configured_budget_unavailable` names the reason — because the clause forbids
+substituting the engine's stock budget for one this derivation could not
+establish.
+
+THE TERMINAL PATCH HAS THREE STATES AND NOT TWO. A failed checkpoint leaves the
+node's uncommitted work outside every stage diff artifact, so the run's terminal
+`run.failed` event carrying it as a patch is the only record that the run held
+work at all. `absent` says the event WAS read and carried none; `unavailable`
+says the stream could not be read, so nothing is known either way. Collapsing the
+second into the first would report a run whose work was never observed as a run
+that produced none, which is the one reading the clause forbids outright.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+__all__: list[str] = [
+    "ATTRIBUTION_BUDGET_EXPIRY",
+    "ATTRIBUTION_ENGINE_ERROR",
+    "ATTRIBUTION_FAILED_TARGETS",
+    "ATTRIBUTION_OBSERVATION",
+    "CHECKPOINT_FAILURE_ENDING",
+    "EVENTS_READ",
+    "NODE_NOT_REPORTED",
+    "TERMINAL_PATCH_ABSENT",
+    "TERMINAL_PATCH_RECORDED",
+    "TERMINAL_PATCH_UNAVAILABLE",
+    "CheckpointFailure",
+]
+
+ATTRIBUTION_FAILED_TARGETS = "failed-targets"
+ATTRIBUTION_OBSERVATION = "observation"
+ATTRIBUTION_BUDGET_EXPIRY = "budget-expiry"
+ATTRIBUTION_ENGINE_ERROR = "engine-error"
+
+TERMINAL_PATCH_RECORDED = "recorded"
+TERMINAL_PATCH_ABSENT = "absent"
+TERMINAL_PATCH_UNAVAILABLE = "unavailable"
+
+# What `events_read` carries when the stream WAS read. Every other value it can
+# hold is the reason a read did not happen, so a reader never has to ask a second
+# question to tell a successful read from an explanation of a failed one.
+EVENTS_READ = "read"
+
+# What the node field renders as when the engine named none. The clause requires
+# saying the node was not reported rather than inferring one, and this is that
+# sentence rather than an empty string, which every rendering surface would
+# silently absorb into its own prose.
+NODE_NOT_REPORTED = "not reported by the engine"
+
+# The ending this attribution IS, named for the `needs_human_kind` field the
+# blocked surfaces read. It is deliberately NOT one of `_fabro_causal_stage`'s
+# three verdicts: those grade which of the needs-human TERMINAL's endings a run
+# reached, and this run never reached that terminal — the engine's checkpoint
+# failed outside every node, so the graph had no edge to route it along. A
+# surface handed this value must therefore describe neither a human gate, nor a
+# pending question, nor an unreadable record.
+CHECKPOINT_FAILURE_ENDING = "checkpoint-failure"
+
+
+@dataclass(frozen=True, kw_only=True)
+class CheckpointFailure:
+    """One run's failed engine checkpoint, attributed once."""
+
+    node: str | None
+    checkpoint_error: str
+    attribution: str
+    failed_targets: tuple[str, ...]
+    failed_hook_commands: tuple[str, ...]
+    events_read: str
+    observation_excerpt: str | None = None
+    configured_budget_seconds: int | None = None
+    configured_budget_unavailable: str | None = None
+    timed_out_operation: str | None = None
+    engine_reported_elapsed: str | None = None
+    terminal_patch_state: str = TERMINAL_PATCH_UNAVAILABLE
+    terminal_patch_bytes: int | None = None
+    terminal_patch_sha256: str | None = None
