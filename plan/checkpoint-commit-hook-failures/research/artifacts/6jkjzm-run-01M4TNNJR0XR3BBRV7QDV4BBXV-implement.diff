+"""What the structured-summary recognizer reads, and what it refuses to read.
+
+The cases a real tail cannot all carry at once, kept here so the attribution
+tests stay about the attribution. Three of them are worth knowing about before
+editing.
+
+A CUT HEADER MUST YIELD NOTHING. The engine records a bounded SUFFIX of the hook
+output, so a summary whose header the bound removed arrives as orphan bullet
+lines. `contracts.md` section "Failed engine checkpoint commit attribution" says
+such a summary is "absent rather than partial" and the Dispatcher "MUST NOT
+reconstruct it"; without this case a recognizer that keyed on the bullets alone
+would pass every other case in the suite while inventing an attribution from any
+dashed list the tail happened to contain.
+
+A SECOND SUMMARY MUST CONTRIBUTE. One commit can run several aggregates, and a
+recognizer that stopped at the first — or kept only the last — would report a
+complete-looking attribution that omits the rest.
+
+A NON-BULLET LINE MUST CLOSE THE LIST. Recipe output resumes after the summary on
+a failing commit, and a collector that stayed open would read the next recipe's
+own output as a target name.
+"""
+
+from __future__ import annotations
+
+from livespec_orchestrator_beads_fabro.commands._fabro_failed_targets import (
+    failed_hook_commands,
+    failed_targets,
+)
+
+
+def test_orphan_bullets_with_no_header_name_no_targets() -> None:
+    """A summary whose header the engine's bound cut away is absent, not partial."""
+    cut = "  - check-per-file-coverage\r\n  - check-coverage\r\n"
+
+    assert failed_targets(output=cut) == ()
+
+
+def test_every_summary_contributes_and_a_repeat_is_named_once() -> None:
+    """Two aggregates in one commit, with one target named by both."""
+    two = (
+        "Failed targets (2):\r\n"
+        "  - check-lint\r\n"
+        "  - check-types\r\n"
+        "::: just check-pre-push\r\n"
+        "Failed targets (2):\r\n"
+        "  - check-types\r\n"
+        "  - check-coverage\r\n"
+    )
+
+    assert failed_targets(output=two) == ("check-lint", "check-types", "check-coverage")
+
+
+def test_output_resuming_after_the_summary_is_not_read_as_a_target() -> None:
+    """A non-blank line that is not a bullet ends the list it follows."""
+    resumed = (
+        "Failed targets (1):\r\n"
+        "  - check-lint\r\n"
+        "error: Recipe `check-lint` failed on line 468 with exit code 1\r\n"
+        "  - this-dash-line-is-not-in-the-summary\r\n"
+    )
+
+    assert failed_targets(output=resumed) == ("check-lint",)
+
+
+def test_a_line_feed_tail_yields_what_a_carriage_return_tail_yields() -> None:
+    """The normalization is the same for both framings, which A4 then binds."""
+    bullets = "Failed targets (1):\n  - check-coverage\n"
+
+    assert failed_targets(output=bullets) == ("check-coverage",)
+
+
+def test_output_resuming_after_the_hook_summary_is_not_read_as_a_command() -> None:
+    """The runner prints nothing after its rows, so a non-row line ends the summary."""
+    resumed = (
+        "summary: (done in 2.00 seconds)\r\n"
+        "\u2717 03-check-pre-commit (1.99 seconds)\r\n"
+        "husky - pre-commit script failed (code 1)\r\n"
+        "\u2717 this-row-is-after-the-summary (0.01 seconds)\r\n"
+    )
+
+    assert failed_hook_commands(output=resumed) == ("03-check-pre-commit",)
+
+
+def test_a_row_whose_glyph_is_not_a_known_marker_ends_the_summary() -> None:
+    """An unrecognized glyph means this is no longer the summary, so reading stops."""
+    unknown = (
+        "summary: (done in 2.00 seconds)\r\n"
+        "\u2717 01-red-green-replay (1.00 seconds)\r\n"
+        "\u2022 02-commit-pairs-source-and-test (0.50 seconds)\r\n"
+        "\u2717 03-check-pre-commit (0.50 seconds)\r\n"
+    )
+
+    assert failed_hook_commands(output=unknown) == ("01-red-green-replay",)
+
+
+def test_a_tail_with_no_run_summary_names_no_hook_command() -> None:
+    """An aggregate refusal with no hook-runner summary names targets only."""
+    aggregate = "Failed targets (1):\r\n  - check-types\r\n"
+
+    assert failed_hook_commands(output=aggregate) == ()
