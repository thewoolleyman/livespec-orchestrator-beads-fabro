index 00000000..cf1cad91
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_failed_targets.py
@@ -0,0 +1,137 @@
+"""The structured failure summary a refused commit's captured output carries.
+
+ONE recognizer for the whole repository, because two readers of the same bytes
+cannot be proven to agree and the disagreement would be invisible: each would
+return a well-formed list of names. The post-merge janitor's aggregate output and
+the engine checkpoint's own hook output are the same bytes in two places, and
+`contracts.md` section "Failed engine checkpoint commit attribution" says in as
+many words that the checkpoint applies "the structured-summary rule of the
+preceding subsection".
+
+WHAT A SUMMARY IS, AND WHY NOTHING ELSE COUNTS. The aggregate runner prints a
+`Failed targets (N):` header followed by one `  - <name>` line per failed target,
+and that header is the ONLY thing that makes the names below it an attribution.
+Recipe banners and a failing recipe's own error lines sit in the same stream and
+say nothing about which target the runner judged failed — a reading that took the
+last recipe it saw would name a passing one as the cause, which is the misreading
+the structured summary exists to prevent.
+
+A CUT HEADER IS AN ABSENCE, NOT A PARTIAL SUMMARY. The engine records a bounded
+SUFFIX of the hook output, so a summary whose header the bound cut away arrives
+as a list of orphan bullet lines. This recognizer returns nothing for them rather
+than reconstructing a summary from bullets it never saw introduced: the orphans
+are indistinguishable from any other dashed list in the output, and the contract
+requires that such a tail fall back to the labelled observation instead.
+
+LINE ENDINGS ARE NORMALIZED BEFORE ANYTHING IS MATCHED. The measured tails end
+their lines in carriage-return line-feed pairs, because the hook runner reframes
+its children's output that way, and a doubled carriage return has been observed
+on a child that already emitted its own. So the normalization collapses both into
+line feeds and the collector passes over the blank lines that leaves, rather than
+treating one as the end of the list — a summary read through a `splitlines` that
+split on the stray carriage return yielded its FIRST target and silently dropped
+the other twenty-three.
+"""
+
+from __future__ import annotations
+
+import re
+
+__all__: list[str] = [
+    "failed_hook_commands",
+    "failed_targets",
+]
+
+_HEADER_RE = re.compile(r"^\s*Failed targets \(\d+\):\s*$")
+_BULLET_RE = re.compile(r"^\s*-\s+(?P<name>\S+)\s*$")
+
+# The hook runner's own per-command run summary: a header naming how long the
+# whole hook took, then one row per command that RAN, each opening with a glyph
+# that says whether it passed. The row's trailing parenthesis carries that
+# command's own duration, and requiring it is what keeps an ordinary two-word
+# output line from reading as a summary row.
+_SUMMARY_HEADER = "summary: (done in "
+_SUMMARY_ROW_RE = re.compile(r"^\s*(?P<marker>\S+)\s+(?P<name>\S+)\s+\([^()]*\)\s*$")
+
+# The glyphs that mark a command failed and passed. Measured 2026-10-13 against
+# the runner this repository pins: the colour-capable form uses U+1F94A for a
+# failure and U+2714 for a pass, while the `--no-colors` form uses U+2717 and
+# U+2713. All four are recognized because the runner chooses its set from its
+# COLOUR setting rather than from whether its output is a terminal, so a commit
+# inside a sandbox can produce either.
+_FAILED_MARKERS = frozenset(("✗", "\U0001f94a"))
+_PASSED_MARKERS = frozenset(("✓", "✔"))
+
+# The variation selector the colour-capable form appends to its pass glyph. It is
+# stripped before the marker is compared, so one glyph does not need two
+# spellings in the sets above.
+_PRESENTATION_SELECTOR = "️"
+
+
+def failed_targets(*, output: str) -> tuple[str, ...]:
+    """Every target named by a structured summary in `output`, in order.
+
+    EVERY summary in the output contributes, not only the last one: one commit
+    can run several aggregates, and naming the targets of whichever ran last
+    would report a complete-looking attribution that omits the rest. Repeats are
+    collapsed so a target named by two summaries is named once.
+    """
+    names: list[str] = []
+    collecting = False
+    for line in _normalized_lines(output=output):
+        if _HEADER_RE.match(line) is not None:
+            collecting = True
+            continue
+        if not collecting or line.strip() == "":
+            continue
+        bullet = _BULLET_RE.match(line)
+        if bullet is None:
+            collecting = False
+            continue
+        names.append(bullet.group("name"))
+    return tuple(dict.fromkeys(names))
+
+
+def failed_hook_commands(*, output: str) -> tuple[str, ...]:
+    """Every hook command a run summary in `output` marks failed, in order.
+
+    EVERY summary contributes, for the same reason the target recognizer's do: a
+    `git commit` runs a pre-commit hook and then a commit-msg hook, so a tail can
+    carry two, and naming only one reports a complete-looking attribution.
+
+    A ROW WHOSE GLYPH IS NEITHER KNOWN MARKER ENDS THE SUMMARY. The runner prints
+    nothing after its rows, so an unrecognized row means this is not the summary
+    any more — and reading on would let the next line's first word stand in for a
+    marker and its second for a command name.
+    """
+    names: list[str] = []
+    collecting = False
+    for line in _normalized_lines(output=output):
+        if _SUMMARY_HEADER in line:
+            collecting = True
+            continue
+        if not collecting or line.strip() == "":
+            continue
+        marker = _row_marker(line=line)
+        if marker is None:
+            collecting = False
+            continue
+        if marker[0] in _FAILED_MARKERS:
+            names.append(marker[1])
+    return tuple(dict.fromkeys(names))
+
+
+def _row_marker(*, line: str) -> tuple[str, str] | None:
+    """One summary row's glyph and command name, or `None` when it is not a row."""
+    row = _SUMMARY_ROW_RE.match(line)
+    if row is None:
+        return None
+    marker = row.group("marker").replace(_PRESENTATION_SELECTOR, "")
+    if marker not in _FAILED_MARKERS and marker not in _PASSED_MARKERS:
+        return None
+    return (marker, row.group("name"))
+
+
+def _normalized_lines(*, output: str) -> tuple[str, ...]:
+    """`output` split into lines with every carriage return collapsed first."""
+    return tuple(output.replace("\r\n", "\n").replace("\r", "\n").split("\n"))
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_port_events.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_port_events.py
index ea12af0d..e6b5ee9b 100644
--- a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_port_events.py
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_port_events.py
@@ -28,9 +28,43 @@ from typing import Any, cast
 from livespec_orchestrator_beads_fabro.effects import JsonParseFailure, parse_json
 
 __all__: list[str] = [
+    "event_name",
+    "event_properties",
     "fabro_event_records_from_stdout",
 ]
 
+# The keys an event's own NAME has been observed under, newest shape last. The
+# dump's `events.jsonl` keys it `type`; a server payload has been observed
+# keying it `event`, `name` and `event_name` in turn, which is why the walk is a
+# candidate list rather than one key. The same list the review-gate telemetry
+# parser walks, for the same reason.
+_NAME_KEYS: tuple[str, ...] = ("event", "name", "event_name", "type")
+
+
+def event_name(*, record: dict[str, Any]) -> str | None:
+    """One event record's own name, or `None` when it carries none."""
+    for key in _NAME_KEYS:
+        value: object = record.get(key)
+        if isinstance(value, str):
+            return value
+    return None
+
+
+def event_properties(*, record: dict[str, Any]) -> dict[str, Any]:
+    """One event record's payload mapping, falling back to the record itself.
+
+    The engine nests an event's own fields under `properties`, and the measured
+    streams carry some of them at the top level as well. Falling back to the
+    RECORD rather than to an empty mapping is what keeps a top-level-only shape
+    readable; a reader that insisted on the nesting would report every field of
+    such a record absent, which is indistinguishable from an event that genuinely
+    carried none.
+    """
+    nested: object = record.get("properties")
+    if isinstance(nested, dict):
+        return cast("dict[str, Any]", nested)
+    return record
+
 
 def fabro_event_records_from_stdout(*, stdout: str) -> tuple[dict[str, Any], ...] | None:
     """The stream's event records, or None when nothing in it was readable."""
diff --git a/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failed_hook_command.py b/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failed_hook_command.py
