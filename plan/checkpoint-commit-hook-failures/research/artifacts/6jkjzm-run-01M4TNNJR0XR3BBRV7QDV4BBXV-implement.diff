+        workflow_toml=tmp_path / "workflow.toml",
+        goal_file=tmp_path / "goal.txt",
+        fabro_bin="fabro",
+        fabro_factory_name="hp",
+        fabro_factory_server=server,
+        fabro_factory_dev_token=None,
