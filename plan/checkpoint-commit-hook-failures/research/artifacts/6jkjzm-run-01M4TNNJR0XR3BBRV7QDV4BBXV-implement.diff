+    assert row["node"] == _NODE
+    assert row["failed_targets"] == []
+    assert row["failed_hook_commands"] == []
+    assert row["terminal_patch_bytes"] is None
+    assert row["terminal_patch_sha256"] is None
+    assert row["terminal_patch_state"] == TERMINAL_PATCH_UNAVAILABLE
+
+
+def test_a_refused_events_read_is_not_an_empty_stream(tmp_path: Path) -> None:
+    """A non-zero exit says nothing about what the run emitted, and names itself."""
