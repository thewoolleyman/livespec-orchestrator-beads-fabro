--- /dev/null
+++ b/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failed_hook_command.py
@@ -0,0 +1,90 @@
+"""A commit-msg refusal with no Failed targets summary names its failed hook command.
+
+Scenario 170's second scenario. Two of the twenty-seven measured hp checkpoint
+failures were the Red-Green-Replay gate refusing the engine's checkpoint commit
+at `commit-msg`, where there is no aggregate runner and therefore no `Failed
+targets` summary at all — the only thing in the tail that says which gate refused
+is the hook runner's own per-command run summary.
+
+THE MARKERS ARE MEASURED, NOT GUESSED. Measured 2026-10-13 against the hook
+runner this repository pins: its colour-capable form marks a failed command with
+U+1F94A and a passing one with U+2714 followed by the U+FE0F presentation
+selector, and that is the form a sandbox commit produces, because the runner
+chooses its glyph set from its colour setting rather than from whether its output
+is a terminal. The fixture carries a PASSING command beside the failing one, so a
+recognizer that read every summary row as a failure would be caught.
+
+THE JOURNAL ROW IS ASSERTED BESIDE THE DETAIL, from ONE attribution. The detail
+is read once and scrolls away; the row is what a later triage reads. Rendering
+both from the same `CheckpointFailure` is what makes them agree, and asserting
+only one of them would let a second derivation drift — neither surface announces
+a disagreement, because both are well-formed.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_attribution import (
+    checkpoint_failure_from_event,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_detail import (
+    checkpoint_failure_detail,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_journal import (
+    checkpoint_failure_record,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    EVENTS_READ,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_checkpoint_event import (
+    checkpoint_failed_event,
+)
+
+_RUN_ID = "01M4PEXR2PY808VPN0807FTF5Y"
+_WORK_ITEM_ID = "bd-ib-6jkjzm"
+_NODE = "fix"
+_CHECKPOINT_ERROR = "git commit failed (exit 1)"
+_FAILED_HOOK = "01-red-green-replay"
+_PASSING_HOOK = "00-no-commit-on-master"
+
+# The hook runner's failure and success glyphs, spelled by code point so the
+# fixture cannot be silently normalized by an editor.
+_FAILED_MARKER = "\U0001f94a"
+_PASSED_MARKER = "✔️"
+
+_TAIL = (
+    f"\r\nrunning {_FAILED_HOOK}\r\n"
+    "\r\n"
+    "red-green-replay: staged test file bytes differ from the Red commit's\r\n"
+    f"error: Recipe `check-{_FAILED_HOOK}` failed with exit code 1\r\n"
+    "\r\n"
+    "summary: (done in 41.20 seconds)\r\n"
+    f"{_PASSED_MARKER} {_PASSING_HOOK} (0.01 seconds)\r\n"
+    f"{_FAILED_MARKER} {_FAILED_HOOK} (41.19 seconds)\r\n"
+)
+
+_EVENTS: tuple[dict[str, Any], ...] = (
+    {
+        "type": "checkpoint.failed",
+        "properties": {"node": _NODE, "error": _CHECKPOINT_ERROR, "output": _TAIL},
+    },
+)
+
+
+def test_the_journal_row_and_the_detail_name_the_failed_hook_command() -> None:
+    """With no aggregate summary, the hook runner's own summary is the attribution."""
+    event = checkpoint_failed_event(records=_EVENTS)
+
+    assert event is not None
+    failure = checkpoint_failure_from_event(event=event, events_read=EVENTS_READ)
+    record = checkpoint_failure_record(
+        work_item_id=_WORK_ITEM_ID, fabro_run_id=_RUN_ID, failure=failure
+    )
+
+    assert record["failed_hook_commands"] == [_FAILED_HOOK]
+    assert record["failed_targets"] == []
+    assert record["node"] == _NODE
+    detail = checkpoint_failure_detail(work_item_id=_WORK_ITEM_ID, run_id=_RUN_ID, failure=failure)
+    assert _FAILED_HOOK in detail
+    assert _PASSING_HOOK not in detail
diff --git a/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failure_arms.py b/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failure_arms.py
