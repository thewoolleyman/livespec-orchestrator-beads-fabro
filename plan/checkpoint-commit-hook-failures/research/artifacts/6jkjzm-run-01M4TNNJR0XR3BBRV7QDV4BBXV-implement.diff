+"""Every reading the checkpoint arm declines to make, and the one it is wired into.
+
+`contracts.md` section "Failed engine checkpoint commit attribution" requires
+that recognition "MUST NOT pre-empt an outcome that the Dispatcher already
+classifies otherwise" and that the events be read from "the dispatch's resolved
+factory target", "never ... a local default target". Both are claims about reads
+that must NOT happen, so each case below asserts the arm returned the generic
+outcome untouched AND, where the point is the read itself, that no command was
+spent at all — a stub that answers whatever it is asked cannot tell a declined
+read from a read that happened to find nothing.
+
+THE WIRING CASE IS THE POSITIVE CONTROL. Without a run that reaches the arm
+through `fabro_run_terminal_outcome` itself, an arm wired to nothing would
+satisfy every declining case in this module.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field, replace
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_events import (
+    NO_SERVER_URL_REASON,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_outcome import (
+    checkpoint_failure_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    EVENTS_READ,
+    NODE_NOT_REPORTED,
+    TERMINAL_PATCH_UNAVAILABLE,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+from livespec_orchestrator_beads_fabro.commands._dispatcher_fabro_terminal import (
+    fabro_run_terminal_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+from livespec_orchestrator_beads_fabro.commands._fabro_port import (
+    FabroInspectResult,
+    FabroPort,
+    FabroTarget,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroCommand
+
+_RUN_ID = "01M4T28A9B79A7B971N9A5J3NW"
+_NODE = "publish_draft"
+_CHECKPOINT_ERROR = "git commit failed (exit 1)"
+_FAILURE_MESSAGE = f"git checkpoint commit failed for node '{_NODE}': {_CHECKPOINT_ERROR}"
+_SERVER_URL = "https://hp-xubuntu.perch-rudd.ts.net:32276"
+
+_FAILED_EVENT: list[dict[str, Any]] = [
+    {
+        "type": "checkpoint.failed",
+        "properties": {
+            "node": _NODE,
+            "error": _CHECKPOINT_ERROR,
+            "output": "Failed targets (1):\r\n  - check-coverage\r\n",
+        },
+    }
+]
+
+# The same failure with NOTHING named: no node, no error text, no output tail.
+# This is what `git add failed` on a stream that keys its fields under names this
+# reader does not know looks like, and the arm has to report the absence rather
+# than infer a node or a cause.
+_BARE_EVENT: list[dict[str, Any]] = [{"type": "checkpoint.failed", "properties": {}}]
+
+# A stream carrying no checkpoint failure at all, with its event name at the TOP
+# level and no `properties` nesting — the other envelope shape the one event
+# reader tolerates.
+_NO_CHECKPOINT: list[dict[str, Any]] = [{"type": "stage.failed", "node": "implement"}]
+
+# A record with no name key under any of the four the reader walks. It must read
+# as an event with no name rather than as a checkpoint failure.
+_UNNAMED: list[dict[str, Any]] = [{"node": "implement", "error": _CHECKPOINT_ERROR}]
+
+# The SAME checkpoint failure with its fields at the top level and no
+# `properties` nesting, which is the shape a run export's `events.jsonl` carries.
+# A reader that insisted on the nesting would report every field of this record
+# absent — indistinguishable from an event that genuinely carried none.
+_FLAT_EVENT: list[dict[str, Any]] = [
+    {
+        "type": "checkpoint.failed",
+        "node_id": _NODE,
+        "message": _CHECKPOINT_ERROR,
+        "stderr": "Failed targets (1):\r\n  - check-per-file-coverage\r\n",
+    }
+]
+
+
+@dataclass(frozen=True, kw_only=True)
+class _Command:
+    exit_code: int
+    stdout: str
+    stderr: str
+
+
+@dataclass(kw_only=True)
+class _Runner:
+    stdout: str
+    exit_code: int = 0
+    calls: list[list[str]] = field(default_factory=list)
+
+    def run(
+        self,
+        *,
+        argv: list[str],
+        cwd: Path,
+        timeout_seconds: float,
+        env: dict[str, str] | None = None,
+        stdin: int | None = None,
+    ) -> FabroCommand:
+        _ = (cwd, timeout_seconds, env, stdin)
+        self.calls.append(argv)
+        return _Command(exit_code=self.exit_code, stdout=self.stdout, stderr="")
+
+
+@dataclass(kw_only=True)
+class _Journal:
+    records: list[dict[str, object]] = field(default_factory=list)
