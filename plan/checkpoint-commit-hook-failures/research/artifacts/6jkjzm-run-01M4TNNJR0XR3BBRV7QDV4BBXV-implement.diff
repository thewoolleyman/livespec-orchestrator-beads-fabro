diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_attribution.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_attribution.py
new file mode 100644
index 00000000..9a675d4f
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_attribution.py
@@ -0,0 +1,195 @@
+"""Composing one failed engine checkpoint's attribution from what was observed.
+
+PURE, and split from the IO leg that gathers its inputs for the usual reason this
+tree splits that way: the decision is a function of an event reading, and a
+decision that reached for the factory itself could not be exercised across every
+state the clause distinguishes without a double for one.
+
+THE LADDER IS ORDERED BY WHAT THE EVIDENCE CAN SUPPORT, not by convenience. A
+budget expiry is the engine saying outright which operation ran out of time, so
+it wins over anything in the tail. A recognized structured summary names what the
+aggregate runner or the hook runner itself judged failed, so it comes next. A
+tail with neither is an OBSERVATION and asserts nothing. With no tail at all
+there is only the engine's own checkpoint error.
+
+EITHER RECOGNIZED SUMMARY EARNS `failed-targets`, which names the ARM rather than
+the list: a `commit-msg` refusal has no aggregate to produce targets and its hook
+command is still a recognized structured attribution, not an observation.
+
+THE EXCERPT IS A SUFFIX, and it is bounded here rather than left to a renderer.
+The engine already recorded a bounded suffix of the hook output, and what matters
+in it is the END — the summary a recognizer would have found sits there, so a
+PREFIX excerpt would reliably show the start of a recipe banner and nothing of
+the failure. Bounding once, in the record, is also what keeps the journal row and
+the dispatch detail quoting the same bytes.
+"""
+
+from __future__ import annotations
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    ATTRIBUTION_BUDGET_EXPIRY,
+    ATTRIBUTION_ENGINE_ERROR,
+    ATTRIBUTION_FAILED_TARGETS,
+    ATTRIBUTION_OBSERVATION,
+    TERMINAL_PATCH_ABSENT,
+    TERMINAL_PATCH_RECORDED,
+    TERMINAL_PATCH_UNAVAILABLE,
+    CheckpointFailure,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_checkpoint_event import (
+    CheckpointFailedEvent,
+    TerminalPatch,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_checkpoint_message import (
+    CheckpointMessage,
+    checkpoint_error_figures,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_failed_targets import (
+    failed_hook_commands,
+    failed_targets,
+)
+
+__all__: list[str] = [
+    "OBSERVATION_EXCERPT_MAX_CHARS",
+    "UNREPORTED_CHECKPOINT_ERROR",
+    "checkpoint_failure_from_event",
+    "checkpoint_failure_from_message",
+]
+
+# What the checkpoint error renders as when the engine reported none. Said rather
+# than left blank, for the same reason the unreported node is: a rendering surface
+# absorbs an empty string into its own prose and the reader cannot tell that the
+# engine was silent.
+UNREPORTED_CHECKPOINT_ERROR = "not reported by the engine"
+
+# The observation excerpt's bound. Wide enough to carry the end of a refusal —
+# the last recipe's own error lines — and far short of the engine's own
+# eight-kilobyte tail, which the clause's bounded-excerpt limit does not admit
+# onto an outcome detail.
+OBSERVATION_EXCERPT_MAX_CHARS = 1200
+
+
+def checkpoint_failure_from_event(
+    *,
+    event: CheckpointFailedEvent,
+    events_read: str,
+    patch: TerminalPatch | None = None,
+    patch_observed: bool = False,
+    configured_budget: int | str | None = None,
+) -> CheckpointFailure:
+    """Attribute one failed checkpoint from its own event.
+
+    `patch_observed` says the terminal event WAS read, which is what separates a
+    run that carried no work from a run whose work nobody could observe. It is a
+    separate argument rather than inferred from `patch is None`, because those two
+    states share that value and the clause owes them opposite words.
+    """
+    tail = event.output_tail
+    targets = () if tail is None else failed_targets(output=tail)
+    hooks = () if tail is None else failed_hook_commands(output=tail)
+    error = event.checkpoint_error or UNREPORTED_CHECKPOINT_ERROR
+    operation, elapsed = checkpoint_error_figures(checkpoint_error=error)
+    return _composed(
+        node=event.node,
+        error=error,
+        tail=tail,
+        targets=targets,
+        hooks=hooks,
+        budget_expiry=elapsed is not None,
+        operation=operation,
+        elapsed=elapsed,
+        configured_budget=configured_budget,
+        events_read=events_read,
+        patch=patch,
+        patch_observed=patch_observed,
+    )
+
+
+def checkpoint_failure_from_message(
+    *,
+    message: CheckpointMessage,
+    events_read: str,
+    configured_budget: int | str | None = None,
+) -> CheckpointFailure:
+    """Attribute one failed checkpoint from the engine's terminal message alone.
+
+    NO TARGET, NO HOOK COMMAND AND NO EXCERPT are produced here, whatever the
+    message happens to contain: the message is not the output tail, and the clause
+    forbids inventing a target, a hook command or a cause when the events could
+    not be read.
+    """
+    return _composed(
+        node=message.node,
+        error=message.checkpoint_error,
+        tail=None,
+        targets=(),
+        hooks=(),
+        budget_expiry=message.budget_expiry,
+        operation=message.timed_out_operation,
+        elapsed=message.engine_reported_elapsed,
+        configured_budget=configured_budget,
+        events_read=events_read,
+        patch=None,
+        patch_observed=False,
+    )
+
+
+def _composed(  # noqa: PLR0913 — kw-only composer; each input is an independent observation.
+    *,
+    node: str | None,
+    error: str,
+    tail: str | None,
+    targets: tuple[str, ...],
+    hooks: tuple[str, ...],
+    budget_expiry: bool,
+    operation: str | None,
+    elapsed: str | None,
+    configured_budget: int | str | None,
+    events_read: str,
+    patch: TerminalPatch | None,
+    patch_observed: bool,
+) -> CheckpointFailure:
+    """Run the ladder once, from whichever surface supplied the observations."""
+    budget = configured_budget if budget_expiry else None
+    named = bool(targets or hooks)
+    return CheckpointFailure(
+        node=node,
+        checkpoint_error=error,
+        attribution=_attribution(budget_expiry=budget_expiry, named=named, tail=tail),
+        failed_targets=targets,
+        failed_hook_commands=hooks,
+        events_read=events_read,
+        observation_excerpt=_excerpt(budget_expiry=budget_expiry, named=named, tail=tail),
+        configured_budget_seconds=budget if isinstance(budget, int) else None,
+        configured_budget_unavailable=budget if isinstance(budget, str) else None,
+        timed_out_operation=operation if budget_expiry else None,
+        engine_reported_elapsed=elapsed if budget_expiry else None,
+        terminal_patch_state=_patch_state(patch=patch, patch_observed=patch_observed),
+        terminal_patch_bytes=None if patch is None else patch.byte_size,
+        terminal_patch_sha256=None if patch is None else patch.sha256,
+    )
+
+
+def _attribution(*, budget_expiry: bool, named: bool, tail: str | None) -> str:
+    """Which of the four arms the evidence in hand earned."""
+    if budget_expiry:
+        return ATTRIBUTION_BUDGET_EXPIRY
+    if named:
+        return ATTRIBUTION_FAILED_TARGETS
+    if tail is None:
+        return ATTRIBUTION_ENGINE_ERROR
+    return ATTRIBUTION_OBSERVATION
+
+
+def _excerpt(*, budget_expiry: bool, named: bool, tail: str | None) -> str | None:
+    """The bounded suffix the observation arm carries, and no other arm does."""
+    if budget_expiry or named or tail is None:
+        return None
+    return tail[-OBSERVATION_EXCERPT_MAX_CHARS:]
+
+
+def _patch_state(*, patch: TerminalPatch | None, patch_observed: bool) -> str:
+    """Recorded, absent, or unavailable — the three-way state, never two."""
+    if patch is not None:
+        return TERMINAL_PATCH_RECORDED
+    return TERMINAL_PATCH_ABSENT if patch_observed else TERMINAL_PATCH_UNAVAILABLE
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_comment.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_comment.py
new file mode 100644
index 00000000..d29d9d7a
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_comment.py
@@ -0,0 +1,256 @@
+"""The DURABLE ledger record of a failed engine checkpoint.
+
+`_dispatcher_checkpoint_detail` renders this ending for the dispatch RESULT and
+`_dispatcher_checkpoint_journal` writes the row the dispatch journal carries.
+Both are transient in the way that matters: the result is read once and the
+journal belongs to one dispatch's own file. The only thing on this tenant that
+outlives the run is a COMMENT, so the attribution is written once, here, before
+the item's blocked transition — the clause requires that order, and it is the
+right one: a record explaining a block that a failed lifecycle write never
+applied is worse than no record.
+
+NAMES AND FIGURES ONLY, NEVER AN EXCERPT. The clause says so outright, and the
+reason is that this record cannot be repaired: `bd comments` offers add and list,
+with no edit and no delete. A pasted hook tail is thousands of bytes of
+engine-authored text on an append-only record, and every byte of it is a hazard
+(see the two below) for no gain the journal row does not already provide.
+
+EVERY NAME IS IDENTIFIER-SHAPED OR LEFT OUT, AND THE OMISSIONS ARE COUNTED. The
+shape test is the one the dispatch's own run labels are admitted by, reused
+rather than restated. A name that fails it did not come from an aggregate
+runner's summary in any form we recognize, so writing it would put arbitrary
+captured text into the record under the heading of a target name — which is the
+excerpt prohibition reached by another route. The COUNT is written because a
+silently shorter list reads as a complete attribution.
+
+TWO HAZARDS COME FROM THE ENGINE'S CHECKPOINT ERROR BEING ENGINE-AUTHORED, and
+both are closed by the primitives the needs-human causal record already uses
+rather than by local copies. A MiniJinja opener anywhere in a ledger comment
+makes every later dispatch of that item refuse at the goal preflight,
+permanently; and a checkpoint error can quote a push against a tokenized origin
+URL, which would put a live credential into an append-only record. So the error
+goes through the same neutralizer the preserve-by-reference pointer uses and the
+credential-shaped value is replaced WHOLESALE.
+
+THE OPENER DETECTOR IS A SEPARATE GATE ON THE WHOLE BODY, not a second check on
+the error. The neutralizer only reaches the fields routed through it; the rest of
+the body is assembled from the work-item id, the run id and the CONFIGURED
+FACTORY NAME, and the last of those is adopter-supplied text that nothing here
+rewrites. So the assembled body is put to the shared detector before it is
+written, and a body that fails is journaled with its reason and NOT written —
+because the blocked transition must happen either way, and an unwritten record
+costs an operator an account while a written opener costs the item every later
+dispatch it will ever have.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from livespec_orchestrator_beads_fabro._store_comments import append_work_item_comment
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    NODE_NOT_REPORTED,
+    TERMINAL_PATCH_ABSENT,
+    TERMINAL_PATCH_RECORDED,
+    CheckpointFailure,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_correlation import (
+    is_identifier_shaped,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_goal import (
+    minijinja_openers_in_text,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_paths import store_config
+from livespec_orchestrator_beads_fabro.commands._dispatcher_preserve_reference_body import (
+    comment_safe_external_text,
+)
+from livespec_orchestrator_beads_fabro.commands._otel_scrub import (
+    CREDENTIAL_URL_RE,
+    REDACTION_MARKER,
+)
+from livespec_orchestrator_beads_fabro.effects import AttemptFailure, attempt
+from livespec_orchestrator_beads_fabro.errors import (
+    BeadsCommandError,
+    BeadsConnectionError,
+    BeadsCredentialMissingError,
+    BeadsMappingError,
+    BeadsTenantMissingError,
+    ConnectionPrefixMissingError,
+    LivespecConfigUnreadableError,
+    WorkItemNotFoundError,
+)
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import JournalWriter
+
+__all__: list[str] = [
+    "CHECKPOINT_FAILURE_COMMENT_MARKER",
+    "checkpoint_failure_comment_body",
+    "record_checkpoint_failure_comment",
+]
+
+CHECKPOINT_FAILURE_COMMENT_MARKER = "livespec-checkpoint-failure"
+
+_COMMENT_STAGE = "checkpoint-failure-comment"
+_COMMENT_ERROR_STAGE = "checkpoint-failure-comment-error"
+_NONE_NAMED = "(none named)"
+
+# The write's whole absorbed set, which includes RESOLVING the store as well as
+# reaching it. `store_config` is inside the attempt for that reason: a repository
+# whose connection block cannot be read is a fact about the configuration, and
+# raising it here would convert a lost durable record into a dispatch-ending
+# traceback AFTER the run had already ended — while the lifecycle write that
+# matters is `_dispatcher_blocked`'s and has its own error arm.
+_LEDGER_WRITE_ERRORS = (
+    OSError,
+    WorkItemNotFoundError,
+    BeadsCommandError,
+    BeadsConnectionError,
+    BeadsCredentialMissingError,
+    BeadsMappingError,
+    BeadsTenantMissingError,
+    ConnectionPrefixMissingError,
+    LivespecConfigUnreadableError,
+)
+
+_EXCERPT_NOTICE = (
+    "this record carries names and figures only: no excerpt of the captured hook "
+    "output is included, and the engine's checkpoint error above is sanitized by "
+    "the writer (MiniJinja openers are rewritten to bracket forms, because a "
+    "ledger comment carrying one refuses every later dispatch of this item, and a "
+    f"credential-shaped value is replaced wholesale with `{REDACTION_MARKER}`)."
+)
+
+
+def record_checkpoint_failure_comment(
+    *,
+    repo: Path,
+    work_item_id: str,
+    run_id: str | None,
+    factory: str,
+    failure: CheckpointFailure,
+    journal: JournalWriter,
+) -> None:
+    """Append the attribution to the item, once, and journal what happened.
+
+    A ledger write failure is JOURNALED and never raised. The run has already
+    ended and the lifecycle write that matters is `_dispatcher_blocked`'s, which
+    has its own error arm; losing this record costs an operator the durable
+    account, which is worth a journal row and is not worth converting into a
+    dispatch failure after the fact.
+    """
+    body = checkpoint_failure_comment_body(
+        work_item_id=work_item_id, run_id=run_id, factory=factory, failure=failure
+    )
+    openers = minijinja_openers_in_text(source=CHECKPOINT_FAILURE_COMMENT_MARKER, text=body)
+    if openers:
+        journal.append(
+            record={
+                "stage": _COMMENT_ERROR_STAGE,
+                "work_item_id": work_item_id,
+                "reason": f"template-opener-present: {openers[0].opener}",
+            }
+        )
+        return
+    written = attempt(
+        action=lambda: append_work_item_comment(
+            path=store_config(repo=repo), work_item_id=work_item_id, body=body
+        ),
+        exceptions=_LEDGER_WRITE_ERRORS,
+    )
+    record: dict[str, object] = {
+        "stage": _COMMENT_ERROR_STAGE if isinstance(written, AttemptFailure) else _COMMENT_STAGE,
+        "work_item_id": work_item_id,
+    }
+    if isinstance(written, AttemptFailure):
+        record["reason"] = type(written.error).__name__
+    journal.append(record=record)
+
+
+def checkpoint_failure_comment_body(
+    *,
+    work_item_id: str,
+    run_id: str | None,
+    factory: str,
+    failure: CheckpointFailure,
+) -> str:
+    """Render the record. PURE, so every claim it makes is testable in isolation."""
+    hooks = _shaped(names=failure.failed_hook_commands)
+    targets = _shaped(names=failure.failed_targets)
+    omitted = len(failure.failed_hook_commands) + len(failure.failed_targets)
+    omitted -= len(hooks) + len(targets)
+    lines = [
+        CHECKPOINT_FAILURE_COMMENT_MARKER,
+        "",
+        f"work-item: {work_item_id}",
+        f"run id: {run_id or '(not parsed from the launch output)'}",
+        f"factory: {factory}",
+        f"node: {failure.node or NODE_NOT_REPORTED}",
+        f"checkpoint error: {_safe(text=failure.checkpoint_error)}",
+        f"attribution: {failure.attribution}",
+        f"failed hook commands: {', '.join(hooks) or _NONE_NAMED}",
+        f"failed targets: {', '.join(targets) or _NONE_NAMED}",
+        f"names left out as not identifier-shaped: {omitted}",
+        *_budget_lines(failure=failure),
+        *_patch_lines(failure=failure),
+        "",
+        (
+            "decision: the engine's own checkpoint commit failed outside every "
+            "workflow node, so no agent asked anything and no answer is owed; "
+            "triage the attribution above, then release the item with "
+            f"`resolve-blocked:{work_item_id}:ready` to re-dispatch, or leave it "
+            "blocked"
+        ),
+        "",
+        _EXCERPT_NOTICE,
+    ]
+    return "\n".join(lines)
+
+
+def _budget_lines(*, failure: CheckpointFailure) -> tuple[str, ...]:
+    """The two budget figures, kept apart, and only on the arm that earned them."""
+    if failure.engine_reported_elapsed is None:
+        return ()
+    configured = (
+        f"{failure.configured_budget_seconds}s"
+        if failure.configured_budget_seconds is not None
+        else f"unavailable: {failure.configured_budget_unavailable}"
+    )
+    return (
+        f"timed-out git operation: {failure.timed_out_operation or NODE_NOT_REPORTED}",
+        f"configured checkpoint commit budget: {configured}",
+        f"engine-reported elapsed (the engine's measurement): {failure.engine_reported_elapsed}",
+    )
+
+
+def _patch_lines(*, failure: CheckpointFailure) -> tuple[str, ...]:
+    """The terminal patch by SIZE and DIGEST, so a pointer naming no stage
+    artifact is not read as a run that held no work. The unavailable state says
+    so and names the reason rather than reporting an absence nobody measured.
+    """
+    if failure.terminal_patch_state == TERMINAL_PATCH_RECORDED:
+        return (
+            f"terminal patch bytes: {failure.terminal_patch_bytes}",
+            f"terminal patch sha256: {failure.terminal_patch_sha256}",
+        )
+    if failure.terminal_patch_state == TERMINAL_PATCH_ABSENT:
+        return ("terminal patch: the run's terminal event was read and carried none",)
+    return (
+        (
+            "terminal patch: UNAVAILABLE rather than absent — this run's events "
+            f"could not be read ({failure.events_read})"
+        ),
+    )
+
+
+def _shaped(*, names: tuple[str, ...]) -> tuple[str, ...]:
+    """The names this record may carry, which are the identifier-shaped ones."""
+    return tuple(name for name in names if is_identifier_shaped(value=name))
+
+
+def _safe(*, text: str) -> str:
+    """Engine text made safe for an append-only comment. See the module docstring."""
+    if CREDENTIAL_URL_RE.search(text) is not None:
+        return REDACTION_MARKER
+    return comment_safe_external_text(text=text)
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_detail.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_detail.py
new file mode 100644
index 00000000..c8d9713c
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_detail.py
@@ -0,0 +1,155 @@
+"""The operator-facing detail a failed engine checkpoint reports.
+
+Split from the routing that produces it for the same reason
+`_dispatcher_needs_human_detail` is: the routing decides WHICH outcome a run
+reached, while this is the pure rendering of one of them, and keeping the render
+here is what lets it name every attributed target without the routing module
+growing a second concern.
+
+THE DETAIL'S OWN BOUND MAY NOT DROP A NAMED TARGET. `contracts.md` section
+"Failed engine checkpoint commit attribution" says so outright, and the reason is
+the measurement behind this whole clause: reading the summary is what separated
+fifteen per-file-coverage failures from five `check-master-ci-green` ones from two
+Red-Green-Replay refusals, and a detail that truncated the list would hand the
+operator back the same undifferentiated failure the clause exists to retire.
+
+THE VALVE IS NAMED BECAUSE THE LIFECYCLE DOES NOT BRANCH. The item rests at
+`blocked` with `needs-human` and `resolve-blocked:<id>:ready` is its only exit, so
+a detail that described the state without naming the exit would describe a state
+with no way out — the same rule `_dispatcher_needs_human_detail` holds to.
+"""
+
+from __future__ import annotations
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    NODE_NOT_REPORTED,
+    TERMINAL_PATCH_ABSENT,
+    TERMINAL_PATCH_RECORDED,
+    CheckpointFailure,
+)
+
+__all__: list[str] = [
+    "checkpoint_failure_detail",
+]
+
+_UNKNOWN_RUN = "unknown-run"
+
+# The label the unrecognized-tail excerpt is carried under. It says in as many
+# words that the excerpt is an OBSERVATION and not a cause, because the clause
+# forbids asserting that any hook, target or recipe in it caused the failure —
+# and an unlabelled excerpt reads as exactly that assertion.
+_OBSERVATION_LABEL = (
+    " ".join(
+        (
+            "no structured failure summary was recognized in the checkpoint's output tail,",
+            "so the following is an OBSERVATION of that tail and NOT a claim that any",
+            "hook, target or recipe in it caused the failure:",
+        )
+    )
+    + " "
+)
+
+
+def checkpoint_failure_detail(
+    *,
+    work_item_id: str,
+    run_id: str | None,
+    failure: CheckpointFailure,
+) -> str:
+    """Render one failed engine checkpoint for the operator who has to triage it."""
+    run_label = _UNKNOWN_RUN if run_id is None else run_id
+    node = NODE_NOT_REPORTED if failure.node is None else failure.node
+    clauses = (
+        (
+            f"run {run_label} ended because the engine's own checkpoint commit of "
+            f"node {node} failed, outside every workflow node — the graph has no "
+            "edge for an engine error, so no agent asked anything and there is no "
+            "question to answer"
+        ),
+        f"the engine's checkpoint error: {failure.checkpoint_error}",
+        *_attribution(failure=failure),
+        _preservation(failure=failure),
+        (
+            "no run is waiting and the decision lives in the ledger: triage the "
+            f"attribution above, then release the item with "
+            f"`resolve-blocked:{work_item_id}:ready` to re-dispatch, or leave it "
+            "blocked"
+        ),
+    )
+    return "; ".join(clauses)
+
+
+def _attribution(*, failure: CheckpointFailure) -> tuple[str, ...]:
+    """The evidence clauses, each rendered only by the arm that earned it.
+
+    THE TWO NAME LISTS GET THEIR OWN CLAUSES rather than one merged list, because
+    they come from different tools and the triage differs: a failed target is a
+    check to fix, while a failed hook command says WHICH gate refused — and for a
+    `commit-msg` refusal, which runs no aggregate at all, the hook command is the
+    only name there is.
+    """
+    if failure.engine_reported_elapsed is not None:
+        return _budget(failure=failure)
+    if failure.observation_excerpt is not None:
+        return (f"{_OBSERVATION_LABEL}{failure.observation_excerpt}",)
+    clauses: list[str] = []
+    if failure.failed_hook_commands:
+        clauses.append(f"failed hook commands: {', '.join(failure.failed_hook_commands)}")
+    if failure.failed_targets:
+        clauses.append(f"failed targets: {', '.join(failure.failed_targets)}")
+    if clauses:
+        return tuple(clauses)
+    return ("the engine's checkpoint error is the whole attribution: no output tail",)
+
+
+def _budget(*, failure: CheckpointFailure) -> tuple[str, ...]:
+    """The budget arm, which keeps the configured figure and the engine's apart.
+
+    THE ENGINE'S FIGURE IS LABELLED AS THE ENGINE'S MEASUREMENT, because the two
+    numbers answer different questions and the clause forbids presenting one as
+    the other: a reader told that 900004ms is "the budget" goes looking for a
+    configuration key holding that value, and there is none.
+
+    A CONFIGURED BUDGET THAT COULD NOT BE READ SAYS SO AND NAMES THE REASON. The
+    engine's stock budget is NOT substituted — that would grade the failure
+    against less time than the configuration asks for, silently, because the
+    smaller figure is just as well-formed a number.
+    """
+    operation = failure.timed_out_operation or "the checkpoint's git operation"
+    if failure.configured_budget_seconds is not None:
+        budget = f"{failure.configured_budget_seconds}s, from the submitted run configuration"
+    else:
+        budget = (
+            "NOT AVAILABLE and deliberately not replaced by the engine's stock "
+            f"budget: {failure.configured_budget_unavailable}"
+        )
+    return (
+        f"the checkpoint operation budget was exceeded by {operation}",
+        f"configured checkpoint commit budget: {budget}",
+        (
+            "the engine's own measurement of the elapsed time: "
+            f"{failure.engine_reported_elapsed} (the engine's figure, NOT the configured budget)"
+        ),
+    )
+
+
+def _preservation(*, failure: CheckpointFailure) -> str:
+    """What a rework can start FROM, in the three states the evidence admits.
+
+    A failed checkpoint leaves the node's uncommitted work outside every stage
+    diff artifact, so the terminal patch is the only record that the run held any.
+    UNAVAILABLE is kept apart from ABSENT because a run whose work was never
+    observed must not be reported as a run that produced none.
+    """
+    if failure.terminal_patch_state == TERMINAL_PATCH_RECORDED:
+        return (
+            f"the run's terminal patch carries {failure.terminal_patch_bytes} bytes "
+            f"of uncommitted work, sha256 {failure.terminal_patch_sha256}; the "
+            "preserve-by-reference pointer on the item is the retrieval route"
+        )
+    if failure.terminal_patch_state == TERMINAL_PATCH_ABSENT:
+        return "the run's terminal event was read and carried no terminal patch"
+    return (
+        "whether the run held uncommitted work is UNAVAILABLE rather than absent: "
+        f"its events could not be read ({failure.events_read})"
+    )
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_events.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_events.py
new file mode 100644
index 00000000..519eb881
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_events.py
@@ -0,0 +1,97 @@
+"""Reading ONE run's events for the checkpoint arm, or saying why it could not.
+
+Split from the arm that consumes it because the two change for different reasons:
+this answers "what did the dispatch's own factory say about this run", while the
+arm decides what to do about it. Keeping them apart is also what makes every
+unread REASON exercisable — each arm below is a different measurement failing,
+and the clause requires `events_read` to name which.
+
+AN UNREAD STREAM IS A NAMED REASON, NEVER AN EMPTY ONE. "Read failure is not
+absence" is the governing rule for every consumer of these streams: a run whose
+probe errored and a run that emitted nothing support opposite conclusions, and
+collapsing them would let a probe outage read as a healthy, silent run. Here the
+cost is sharper still, because the reason is what the clause requires the journal
+row to carry.
+
+THE FACTORY IS THE DISPATCH'S OWN. A factory declaring no server url is reported
+UNREAD rather than surveyed through whatever a bare client would default to: on
+this fleet that default is loopback, and it answers for a run living on `hp` with
+a clean, plausible, empty result.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from livespec_orchestrator_beads_fabro.commands._fabro_checkpoint_event import (
+    CheckpointFailedEvent,
+    TerminalPatch,
+    checkpoint_failed_event,
+    terminal_patch,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_port import fabro_port_for_plan
+from livespec_orchestrator_beads_fabro.commands._fabro_port_events import (
+    fabro_event_records_from_stdout,
+)
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+    from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroRunner
+
+__all__: list[str] = [
+    "CHECKPOINT_EVENTS_TIMEOUT_SECONDS",
+    "NO_SERVER_URL_REASON",
+    "CheckpointEventsReading",
+    "read_checkpoint_events",
+]
+
+# The events read is one short JSON fetch against a factory the dispatch has
+# already been talking to, so it is bounded well below the `ps` survey's minute:
+# a slow answer is better reported as an unread stream than waited on while a
+# terminal dispatch holds its caller open.
+CHECKPOINT_EVENTS_TIMEOUT_SECONDS = 30.0
+
+NO_SERVER_URL_REASON = "the dispatch's resolved factory declares no server url"
+_UNREADABLE_REASON = "the run's event stream was not a readable event payload"
+
+
+@dataclass(frozen=True, kw_only=True)
+class CheckpointEventsReading:
+    """One run's events as this dispatch could read them.
+
+    `unread_reason` is None exactly when the stream WAS read, so a consumer never
+    has to ask a second question to tell a successful read from an explanation of
+    a failed one. `event` is None on a read stream that carried no checkpoint
+    failure, which is the ordinary case for most failed runs.
+    """
+
+    unread_reason: str | None
+    event: CheckpointFailedEvent | None = None
+    patch: TerminalPatch | None = None
+
+
+def read_checkpoint_events(
+    *,
+    plan: DispatchPlan,
+    run_id: str,
+    runner: FabroRunner,
+) -> CheckpointEventsReading:
+    """Read this run's events from the dispatch's own factory, or say why not."""
+    if plan.fabro_factory_server is None:
+        return CheckpointEventsReading(unread_reason=NO_SERVER_URL_REASON)
+    events = fabro_port_for_plan(plan=plan, runner=runner).events(
+        run_id=run_id, timeout_seconds=CHECKPOINT_EVENTS_TIMEOUT_SECONDS
+    )
+    if events.command.exit_code != 0:
+        return CheckpointEventsReading(
+            unread_reason=f"fabro events exited {events.command.exit_code}"
+        )
+    records = fabro_event_records_from_stdout(stdout=events.command.stdout)
+    if records is None:
+        return CheckpointEventsReading(unread_reason=_UNREADABLE_REASON)
+    return CheckpointEventsReading(
+        unread_reason=None,
+        event=checkpoint_failed_event(records=records),
+        patch=terminal_patch(records=records),
+    )
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_journal.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_journal.py
new file mode 100644
index 00000000..85bd985f
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_journal.py
@@ -0,0 +1,48 @@
+"""The `checkpoint-failure` journal row one failed engine checkpoint writes.
+
+EVERY KEY THE CLAUSE NAMES IS WRITTEN ON EVERY ROW, nulls included. An omitted
+key is what a row from a build predating this attribution looks like, so a reader
+could not tell "this arm reported nothing here" from "this build never asked" —
+and the arm-specific keys are exactly the ones a triager filters on.
+"""
+
+from __future__ import annotations
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    CheckpointFailure,
+)
+
+__all__: list[str] = [
+    "CHECKPOINT_FAILURE_STAGE",
+    "checkpoint_failure_record",
+]
+
+CHECKPOINT_FAILURE_STAGE = "checkpoint-failure"
+
+
+def checkpoint_failure_record(
+    *,
+    work_item_id: str,
+    fabro_run_id: str | None,
+    failure: CheckpointFailure,
+) -> dict[str, object]:
+    """Render the journal row for one failed engine checkpoint."""
+    return {
+        "stage": CHECKPOINT_FAILURE_STAGE,
+        "work_item_id": work_item_id,
+        "fabro_run_id": fabro_run_id,
+        "node": failure.node,
+        "checkpoint_error": failure.checkpoint_error,
+        "attribution": failure.attribution,
+        "failed_targets": list(failure.failed_targets),
+        "failed_hook_commands": list(failure.failed_hook_commands),
+        "observation_excerpt": failure.observation_excerpt,
+        "configured_budget_seconds": failure.configured_budget_seconds,
+        "configured_budget_unavailable": failure.configured_budget_unavailable,
+        "timed_out_operation": failure.timed_out_operation,
+        "engine_reported_elapsed": failure.engine_reported_elapsed,
+        "events_read": failure.events_read,
+        "terminal_patch_state": failure.terminal_patch_state,
+        "terminal_patch_bytes": failure.terminal_patch_bytes,
+        "terminal_patch_sha256": failure.terminal_patch_sha256,
+    }
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_outcome.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_outcome.py
new file mode 100644
index 00000000..9c2bfcff
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_outcome.py
@@ -0,0 +1,182 @@
+"""Recognizing a run that ended on a failed ENGINE checkpoint, and reporting it.
+
+A Fabro run ENDS ON A FAILED ENGINE CHECKPOINT when its terminal failure is the
+engine's own checkpoint of a node: the `git add` and `git commit` it performs on
+the run branch after a node finishes, outside every workflow node. The fault is
+an engine error rather than a node outcome, so the workflow graph cannot route it
+and the `needs_human` terminal never fires — which is why the dispatch outcome
+for twenty-seven measured hp runs carried only `git commit failed (exit 1)` and
+named neither the node nor one failed target.
+
+THE RECOGNITION SURFACE IS THE RUN'S EVENT STREAM, read from the DISPATCH'S OWN
+resolved factory, and the engine's terminal failure MESSAGE only when that stream
+cannot be read. The order is the clause's and it is not a preference: the event
+carries the node, the error AND the output tail, while the message carries the
+first two and nothing else — so a message-first reading would discard every
+target the whole attribution exists to name, on runs whose events were perfectly
+readable.
+
+THE DISPOSITION IS `blocked` AT `fabro-run`, WHICH IS EXIT CODE 4. The decision
+this failure leaves — retry, re-implement from the preserved work, or abandon —
+is one only the ledger's valves express, and nothing outside the factory clears
+it on its own. So the item rests at `blocked` with `needs-human` through the same
+transition a needs-human terminal produces, and the claim is never released to
+`ready`: a run left `active` with no reason is what twenty-seven measured hp
+dispatches did, and four of them were re-dispatched unchanged.
+
+THE ARM RUNS AFTER EVERY CLASSIFICATION THAT ALREADY OWNS A RUN. The clause says
+recognition "MUST NOT pre-empt an outcome that the Dispatcher already classifies
+otherwise": a run parked at a human gate and a run carrying the needs-human
+terminal's sentinel are routed before this arm is reached at all, and a run
+classified as provider-limit is declined here, because a vendor ceiling is a fact
+about the credential rather than about a checkpoint and its remedy is the
+dispatcher-owned hold.
+
+THE CONFIGURED BUDGET IS READ FROM THE RUN CONFIGURATION THIS DISPATCH SUBMITTED,
+which is `plan.workflow_toml` — the MATERIALIZED path, not the committed file —
+and it reaches the record only on a budget expiry. An unreadable configuration
+yields the REASON rather than the engine's stock budget, because substituting the
+stock figure would grade the failure against less time than the configuration
+asks for and nothing in the result would say so.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import TYPE_CHECKING
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_attribution import (
+    checkpoint_failure_from_event,
+    checkpoint_failure_from_message,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_comment import (
+    record_checkpoint_failure_comment,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_detail import (
+    checkpoint_failure_detail,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_events import (
+    read_checkpoint_events,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_journal import (
+    checkpoint_failure_record,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    CHECKPOINT_FAILURE_ENDING,
+    EVENTS_READ,
+    CheckpointFailure,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_credential_allowance import (
+    commit_timeout_seconds,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_checkpoint_message import (
+    checkpoint_message,
+)
+from livespec_orchestrator_beads_fabro.effects import AttemptFailure, attempt
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+    from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+
+__all__: list[str] = [
+    "checkpoint_failure_outcome",
+]
+
+
+def checkpoint_failure_outcome(
+    *,
+    plan: DispatchPlan,
+    run_id: str | None,
+    probe: CheckpointProbe | None,
+    terminal: DispatchOutcome,
+) -> DispatchOutcome | None:
+    """Report a run that ended on a failed engine checkpoint, or `None`.
+
+    `terminal` is the generic `failed` outcome the routing has already built, and
+    a recognized checkpoint failure REPLACES it rather than being assembled
+    beside it: every structured failure field the engine reported — the cause,
+    the category, the signature, the provider verdict — is already on it, and
+    rebuilding the outcome here is how one of them comes to be dropped.
+
+    EXACTLY ONE journal row per recognized dispatch, written here because this is
+    the one routing position that owns the generic `failed` ending and because the
+    attribution is computed here: a later surface writing it would have to
+    re-derive the attribution from the rendered prose.
+    """
+    if terminal.provider_usage_limit or probe is None or run_id is None:
+        return None
+    failure = _attributed(plan=plan, run_id=run_id, probe=probe, terminal=terminal)
+    if failure is None:
+        return None
+    probe.journal.append(
+        record=checkpoint_failure_record(
+            work_item_id=terminal.work_item_id, fabro_run_id=run_id, failure=failure
+        )
+    )
+    # BEFORE the outcome is returned, and therefore before the item's blocked
+    # transition, which the clause requires: a record explaining a block that a
+    # later failed lifecycle write never applied is worse than no record.
+    record_checkpoint_failure_comment(
+        repo=plan.repo,
+        work_item_id=terminal.work_item_id,
+        run_id=run_id,
+        factory=plan.fabro_factory_name,
+        failure=failure,
+        journal=probe.journal,
+    )
+    return replace(
+        terminal,
+        status="blocked",
+        detail=checkpoint_failure_detail(
+            work_item_id=terminal.work_item_id, run_id=run_id, failure=failure
+        ),
+        needs_human_kind=CHECKPOINT_FAILURE_ENDING,
+    )
+
+
+def _attributed(
+    *,
+    plan: DispatchPlan,
+    run_id: str,
+    probe: CheckpointProbe,
+    terminal: DispatchOutcome,
+) -> CheckpointFailure | None:
+    """This run's checkpoint failure, from the events or from the message."""
+    reading = read_checkpoint_events(plan=plan, run_id=run_id, runner=probe.runner)
+    if reading.unread_reason is None:
+        if reading.event is None:
+            return None
+        return checkpoint_failure_from_event(
+            event=reading.event,
+            events_read=EVENTS_READ,
+            patch=reading.patch,
+            patch_observed=True,
+            configured_budget=_configured_budget(plan=plan),
+        )
+    message = checkpoint_message(text=f"{terminal.fabro_failure_cause or ''}\n{terminal.detail}")
+    if message is None:
+        return None
+    return checkpoint_failure_from_message(
+        message=message,
+        events_read=reading.unread_reason,
+        configured_budget=_configured_budget(plan=plan),
+    )
+
+
+def _configured_budget(*, plan: DispatchPlan) -> int | str:
+    """The submitted run configuration's checkpoint commit budget, or the reason."""
+    read = attempt(
+        action=lambda: plan.workflow_toml.read_text(encoding="utf-8"),
+        exceptions=(OSError, UnicodeDecodeError),
+    )
+    if isinstance(read, AttemptFailure):
+        return (
+            f"the submitted run configuration at {plan.workflow_toml} could not be "
+            f"read ({type(read.error).__name__}), so the checkpoint commit budget it "
+            "declares is unknown; the engine's stock budget is deliberately NOT used "
+            "in its place"
+        )
+    return commit_timeout_seconds(committed_text=read)
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_probe.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_probe.py
new file mode 100644
index 00000000..b33debbd
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_checkpoint_probe.py
@@ -0,0 +1,42 @@
+"""The IO seams the engine-checkpoint attribution needs, carried as one value.
+
+A failed engine checkpoint is recognized from the run's EVENT STREAM, read from
+the dispatch's resolved factory, and the attribution it earns is journaled. So
+the arm needs a command runner and a journal writer, and it needs them in a
+module that `_dispatcher_fabro_terminal`'s routing can name without importing the
+engine it is itself imported by.
+
+THE PAIR TRAVELS AS ONE OPTIONAL VALUE rather than as two parameters, because the
+arm's whole behaviour turns on whether it has them BOTH: with no runner it cannot
+read the events the recognition requires, and with no journal it could recognize
+a checkpoint failure and leave no record of it. One optional value makes "this
+caller wired the probe" a single question with a single answer, and the absent
+case fail-closed in one place rather than once per seam.
+
+A CALLER THAT WIRES NO PROBE KEEPS ITS PRIOR OUTCOME. The hermetic callers of
+`fabro_run_terminal_outcome` that predate this arm supply none, so they read no
+events, write no record and get exactly the outcome they got before. That is the
+honest direction for an absent measurement: nothing is claimed about a
+checkpoint, rather than a checkpoint failure asserted from a stream nobody read.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
