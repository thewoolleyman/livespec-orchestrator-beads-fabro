index 00000000..c271f1a5
--- /dev/null
+++ b/tests/livespec_orchestrator_beads_fabro/commands/test_dispatcher_checkpoint_failure_arms.py
@@ -0,0 +1,382 @@
+"""The four attribution arms, the row's whole key set, and the terminal patch.
+
+Scenario 170's remaining scenarios, each asserted on the ONE record every surface
+renders from.
+
+THE OBSERVATION ARM ASSERTS NOTHING. A tail carrying neither a `Failed targets`
+summary nor a recognized hook-runner summary is an observation, and the clause
+says the Dispatcher "MUST NOT assert that any hook, target or recipe in that
+excerpt caused the failure" — so the fixture tail NAMES a recipe and the case
+asserts that the detail labels the excerpt rather than blaming it.
+
+THE TWO BUDGET FIGURES MUST STAY APART. One is the `[run.checkpoint]
+commit_timeout` the Dispatcher submitted and the other is what the engine says it
+spent; the case asserts the configured figure in seconds AND that the engine's
+figure is labelled as the engine's measurement, because a reader told that
+900004ms is "the budget" goes hunting for a configuration key holding it.
+
+THE EXCERPT'S OWN LINES MAY NOT REACH THE COMMENT. A budget expiry and an
+observation both carry engine-authored text on the detail; the ledger comment
+carries names and figures only, so its case asserts the absence of the excerpt.
+
+RECIPE OUTPUT OUTSIDE THE SUMMARY AND A CARRIAGE-RETURN TAIL are asserted here
+too, on the live record rather than on the recognizer alone: the recognizer's own
+module proves the parse, and these prove that what the parse produced is what the
+OUTCOME says.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_comment import (
+    checkpoint_failure_comment_body,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_outcome import (
+    checkpoint_failure_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    ATTRIBUTION_BUDGET_EXPIRY,
+    ATTRIBUTION_ENGINE_ERROR,
+    ATTRIBUTION_FAILED_TARGETS,
+    ATTRIBUTION_OBSERVATION,
+    EVENTS_READ,
+    TERMINAL_PATCH_ABSENT,
+    TERMINAL_PATCH_RECORDED,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroCommand
+
+_ITEM = "bd-ib-ckpt03"
+_RUN_ID = "01M4T131B9YQQQ34PS8VQDVBE2"
+_SERVER_URL = "https://hp-xubuntu.perch-rudd.ts.net:32276"
+_PATCH = "diff --git a/x.py b/x.py\n+print(1)\n"
+
+# The run configuration this dispatch submits, in the measured form: the
+# fork-only `[run.checkpoint] commit_timeout` key this repository declares.
+_RUN_CONFIG = '[run.checkpoint]\ncommit_timeout = "15m"\n'
+
+# A tail with no recognized summary of either kind. It NAMES a recipe, which is
+# what makes "labelled as an observation" a different assertion from "mentions a
+# recipe".
+_UNRECOGNIZED_TAIL = (
+    "\r\n::: just check-heading-coverage\r\n"
+    "Traceback (most recent call last):\r\n"
+    '  File "heading_coverage.py", line 1, in <module>\r\n'
+    "RuntimeError: the register could not be parsed\r\n"
+)
+
+
+@dataclass(frozen=True, kw_only=True)
+class _Command:
+    exit_code: int
+    stdout: str
+    stderr: str
+
+
+@dataclass(kw_only=True)
+class _Runner:
+    stdout: str
+
+    def run(
+        self,
+        *,
+        argv: list[str],
+        cwd: Path,
+        timeout_seconds: float,
+        env: dict[str, str] | None = None,
+        stdin: int | None = None,
+    ) -> FabroCommand:
+        _ = (argv, cwd, timeout_seconds, env, stdin)
+        return _Command(exit_code=0, stdout=self.stdout, stderr="")
+
+
+@dataclass(kw_only=True)
+class _Journal:
+    records: list[dict[str, object]] = field(default_factory=list)
+
+    def append(self, *, record: dict[str, object]) -> None:
+        self.records.append(record)
+
+
+def _events(
+    *,
+    error: str,
+    tail: str | None = None,
+    patch: str | None = None,
+    node: str = "implement",
+) -> str:
+    properties: dict[str, Any] = {"node": node, "error": error}
+    if tail is not None:
+        properties["output"] = tail
+    stream: list[dict[str, Any]] = [{"type": "checkpoint.failed", "properties": properties}]
+    failed: dict[str, Any] = {"type": "run.failed", "properties": {"reason": "workflow_error"}}
+    if patch is not None:
+        failed["properties"]["terminal_patch"] = patch
+    stream.append(failed)
+    return json.dumps(stream)
+
+
+def _plan(*, tmp_path: Path, config: str | None = _RUN_CONFIG) -> DispatchPlan:
+    workflow = tmp_path / "workflow.toml"
+    if config is not None:
+        _ = workflow.write_text(config, encoding="utf-8")
+    return DispatchPlan(
+        repo=tmp_path,
+        work_item_id=_ITEM,
+        branch=f"feat/{_ITEM}",
+        workflow_toml=workflow,
+        goal_file=tmp_path / "goal.txt",
+        fabro_bin="fabro",
+        fabro_factory_name="hp",
+        fabro_factory_server=_SERVER_URL,
+        fabro_factory_dev_token=None,
+        janitor=("check",),
+        janitor_checkout=tmp_path / ".janitor",
+        janitor_core_checkout=tmp_path / ".janitor" / ".core",
+        janitor_core_repo_url="https://github.com/thewoolleyman/livespec.git",
+        janitor_core_ref="trunk",
+        review_fix_visit_cap=3,
+        merge_on_review_cap_outcome="succeeded",
+    )
+
+
+def _terminal(*, detail: str) -> DispatchOutcome:
+    return DispatchOutcome(
+        work_item_id=_ITEM,
+        status="failed",
+        stage="fabro-run",
+        pr_number=None,
+        merge_sha=None,
+        detail=detail,
+        fabro_run_id=_RUN_ID,
+        fabro_failure_cause=detail,
+        fabro_failure_category="deterministic",
+    )
+
+
+def _drive(
+    *,
+    tmp_path: Path,
+    events: str,
+    detail: str = "git checkpoint commit failed for node 'implement': git commit failed (exit 1)",
+    config: str | None = _RUN_CONFIG,
+) -> tuple[DispatchOutcome, dict[str, object]]:
+    journal = _Journal()
+    outcome = checkpoint_failure_outcome(
+        plan=_plan(tmp_path=tmp_path, config=config),
+        run_id=_RUN_ID,
+        probe=CheckpointProbe(runner=_Runner(stdout=events), journal=journal),
+        terminal=_terminal(detail=detail),
+    )
+    assert outcome is not None
+    rows = [row for row in journal.records if row.get("stage") == "checkpoint-failure"]
+    assert len(rows) == 1
+    return (outcome, rows[0])
+
+
+def test_a_tail_with_no_recognized_summary_is_labelled_an_observation(
+    tmp_path: Path,
+) -> None:
+    """The excerpt is reported as an observation, and nothing in it is blamed."""
+    outcome, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(error="git commit failed (exit 1)", tail=_UNRECOGNIZED_TAIL),
+    )
+
+    assert row["attribution"] == ATTRIBUTION_OBSERVATION
+    assert "the register could not be parsed" in str(row["observation_excerpt"])
+    assert row["failed_targets"] == []
+    assert row["failed_hook_commands"] == []
+    assert "OBSERVATION" in outcome.detail
+    assert "NOT a claim" in outcome.detail
+    assert "failed targets" not in outcome.detail
+
+
+def test_a_budget_expiry_names_the_operation_the_budget_and_the_engines_figure(
+    tmp_path: Path,
+) -> None:
+    """The configured budget and the engine's measurement are kept apart."""
+    outcome, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(error="git commit timed out after 900004ms", node="fix"),
+        detail=(
+            'Checkpoint error: checkpoint operation budget exceeded on node "fix": '
+            "git commit timed out after 900004ms"
+        ),
+    )
+
+    assert row["attribution"] == ATTRIBUTION_BUDGET_EXPIRY
+    assert row["node"] == "fix"
+    assert row["timed_out_operation"] == "git commit"
+    assert row["configured_budget_seconds"] == 900
+    assert row["engine_reported_elapsed"] == "900004ms"
+    assert "900s" in outcome.detail
+    assert "the engine's figure, NOT the configured budget" in outcome.detail
+
+
+def test_an_unreadable_run_configuration_names_the_reason_rather_than_the_stock_budget(
+    tmp_path: Path,
+) -> None:
+    """A figure this derivation could not establish is not a bound, however plausible."""
+    _, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(error="git commit timed out after 900004ms"),
+        config=None,
+    )
+
+    assert row["configured_budget_seconds"] is None
+    assert "could not be read" in str(row["configured_budget_unavailable"])
+
+
+def test_a_git_add_failure_with_no_output_tail_is_the_engine_error_alone(
+    tmp_path: Path,
+) -> None:
+    """No tail means no summary to recognize and nothing to observe."""
+    outcome, row = _drive(
+        tmp_path=tmp_path, events=_events(error="git add failed", node="dod_gate")
+    )
+
+    assert row["attribution"] == ATTRIBUTION_ENGINE_ERROR
+    assert row["node"] == "dod_gate"
+    assert row["checkpoint_error"] == "git add failed"
+    assert row["failed_targets"] == []
+    assert row["failed_hook_commands"] == []
+    assert row["observation_excerpt"] is None
+    assert "no output tail" in outcome.detail
+
+
+def test_the_row_carries_every_key_the_clause_names(tmp_path: Path) -> None:
+    """One row per dispatch, and a reader never meets an omitted key."""
+    _, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(
+            error="git commit failed (exit 1)",
+            tail="Failed targets (1):\r\n  - check-lint\r\n",
+            patch=_PATCH,
+        ),
+    )
+
+    assert set(row) == {
+        "stage",
+        "work_item_id",
+        "fabro_run_id",
+        "node",
+        "checkpoint_error",
+        "attribution",
+        "failed_targets",
+        "failed_hook_commands",
+        "observation_excerpt",
+        "configured_budget_seconds",
+        "configured_budget_unavailable",
+        "timed_out_operation",
+        "engine_reported_elapsed",
+        "events_read",
+        "terminal_patch_state",
+        "terminal_patch_bytes",
+        "terminal_patch_sha256",
+    }
+    assert row["work_item_id"] == _ITEM
+    assert row["fabro_run_id"] == _RUN_ID
+    assert row["events_read"] == EVENTS_READ
+    assert row["attribution"] == ATTRIBUTION_FAILED_TARGETS
+
+
+def test_a_terminal_patch_is_recorded_by_byte_size_and_digest(tmp_path: Path) -> None:
+    """A pointer naming no stage artifact must not read as a run that held no work."""
+    raw = _PATCH.encode("utf-8")
+    outcome, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(
+            error="git commit failed (exit 1)",
+            tail="Failed targets (1):\r\n  - check-lint\r\n",
+            patch=_PATCH,
+        ),
+    )
+
+    assert row["terminal_patch_state"] == TERMINAL_PATCH_RECORDED
+    assert row["terminal_patch_bytes"] == len(raw)
+    assert row["terminal_patch_sha256"] == hashlib.sha256(raw).hexdigest()
+    assert str(len(raw)) in outcome.detail
+    body = checkpoint_failure_comment_body(
+        work_item_id=_ITEM, run_id=_RUN_ID, factory="hp", failure=_failure_of(row=row)
+    )
+    assert hashlib.sha256(raw).hexdigest() in body
+
+
+def test_a_terminal_event_carrying_no_patch_says_so_rather_than_nothing(
+    tmp_path: Path,
+) -> None:
+    """Read-and-empty is a different fact from never-read, and says which."""
+    _, row = _drive(
+        tmp_path=tmp_path,
+        events=_events(
+            error="git commit failed (exit 1)", tail="Failed targets (1):\r\n  - check-lint\r\n"
+        ),
+    )
+
+    assert row["terminal_patch_state"] == TERMINAL_PATCH_ABSENT
+    assert row["terminal_patch_bytes"] is None
+
+
+def test_a_carriage_return_tail_names_what_a_line_feed_tail_names(tmp_path: Path) -> None:
+    """The two framings reach the same attribution through the live record."""
+    crlf = "Failed targets (2):\r\n  - check-lint\r\n  - check-types\r\n"
+    feed = "Failed targets (2):\n  - check-lint\n  - check-types\n"
+
+    _, crlf_row = _drive(
+        tmp_path=tmp_path, events=_events(error="git commit failed (exit 1)", tail=crlf)
+    )
+    _, feed_row = _drive(
+        tmp_path=tmp_path, events=_events(error="git commit failed (exit 1)", tail=feed)
+    )
+
