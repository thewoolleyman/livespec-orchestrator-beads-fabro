+def test_a_factory_declaring_no_server_is_not_surveyed_through_a_local_default(
+    tmp_path: Path,
+) -> None:
+    """A bare client answers for loopback: a clean, plausible, wrong answer.
+
+    The arm still RESTS the item, from the engine's own terminal message, and
+    records why the events went unread — which is Scenario 170's unreadable-events
+    scenario reached through the one failure mode that spends no round trip.
+    """
+    runner = _Runner(stdout=json.dumps(_FAILED_EVENT))
+    journal = _Journal()
+
+    outcome = checkpoint_failure_outcome(
+        plan=_plan(tmp_path=tmp_path, server=None),
