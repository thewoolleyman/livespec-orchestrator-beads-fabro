+    )
+
+
+def test_a_name_that_is_not_identifier_shaped_is_left_out_and_counted() -> None:
+    """Arbitrary captured text may not reach the record as a target name."""
+    body = _body(failure=_failure(targets=("check-lint", "error: could not read 24 files")))
+
+    assert "check-lint" in body
+    assert "could not read" not in body
+    assert "names left out as not identifier-shaped: 1" in body
+
+
+def test_an_unreported_node_and_an_unparsed_run_are_said_rather_than_left_blank() -> None:
+    """An absence a rendering surface would absorb is stated instead."""
+    body = _body(failure=_failure(node=None), run_id=None)
+
+    assert NODE_NOT_REPORTED in body
+    assert "not parsed from the launch output" in body
+
+
+def test_a_credential_shaped_checkpoint_error_is_replaced_wholesale(
+    tmp_path: Path,
+) -> None:
+    """A tokenized origin URL must not land on an append-only record."""
+    tokenized = (
+        "git commit failed (exit 1): remote https://x-access-token:"
+        "ghs_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA@github.com/thewoolleyman/x.git"
+    )
+    body = _body(failure=_failure(checkpoint_error=tokenized))
+
+    assert "ghs_" not in body
+    assert REDACTION_MARKER in body
+    _ = tmp_path
+
+
+def test_a_body_carrying_a_template_opener_is_journaled_and_not_written(
+    tmp_path: Path,
+) -> None:
+    """One opener on this item's timeline refuses every later dispatch of it."""
+    journal = _Journal()
+    poisoned_factory = f"hp{_OPENER} factory.name }}}}"
+
+    assert minijinja_openers_in_text(
+        source="probe",
+        text=checkpoint_failure_comment_body(
+            work_item_id=_ITEM, run_id=_RUN_ID, factory=poisoned_factory, failure=_failure()
+        ),
+    )
+    record_checkpoint_failure_comment(
+        repo=tmp_path,
+        work_item_id=_ITEM,
+        run_id=_RUN_ID,
+        factory=poisoned_factory,
+        failure=_failure(),
+        journal=journal,
+    )
+
+    rows = [
+        row for row in journal.records if row.get("stage") == "checkpoint-failure-comment-error"
+    ]
+    assert len(rows) == 1
+    assert "template-opener-present" in str(rows[0]["reason"])
+
+
+def test_the_needs_human_causal_record_writes_nothing_for_a_checkpoint_ending(
+    tmp_path: Path,
+) -> None:
+    """One ending, one record: the checkpoint comment is this ending's account."""
+    journal = _Journal()
+
+    record_needs_human_cause(
+        repo=tmp_path,
+        item=_stub_item(),
+        outcome=_blocked_checkpoint_outcome(),
+        journal=journal,
+    )
+
+    assert journal.records == []
+
+
+def test_a_run_carrying_the_needs_human_sentinel_is_not_re_read_as_a_checkpoint(
+    tmp_path: Path,
+) -> None:
+    """An already-classified ending keeps its route and writes no checkpoint row."""
+    journal = _Journal()
+    events: list[dict[str, Any]] = [
+        {
+            "type": "checkpoint.failed",
+            "properties": {"node": "implement", "error": "git commit failed (exit 1)"},
+        }
+    ]
+    terminated = replace(
+        _blocked_checkpoint_outcome(),
+        needs_human_kind="stage-failure",
+        detail=f"{NEEDS_HUMAN_MARKER}: the acceptance criteria name a scenario heading",
+    )
+
+    outcome = checkpoint_failure_outcome(
+        plan=_plan(tmp_path=tmp_path),
+        run_id=_RUN_ID,
+        probe=CheckpointProbe(runner=_Runner(stdout=json.dumps(events)), journal=journal),
+        terminal=replace(terminated, provider_usage_limit=True),
+    )
+
+    assert outcome is None
+    assert journal.records == []
+
+
+def test_the_terminal_router_routes_the_sentinel_before_the_checkpoint_arm(
+    tmp_path: Path,
+) -> None:
+    """The positive control for the pre-emption: the sentinel's own outcome stands."""
+    journal = _Journal()
+    events: list[dict[str, Any]] = [
+        {
+            "type": "checkpoint.failed",
+            "properties": {"node": "implement", "error": "git commit failed (exit 1)"},
+        }
+    ]
+    marker = f"{NEEDS_HUMAN_MARKER}: the acceptance criteria name a scenario heading"
+    payload = [
+        {
+            "run_id": _RUN_ID,
+            "status": {"kind": "failed", "reason": "workflow_error"},
+            "conclusion": {
+                "status": "failed",
+                "failure": {
+                    "reason": "workflow_error",
+                    "detail": {"message": marker, "category": "deterministic"},
+                },
+            },
+        }
+    ]
+    from livespec_orchestrator_beads_fabro.commands._dispatcher_fabro_terminal import (
+        fabro_run_terminal_outcome,
+    )
+
+    outcome = fabro_run_terminal_outcome(
+        outcome_type=DispatchOutcome,
+        plan=_plan(tmp_path=tmp_path),
+        run_id=_RUN_ID,
+        inspect=_inspect(tmp_path=tmp_path, payload=payload),
+        exit_code=1,
