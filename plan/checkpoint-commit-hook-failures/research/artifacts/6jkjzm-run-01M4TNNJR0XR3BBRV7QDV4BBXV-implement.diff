+
+    outcome = checkpoint_failure_outcome(
+        plan=_plan(tmp_path=tmp_path),
+        run_id=_RUN_ID,
+        probe=CheckpointProbe(runner=_Runner(stdout="not json at all"), journal=journal),
+        terminal=_terminal(),
