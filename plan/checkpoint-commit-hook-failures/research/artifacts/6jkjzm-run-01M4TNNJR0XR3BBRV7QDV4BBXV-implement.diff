new file mode 100644
index 00000000..c065fcb9
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_checkpoint_event.py
@@ -0,0 +1,137 @@
+"""The `checkpoint.failed` event one run's stream carries, as the engine writes it.
+
+The engine's checkpoint of a node is the `git add` and `git commit` it performs on
+the run branch after that node finishes, outside every workflow node. When it
+fails the engine emits this event and the run ends: the fault is an engine error
+rather than a node outcome, so the graph has no edge to route it along. That is
+why the EVENT is the recognition surface — `contracts.md` section "Failed engine
+checkpoint commit attribution" admits the engine's terminal failure message only
+when this stream cannot be read.
+
+A LEAF, reading nothing but the already-normalized record mappings its caller
+hands it, for the reason `_fabro_port_checkpoints` gives for the same posture.
+
+EVERY FIELD IS READ THROUGH A CANDIDATE KEY LIST, and the lists are short and
+measured rather than hopeful. The streams this fleet reads come from two engine
+generations with different envelope shapes (`_fabro_port_events` records all
+three containers), so one key per field would make the reader correct for one
+generation and silently empty for the other — and an empty reading here is
+exactly the attribution-free outcome this whole clause exists to retire.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._fabro_port_events import (
+    event_name,
+    event_properties,
+)
+
+__all__: list[str] = [
+    "CHECKPOINT_FAILED_EVENT",
+    "RUN_FAILED_EVENT",
+    "CheckpointFailedEvent",
+    "TerminalPatch",
+    "checkpoint_failed_event",
+    "terminal_patch",
+]
+
+CHECKPOINT_FAILED_EVENT = "checkpoint.failed"
+RUN_FAILED_EVENT = "run.failed"
+
+# The node the checkpoint belonged to, and the engine's own error text for it.
+# `error` is the engine's field name for the checkpoint fault; `message` and
+# `reason` are the two further names the failure families in these streams have
+# been observed using for the same text.
+_NODE_KEYS: tuple[str, ...] = ("node", "node_id")
+_ERROR_KEYS: tuple[str, ...] = ("error", "message", "reason")
+
+# The captured hook output the engine records with the failure. It is a bounded
+# SUFFIX of that output — 8192 bytes on every one of the 27 failures measured on
+# hp since 2026-10-09 — which is why its consumers may not reconstruct a summary
+# whose header the bound cut away.
+_TAIL_KEYS: tuple[str, ...] = ("output", "output_tail", "stderr", "stderr_tail")
+
+# The uncommitted work the terminal `run.failed` event carries. A failed
+# checkpoint is exactly the case where that work reached no stage diff artifact,
+# so this is the only record that the run held any.
+_PATCH_KEYS: tuple[str, ...] = ("terminal_patch", "patch", "diff")
+
+
+@dataclass(frozen=True, kw_only=True)
+class TerminalPatch:
+    """The uncommitted work a terminal `run.failed` event carried, measured."""
+
+    byte_size: int
+    sha256: str
+
+
+@dataclass(frozen=True, kw_only=True)
+class CheckpointFailedEvent:
+    """One `checkpoint.failed` event, with each field absent rather than guessed."""
+
+    node: str | None
+    checkpoint_error: str | None
+    output_tail: str | None
+
+
+def checkpoint_failed_event(
+    *,
+    records: tuple[dict[str, Any], ...],
+) -> CheckpointFailedEvent | None:
+    """The run's terminal checkpoint failure, or `None` when it carried none.
+
+    THE LAST such event is the terminal one. A failed checkpoint is an engine
+    error that ends the run, so a healthy stream carries at most one; taking the
+    last rather than the first is what keeps the reading correct on a stream that
+    somehow carried an earlier one the run survived.
+    """
+    found = [record for record in records if event_name(record=record) == CHECKPOINT_FAILED_EVENT]
+    if not found:
+        return None
+    properties = event_properties(record=found[-1])
+    return CheckpointFailedEvent(
+        node=_text(properties=properties, keys=_NODE_KEYS),
+        checkpoint_error=_text(properties=properties, keys=_ERROR_KEYS),
+        output_tail=_text(properties=properties, keys=_TAIL_KEYS),
+    )
+
+
+def _text(*, properties: dict[str, Any], keys: tuple[str, ...]) -> str | None:
+    """The first non-empty string one of `keys` holds, or `None`.
+
+    An EMPTY string is treated as absent rather than as a value, because a field
+    the engine renders empty says nothing and an empty tail reported as present
+    would route a `git add` failure that carries no output into the observation
+    arm with nothing to observe.
+    """
+    for key in keys:
+        value: object = properties.get(key)
+        if isinstance(value, str) and value != "":
+            return value
+    return None
+
+
+def terminal_patch(*, records: tuple[dict[str, Any], ...]) -> TerminalPatch | None:
+    """The terminal patch the run's `run.failed` event carried, or `None`.
+
+    `None` means the event WAS read and carried no patch, which is a different
+    fact from a stream nobody could read — the caller keeps those apart, because
+    a run whose work was never observed must not be reported as a run that
+    produced none.
+
+    The digest is taken over the patch's UTF-8 BYTES and the size is that byte
+    count, so the two figures describe the same thing a `sha256sum` of a
+    recovered file would.
+    """
+    found = [record for record in records if event_name(record=record) == RUN_FAILED_EVENT]
+    if not found:
+        return None
+    patch = _text(properties=event_properties(record=found[-1]), keys=_PATCH_KEYS)
+    if patch is None:
+        return None
+    raw = patch.encode("utf-8", "surrogatepass")
+    return TerminalPatch(byte_size=len(raw), sha256=hashlib.sha256(raw).hexdigest())
