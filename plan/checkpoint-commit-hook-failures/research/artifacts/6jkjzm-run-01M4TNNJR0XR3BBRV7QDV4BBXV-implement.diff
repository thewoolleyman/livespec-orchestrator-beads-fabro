+"""A failed engine checkpoint rests its item at needs-human with a durable record.
+
+Scenario 170's first outline, its closing clauses: the dispatch outcome is
+`blocked` at stage `fabro-run`, the dispatch reports exit code 4, the item rests
+at `blocked` with `blocked_reason` `needs-human`, and the item carries a
+`livespec-checkpoint-failure` comment naming the same node, hook command and
+targets the outcome named.
+
+THE COMMENT IS READ BACK OFF THE ITEM rather than asserted as a return value.
+`bd show --json` carries no comments at all and a comment body lives under the
+beads-native `text` key, so the write this clause asks for is only durable if a
+read through the store seam finds it — a record that rendered perfectly and did
+not land is the failure mode, and it is invisible to any assertion on the render.
+
+THE EXCERPT PROHIBITION IS ASSERTED AS AN ABSENCE OF THE TAIL'S OWN LINES. The
+clause says the comment carries "names and figures only, and never an excerpt of
+captured output", so the fixture tail carries a distinctive line that appears
+nowhere in any name — a recognizer that pasted the tail in would be caught, while
+asserting only that the names ARE present could not tell the two apart.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro._store_comments import read_work_item_comments
+from livespec_orchestrator_beads_fabro.commands._dispatcher_blocked import (
+    escalate_needs_human_block,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_comment import (
+    CHECKPOINT_FAILURE_COMMENT_MARKER,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_outcome import (
+    checkpoint_failure_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_command_common import (
+    EXIT_BLOCKED,
+    dispatch_exit_code,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroCommand
+from livespec_orchestrator_beads_fabro.store import append_work_item, read_work_items
+from livespec_orchestrator_beads_fabro.types import StoreConfig, WorkItem
+
+_ITEM = "bd-ib-ckpt01"
+_RUN_ID = "01M4RGVVFBVM0Y11CHG9DV0QS2"
+_FACTORY = "hp"
+_NODE = "implement"
+_CHECKPOINT_ERROR = "git commit failed (exit 1)"
+_FAILURE_MESSAGE = f"git checkpoint commit failed for node '{_NODE}': {_CHECKPOINT_ERROR}"
+_FAILED_TARGET = "check-per-file-coverage"
+_FAILED_HOOK = "03-check-pre-commit"
+_SERVER_URL = "https://hp-xubuntu.perch-rudd.ts.net:32276"
+
+# A line of captured output that is not part of any name. It is what tells an
+# excerpt-free record apart from one that pasted the tail in beside the names.
+_OUTPUT_LINE = "coverage: 2 lines of _dispatcher_engine.py are not covered"
+
+_TAIL = (
+    f"\r\n::: just {_FAILED_TARGET}\r\n"
+    f"{_OUTPUT_LINE}\r\n"
+    "\r\n"
+    "Failed targets (1):\r\n"
+    f"  - {_FAILED_TARGET}\r\n"
+    "\r\n"
+    "summary: (done in 407.57 seconds)\r\n"
+    f"\U0001f94a {_FAILED_HOOK} (407.57 seconds)\r\n"
+)
+
+_EVENTS: list[dict[str, Any]] = [
+    {
+        "type": "checkpoint.failed",
+        "properties": {"node": _NODE, "error": _CHECKPOINT_ERROR, "output": _TAIL},
+    }
+]
