+"""What the durable checkpoint record refuses to write, and what it never claims.
+
+Three claims the clause makes that a happy-path record cannot exercise, plus the
+pre-emption rule the arm is bound by.
+
+A NAME THAT IS NOT IDENTIFIER-SHAPED IS LEFT OUT AND COUNTED. The shape test is
+the engine's own run-label rule, and a name failing it did not come from a
+summary in any form this fleet recognizes — so writing it would put arbitrary
+captured text onto an append-only record under the heading of a target name.
+Asserting the COUNT beside the omission is what tells a filtered record apart
+from one that silently reported a shorter attribution as complete.
+
+A TEMPLATE OPENER IS REFUSED BEFORE THE WRITE, NOT AFTER. A MiniJinja opener
+anywhere in a ledger comment makes every later dispatch of that item refuse at
+the goal preflight, permanently, because `bd comments` offers add and list with
+no edit and no delete. The opener in the fixture reaches the body through the
+CONFIGURED FACTORY NAME rather than through the engine's checkpoint error, and
+that is the whole point of the case: the error is already neutralized on its way
+in, so the detector's own arm is only reachable through a field that is not —
+which is exactly why the clause asks for the detector as a separate gate rather
+than trusting the neutralizer.
+
+A CREDENTIAL-SHAPED VALUE IS REPLACED WHOLESALE. A checkpoint error can quote a
+push against a tokenized origin URL; the fleet's policy for that shape is a
+whole-value replacement rather than a partial mask.
+
+AND THE needs_human TERMINAL'S OWN SENTINEL KEEPS ITS ROUTE. Scenario 170's last
+scenario: a run carrying it is already classified, so the checkpoint arm must not
+re-read it — and the needs-human causal record, which owns that ending, must not
+write a second account of a checkpoint ending it cannot describe.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field, replace
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_comment import (
+    CHECKPOINT_FAILURE_COMMENT_MARKER,
+    checkpoint_failure_comment_body,
+    record_checkpoint_failure_comment,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_outcome import (
+    checkpoint_failure_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_record import (
+    ATTRIBUTION_FAILED_TARGETS,
+    CHECKPOINT_FAILURE_ENDING,
+    EVENTS_READ,
+    NODE_NOT_REPORTED,
+    CheckpointFailure,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+from livespec_orchestrator_beads_fabro.commands._dispatcher_goal import (
+    minijinja_openers_in_text,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_needs_human_cause import (
+    record_needs_human_cause,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import (
+    NEEDS_HUMAN_MARKER,
+    DispatchPlan,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_port import (
+    FabroInspectResult,
+    FabroPort,
+    FabroTarget,
+)
+from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroCommand
+from livespec_orchestrator_beads_fabro.commands._otel_scrub import REDACTION_MARKER
+
+_ITEM = "bd-ib-ckpt02"
+_RUN_ID = "01M4T28A9B79A7B971N9A5J3NW"
+_SERVER_URL = "https://hp-xubuntu.perch-rudd.ts.net:32276"
+
+# The literal open-interpolation pair, assembled rather than written, so this
+# module's own source carries no opener for a scanner to find.
+_OPENER = "{" + "{"
+
+
+@dataclass(frozen=True, kw_only=True)
+class _Command:
+    exit_code: int
+    stdout: str
+    stderr: str
+
+
+@dataclass(kw_only=True)
+class _Runner:
+    stdout: str
+
+    def run(
+        self,
+        *,
+        argv: list[str],
+        cwd: Path,
+        timeout_seconds: float,
+        env: dict[str, str] | None = None,
+        stdin: int | None = None,
+    ) -> FabroCommand:
+        _ = (argv, cwd, timeout_seconds, env, stdin)
+        return _Command(exit_code=0, stdout=self.stdout, stderr="")
+
+
+@dataclass(kw_only=True)
+class _Journal:
+    records: list[dict[str, object]] = field(default_factory=list)
+
+    def append(self, *, record: dict[str, object]) -> None:
+        self.records.append(record)
+
+
+def _failure(
+    *,
+    checkpoint_error: str = "git commit failed (exit 1)",
+    node: str | None = "implement",
+    targets: tuple[str, ...] = ("check-lint",),
+) -> CheckpointFailure:
+    return CheckpointFailure(
+        node=node,
+        checkpoint_error=checkpoint_error,
+        attribution=ATTRIBUTION_FAILED_TARGETS,
+        failed_targets=targets,
+        failed_hook_commands=(),
