new file mode 100644
index 00000000..de25fcd7
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_fabro_checkpoint_message.py
@@ -0,0 +1,83 @@
+"""The engine's own terminal failure message for a checkpoint fault, as it reads.
+
+The SECOND recognition surface, and the narrower one. `contracts.md` section
+"Failed engine checkpoint commit attribution" admits it "Only when that stream
+cannot be read", because the event carries the node identifier and the output
+tail while this carries neither — so a reading taken here can name the node and
+the error and must then stop, rather than inferring a target nobody reported.
+
+TWO MEASURED WORDINGS, and the module reads both because the engine uses both.
+The commit refusal reads `git checkpoint commit failed for node 'publish_draft':
+git commit failed (exit 1)` (measured on hp run 01M4RN8BTXSJZRJNQQQ0HWFYC7); the
+budget expiry reads `Checkpoint error: checkpoint operation budget exceeded on
+node "slow_hook": git commit timed out after 5003ms` (measured on probe run
+01M1VNZNRX31A6FD7FY9STWD96). The node is quoted with single or double quotes
+depending on which, so the quote is optional in the pattern rather than assumed.
+
+THE FIGURES PARSE IS PUBLIC AND SEPARATE, because the same `timed out after
+<n>ms` text arrives on the EVENT's own error field too. Reading it in one place
+is what keeps a budget expiry recognized identically whichever surface supplied
+the error — two parsers of one sentence cannot be proven to agree, and each
+would return a well-formed figure.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+__all__: list[str] = [
+    "CheckpointMessage",
+    "checkpoint_error_figures",
+    "checkpoint_message",
+]
+
+# The two wordings, as one pattern: either names a node and then, after a colon,
+# the engine's own error for it.
+_MESSAGE_RE = re.compile(
+    r"""checkpoint\ (?:commit\ failed\ for|operation\ budget\ exceeded\ on)\ node\s+
+        ['"]?(?P<node>[^'"\s:]+)['"]?\s*:\s*(?P<error>[^\r\n]+)""",
+    re.VERBOSE,
+)
+
+# The operation that ran out of budget and the elapsed figure the engine reports
+# for it. The operation is named as the engine names it, which is why the pattern
+# captures the engine's own words rather than mapping them onto ours.
+_TIMED_OUT_RE = re.compile(r"(?P<operation>git [a-z][a-z-]*) timed out after (?P<elapsed>\d+ms)")
+
+_BUDGET_MARKER = "checkpoint operation budget exceeded"
+
+
+@dataclass(frozen=True, kw_only=True)
+class CheckpointMessage:
+    """One engine checkpoint fault as its terminal failure message reports it."""
+
+    node: str | None
+    checkpoint_error: str
+    budget_expiry: bool
+    timed_out_operation: str | None
+    engine_reported_elapsed: str | None
+
+
+def checkpoint_message(*, text: str) -> CheckpointMessage | None:
+    """The checkpoint fault `text` reports, or `None` when it reports none."""
+    match = _MESSAGE_RE.search(text)
+    if match is None:
+        return None
+    error = match.group("error").strip()
+    operation, elapsed = checkpoint_error_figures(checkpoint_error=error)
+    return CheckpointMessage(
+        node=match.group("node"),
+        checkpoint_error=error,
+        budget_expiry=_BUDGET_MARKER in text or elapsed is not None,
+        timed_out_operation=operation,
+        engine_reported_elapsed=elapsed,
+    )
+
+
+def checkpoint_error_figures(*, checkpoint_error: str) -> tuple[str | None, str | None]:
+    """The timed-out git operation and the engine's elapsed figure, or two Nones."""
+    match = _TIMED_OUT_RE.search(checkpoint_error)
+    if match is None:
+        return (None, None)
+    return (match.group("operation"), match.group("elapsed"))
