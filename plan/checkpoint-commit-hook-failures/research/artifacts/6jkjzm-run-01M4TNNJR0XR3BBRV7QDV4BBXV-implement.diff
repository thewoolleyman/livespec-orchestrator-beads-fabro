+"""A failed engine checkpoint commit names its run, its node, its error and its targets.
+
+`SPECIFICATION/contracts.md` section "Failed engine checkpoint commit
+attribution", and Scenario 170's first outline: the engine's own checkpoint of a
+node is the `git add` and `git commit` it performs on the run branch after a node
+finishes, outside every workflow node. When that commit is refused by the
+repository's commit hooks the failure is an ENGINE error rather than a node
+outcome, so the workflow graph cannot route it and the `needs_human` terminal
+never fires — which is why the dispatch outcome carried only `git commit failed
+(exit 1)` and named neither the node nor one failed target.
+
+The tail fixture is the measured shape rather than an invented one. Measured
+2026-10-12 across all 27 checkpoint-commit failures on hp since 2026-10-09
+(`plan/checkpoint-commit-hook-failures/research/001-measured-checkpoint-failures-2026-10-12.md`):
+each run's `checkpoint.failed` event held an 8192-byte stderr tail ending in the
+aggregate runner's structured `Failed targets` list, and reading that list is
+what separated per-file coverage from `check-master-ci-green` from the
+Red-Green-Replay gate. The lines end in carriage-return line-feed pairs because
+the measured tails do.
+
+RECIPE OUTPUT OUTSIDE THE SUMMARY IS IN THE FIXTURE ON PURPOSE. The tail carries
+a PASSING recipe's banner and a failing recipe's own error line before the
+summary, so a reading that took the last recipe it saw would name
+`check-master-ci-green`'s neighbour instead of the summary's own member.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_outcome import (
+    checkpoint_failure_outcome,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_checkpoint_probe import (
+    CheckpointProbe,
+)
+from livespec_orchestrator_beads_fabro.commands._dispatcher_engine import DispatchOutcome
+from livespec_orchestrator_beads_fabro.commands._dispatcher_plan import DispatchPlan
+from livespec_orchestrator_beads_fabro.commands._fabro_port_types import FabroCommand
+
+_RUN_ID = "01M4RN8BTXSJZRJNQQQ0HWFYC7"
+_NODE = "implement"
+_CHECKPOINT_ERROR = "git commit failed (exit 1)"
+_FAILURE_MESSAGE = f"git checkpoint commit failed for node '{_NODE}': {_CHECKPOINT_ERROR}"
+_FAILED_TARGET = "check-master-ci-green"
+_PASSING_RECIPE = "check-lint"
+_SERVER_URL = "https://hp-xubuntu.perch-rudd.ts.net:32276"
+
+_TAIL = (
+    f"\r\n::: just {_PASSING_RECIPE}\r\n"
+    "All checks passed!\r\n"
+    f"\r\n::: just {_FAILED_TARGET}\r\n"
+    "ERROR: the default branch's aggregate job is red\r\n"
+    "\r\n"
+    "Failed targets (1):\r\n"
+    f"  - {_FAILED_TARGET}\r\n"
+)
+
+_EVENTS: list[dict[str, Any]] = [
+    {"type": "checkpoint.completed", "properties": {"node": "dod_gate"}},
+    {
+        "type": "checkpoint.failed",
+        "properties": {"node": _NODE, "error": _CHECKPOINT_ERROR, "output": _TAIL},
+    },
+    {"type": "run.failed", "properties": {"reason": "workflow_error"}},
+]
+
+
+@dataclass(frozen=True, kw_only=True)
+class _Command:
+    exit_code: int
+    stdout: str
+    stderr: str
+
+
+@dataclass(kw_only=True)
+class _EventsRunner:
+    """A runner that answers the port's `events` verb and nothing else."""
+
+    stdout: str
+    argv_seen: list[list[str]] = field(default_factory=list)
+
+    def run(
+        self,
+        *,
+        argv: list[str],
+        cwd: Path,
+        timeout_seconds: float,
+        env: dict[str, str] | None = None,
+        stdin: int | None = None,
+    ) -> FabroCommand:
+        _ = (cwd, timeout_seconds, env, stdin)
+        self.argv_seen.append(argv)
+        return _Command(exit_code=0, stdout=self.stdout, stderr="")
+
+
+@dataclass(kw_only=True)
+class _Journal:
+    records: list[dict[str, object]] = field(default_factory=list)
+
+    def append(self, *, record: dict[str, object]) -> None:
+        self.records.append(record)
+
+
+def _plan(*, tmp_path: Path) -> DispatchPlan:
+    return DispatchPlan(
+        repo=tmp_path,
+        work_item_id="bd-ib-6jkjzm",
+        branch="feat/bd-ib-6jkjzm",
+        workflow_toml=tmp_path / "workflow.toml",
+        goal_file=tmp_path / "goal.txt",
+        fabro_bin="fabro",
+        fabro_factory_name="hp",
+        fabro_factory_server=_SERVER_URL,
+        fabro_factory_dev_token=None,
+        janitor=("check",),
+        janitor_checkout=tmp_path / ".janitor",
+        janitor_core_checkout=tmp_path / ".janitor" / ".core",
+        janitor_core_repo_url="https://github.com/thewoolleyman/livespec.git",
+        janitor_core_ref="trunk",
+        review_fix_visit_cap=3,
+        merge_on_review_cap_outcome="succeeded",
+    )
+
+
+def _terminal() -> DispatchOutcome:
+    """The generic `failed` outcome this arm is handed, as the mapper builds it."""
+    return DispatchOutcome(
+        work_item_id="bd-ib-6jkjzm",
+        status="failed",
+        stage="fabro-run",
+        pr_number=None,
+        merge_sha=None,
+        detail=_FAILURE_MESSAGE,
+        fabro_run_id=_RUN_ID,
+        fabro_failure_cause=_FAILURE_MESSAGE,
+        fabro_failure_category="deterministic",
+    )
+
+
+def test_a_hook_refused_checkpoint_commit_names_its_node_error_and_every_target(
+    tmp_path: Path,
+) -> None:
+    """The one assertion: the detail names the run, the node, the error, the target."""
+    outcome = checkpoint_failure_outcome(
+        plan=_plan(tmp_path=tmp_path),
+        run_id=_RUN_ID,
+        probe=CheckpointProbe(runner=_EventsRunner(stdout=json.dumps(_EVENTS)), journal=_Journal()),
+        terminal=_terminal(),
+    )
+
