+"""Ledger storage effects for sanctioned plan-progress mutations."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any, cast
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import (
+    ProgressEvent,
+    committed_event,
+    render_progress_event,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    ProgressWrite,
+    TrackedNextAction,
+    action_metadata,
+)
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro._beads_client import BeadsClient, BeadsRecord
+    from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+__all__: list[str] = [
+    "finish_progress_write",
+    "is_live_plan",
+    "write_picker_plan_action",
+    "write_untracked_plan_action",
+]
+
+
+def finish_progress_write(  # noqa: PLR0913 -- reconciliation replays remaining effects.
+    *,
+    client: BeadsClient,
+    record: BeadsRecord,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    event: ProgressEvent,
+    handoff_body: str | None,
+    comments: list[dict[str, Any]],
+) -> ProgressWrite:
+    """Apply one prepared pointer transaction and append its committed mate."""
+    if handoff_body is not None and not _comment_exists(comments=comments, body=handoff_body):
+        client.add_comment(issue_id=epic_id, body=handoff_body)
+    client.update_issue(
+        issue_id=epic_id,
+        metadata=_pointer_metadata(
+            record=record,
+            action=action,
+            session=session,
+            now=now,
+            include_null_tracking=True,
+        ),
+    )
+    committed = committed_event(prepared=event)
+    client.add_comment(issue_id=epic_id, body=render_progress_event(event=committed))
+    return committed.write_result()
+
+
+def write_untracked_plan_action(  # noqa: PLR0913 -- compatibility mirrors the public mutation.
+    *,
+    client: BeadsClient,
+    record: BeadsRecord,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    operation_id: str,
+    handoff_body: str | None,
+) -> ProgressWrite:
+    """Keep the pre-tracking behavior for non-live and migration records."""
+    if handoff_body is not None:
+        client.add_comment(issue_id=epic_id, body=handoff_body)
+    client.update_issue(
+        issue_id=epic_id,
+        metadata=_pointer_metadata(record=record, action=action, session=session, now=now),
+    )
+    budget = action.budget
+    return ProgressWrite(
+        epoch="",
+        operation_id=operation_id,
+        deadline=None if budget is None else budget.deadline,
+        max_handoffs=None if budget is None else budget.max_handoffs,
+        accepted_handoffs=int(handoff_body is not None),
+    )
+
+
+def write_picker_plan_action(  # noqa: PLR0913 -- picker write mirrors the public mutation.
+    *,
+    client: BeadsClient,
+    record: BeadsRecord,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    operation_id: str,
+    handoff_body: str | None,
+) -> ProgressWrite:
+    """Write a five-field picker pointer when no result epoch exists yet."""
+    if handoff_body is not None:
+        client.add_comment(issue_id=epic_id, body=handoff_body)
+    client.update_issue(
+        issue_id=epic_id,
+        metadata=_pointer_metadata(
+            record=record,
+            action=action,
+            session=session,
+            now=now,
+            include_null_tracking=True,
+        ),
+    )
+    return ProgressWrite(
+        epoch="",
+        operation_id=operation_id,
+        deadline=None,
+        max_handoffs=None,
+        accepted_handoffs=0,
+    )
+
+
+def is_live_plan(*, config: StoreConfig, record: BeadsRecord) -> bool:
+    """Whether this record has persisted plan authority requiring progress events."""
+    metadata = _record_metadata(record=record)
+    slug = metadata.get("plan_slug")
+    return (
+        record.get("status") != "closed"
+        and isinstance(slug, str)
+        and config.repo_root is not None
+        and (config.repo_root / "plan" / slug).is_dir()
+    )
+
+
+def _comment_exists(*, comments: list[dict[str, Any]], body: str) -> bool:
+    return any(comment.get("text") == body for comment in comments)
+
+
+def _pointer_metadata(
+    *,
+    record: BeadsRecord,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    include_null_tracking: bool = False,
+) -> dict[str, Any]:
+    metadata = _record_metadata(record=record)
+    metadata["next_action"] = action_metadata(
+        action=action,
+        include_null_tracking=include_null_tracking,
+    )
+    metadata["last_session"] = f"{session} at {now}"
+    return metadata
+
+
+def _record_metadata(*, record: BeadsRecord) -> dict[str, Any]:
+    return dict(cast("dict[str, Any]", record.get("metadata", {})))
