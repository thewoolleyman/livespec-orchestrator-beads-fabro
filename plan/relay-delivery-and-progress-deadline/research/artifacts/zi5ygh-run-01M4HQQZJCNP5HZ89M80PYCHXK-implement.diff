@@ -0,0 +1,258 @@
+"""Scenario 147: shared authority serializes concurrent plan writers."""
+
+from __future__ import annotations
+
+import importlib
+import json
+import tempfile
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from typing import Any
+
+import pytest
+from livespec_orchestrator_beads_fabro._beads_client import (
+    FakeBeadsClient,
+    IssueDraft,
+    make_beads_client,
+    reset_fake_singleton,
+)
+from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+_REPO = "livespec-orchestrator-beads-fabro"
+_EPIC = "bd-ib-progress-concurrency"
+_TARGET = "bd-ib-progress-concurrency-target"
+_DEADLINE = "2026-10-09T10:00:00Z"
+_RESULT: dict[str, object] = {
+    "repo": _REPO,
+    "item_status": {"item_id": _TARGET, "status": "closed"},
+}
+
+
+def _config(*, project_root: Path, fake: bool = True) -> StoreConfig:
+    return StoreConfig(
+        tenant=_REPO,
+        prefix="bd-ib",
+        server_user=_REPO,
+        database=_REPO,
+        bd_path="/usr/local/bin/bd",
+        fake=fake,
+        repo_root=project_root,
+    )
+
+
+def _client(*, config: StoreConfig) -> FakeBeadsClient:
+    client = make_beads_client(config=config)
+    assert isinstance(client, FakeBeadsClient)
+    return client
+
+
+def _seed(*, project_root: Path, config: StoreConfig) -> None:
+    (project_root / "plan" / "progress-concurrency").mkdir(parents=True)
+    client = _client(config=config)
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=_EPIC,
+            issue_type="epic",
+            title="progress concurrency",
+            description="## Definition of Done\n\n- The target closes.\n",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"plan_slug": "progress-concurrency", "rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=_EPIC, status="active")
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=_TARGET,
+            issue_type="feature",
+            title="required result",
+            description="still open",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=_TARGET, status="ready")
+
+
+def _continuation(
+    *, plan: Any, config: StoreConfig, epoch: str, role: str, local: threading.local
+) -> object:
+    local.role = role
+    return plan.append_handoff(
+        config=config,
+        epic_id=_EPIC,
+        body=f"Concurrent handoff from {role}.",
+        author=role,
+        now="2026-10-09T09:10:00Z",
+        next_action=plan.NextAction(
+            kind="impl",
+            ref=_TARGET,
+            text="Close the required target.",
+            required_result=_RESULT,
+            budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=4),
+        ),
+        operation_id=f"operation-{role}",
+        expected_epoch=epoch,
+    )
+
+
+def _prepare_race(*, tmp_path: Path, plan: Any) -> tuple[StoreConfig, str, int]:
+    reset_fake_singleton()
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    config = _config(project_root=project_root)
+    _seed(project_root=project_root, config=config)
+    start = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=plan.NextAction(
+            kind="impl",
+            ref=_TARGET,
+            text="Close the required target.",
+            required_result=_RESULT,
+            budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=4),
+        ),
+        session="initial-writer",
+        now="2026-10-09T09:00:00Z",
+        operation_id="initial-operation",
+    )
+    comment_count = len(_client(config=config).list_comments(issue_id=_EPIC))
+    return config, start.epoch, comment_count
+
+
+def _install_distinct_temp_namespaces(
+    *,
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    local: threading.local,
+) -> None:
+    host_one = tmp_path / "host-one-tmp"
+    host_two = tmp_path / "host-two-tmp"
+    host_one.mkdir()
+    host_two.mkdir()
+    monkeypatch.setattr(
+        tempfile,
+        "gettempdir",
+        lambda: str(host_one if getattr(local, "role", "one") == "one" else host_two),
+    )
+
+
+def _install_result_rendezvous(
+    *, monkeypatch: pytest.MonkeyPatch, writer: Any, local: threading.local
+) -> threading.Event:
+    first_reading = threading.Event()
+    second_reading = threading.Event()
+    original_read_result = writer.read_result
+
+    def synchronized_read_result(
+        *, project_root: Path, reference: object, runner: Any, now: str | None = None
+    ) -> Any:
+        role = getattr(local, "role", "")
+        if role == "one":
+            first_reading.set()
+            _ = second_reading.wait(timeout=0.25)
+        else:
+            assert role == "two"
+            second_reading.set()
+        return original_read_result(
+            project_root=project_root,
+            reference=reference,
+            runner=runner,
+            now=now,
+        )
+
+    monkeypatch.setattr(writer, "read_result", synchronized_read_result)
+    return first_reading
+
+
+def _run_concurrent_writers(
+    *, plan: Any, config: StoreConfig, epoch: str, local: threading.local, ready: threading.Event
+) -> list[object]:
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        futures = [
+            executor.submit(
+                _continuation,
+                plan=plan,
+                config=config,
+                epoch=epoch,
+                role="one",
+                local=local,
+            )
+        ]
+        assert ready.wait(timeout=2), "the first writer never reached its result read"
+        futures.append(
+            executor.submit(
+                _continuation,
+                plan=plan,
+                config=config,
+                epoch=epoch,
+                role="two",
+                local=local,
+            )
+        )
+        outcomes: list[object] = []
+        for future in futures:
+            try:
+                outcomes.append(future.result(timeout=5))
+            except plan.PlanProgressRefusedError as error:
+                outcomes.append(error)
+    return outcomes
+
+
+def _assert_serialized_outcome(
+    *, plan: Any, progress_types: Any, config: StoreConfig, before: int, outcomes: list[object]
+) -> None:
+    writes = [outcome for outcome in outcomes if isinstance(outcome, progress_types.ProgressWrite)]
+    refusals = [
+        outcome for outcome in outcomes if isinstance(outcome, plan.PlanProgressRefusedError)
+    ]
+    assert len(writes) == 1
+    assert len(refusals) == 1
+    assert "stale prior epoch" in str(refusals[0])
+    added = _client(config=config).list_comments(issue_id=_EPIC)[before:]
+    bodies = [str(comment["text"]) for comment in added]
+    assert len([body for body in bodies if body.startswith("plan-handoff-entry\n")]) == 1
+    committed_operations = {
+        json.loads(body.split("\n", maxsplit=1)[1])["operation_id"]
+        for body in bodies
+        if body.startswith("plan-progress-event\n")
+        and json.loads(body.split("\n", maxsplit=1)[1])["phase"] == "committed"
+    }
+    assert committed_operations in ({"operation-one"}, {"operation-two"})
+
+
+def test_same_host_authority_serializes_concurrent_stale_writers_before_plan_mutation(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    writer = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_writer"
+    )
+    progress_types = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_types"
+    )
+    config, epoch, comment_count = _prepare_race(tmp_path=tmp_path, plan=plan)
+    local = threading.local()
+    _install_distinct_temp_namespaces(
+        tmp_path=tmp_path,
+        monkeypatch=monkeypatch,
+        local=local,
+    )
+    ready = _install_result_rendezvous(monkeypatch=monkeypatch, writer=writer, local=local)
+    outcomes = _run_concurrent_writers(
+        plan=plan,
+        config=config,
+        epoch=epoch,
+        local=local,
+        ready=ready,
+    )
+    _assert_serialized_outcome(
+        plan=plan,
+        progress_types=progress_types,
+        config=config,
+        before=comment_count,
+        outcomes=outcomes,
+    )
