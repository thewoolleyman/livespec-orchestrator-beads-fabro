+def _assert_expired(
+    *, plan: Any, config: StoreConfig, observation: Any, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    observed = observation.unsatisfied(
+        repo=_REPO,
+        target=f"item_status {_TARGET} status closed",
+        source="ledger",
+        now=_DEADLINE,
+        evidence=f"ledger record {_TARGET} at status ready",
+        detail="target remains ready",
+    )
+    _set_observation(monkeypatch=monkeypatch, observed=observed)
+    before_pointer = _pointer(config=config)
+    before_comments = _comments(config=config)
+    expired = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now=_DEADLINE,
+    )
+    assert expired.ask
+    assert expired.next_action is None
+    assert expired.reason == "expired plan progress requires causal diagnosis or recovery"
+    assert expired.findings == (
+        "plan-progress-tracking: expired; "
+        f"result={_IDENTITY}; deadline={_DEADLINE}; handoffs=0/2; "
+        f"observation=unsatisfied; evidence=ledger record {_TARGET} at status ready; "
+        f"recovery=diagnose-plan-progress:{_EPIC}",
+    )
+    assert _pointer(config=config) == before_pointer
+    assert _comments(config=config) == before_comments
