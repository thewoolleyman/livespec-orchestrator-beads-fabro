+"""Scenario 147: expiry admits one evidenced, bounded causal recovery attempt."""
+
+from __future__ import annotations
+
+import importlib
+import json
+from dataclasses import replace
+from pathlib import Path
+from typing import Any, cast
+
+import pytest
+from livespec_orchestrator_beads_fabro._beads_client import (
+    FakeBeadsClient,
+    IssueDraft,
+    make_beads_client,
+    reset_fake_singleton,
+)
+from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+_REPO = "livespec-orchestrator-beads-fabro"
+_EPIC = "bd-ib-causal-plan"
+_TARGET = "bd-ib-causal-target"
+_DEADLINE = "2026-10-09T10:00:00Z"
+_RESULT: dict[str, object] = {
+    "repo": _REPO,
+    "item_status": {"item_id": _TARGET, "status": "closed"},
+}
+
+
+def _config(*, project_root: Path) -> StoreConfig:
+    return StoreConfig(
+        tenant=_REPO,
+        prefix="bd-ib",
+        server_user=_REPO,
+        database=_REPO,
+        bd_path="bd",
+        fake=True,
+        repo_root=project_root,
+    )
+
+
+def _client(*, config: StoreConfig) -> FakeBeadsClient:
+    client = make_beads_client(config=config)
+    assert isinstance(client, FakeBeadsClient)
+    return client
+
+
+def _seed(*, project_root: Path, config: StoreConfig) -> None:
+    (project_root / "plan" / "causal-plan").mkdir(parents=True)
+    client = _client(config=config)
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=_EPIC,
+            issue_type="epic",
+            title="causal recovery plan",
+            description="## Definition of Done\n\n- The target closes.\n",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"plan_slug": "causal-plan", "rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=_EPIC, status="active")
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=_TARGET,
+            issue_type="feature",
+            title="required result",
+            description="still open",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=_TARGET, status="ready")
+
+
+def _action(*, plan: Any) -> Any:
+    return plan.NextAction(
+        kind="impl",
+        ref=_TARGET,
+        text="Close the required target.",
+        required_result=_RESULT,
+        budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=3),
+    )
+
+
+def _comments(*, config: StoreConfig) -> list[dict[str, Any]]:
+    return _client(config=config).list_comments(issue_id=_EPIC)
+
+
+def _pointer(*, config: StoreConfig) -> dict[str, Any]:
+    value = _client(config=config).show_issue(issue_id=_EPIC)["metadata"]["next_action"]
+    assert isinstance(value, dict)
+    return dict(cast("dict[str, Any]", value))
+
+
+def _start(*, plan: Any, config: StoreConfig) -> Any:
+    return plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=_action(plan=plan),
+        session="causal-writer",
+        now="2026-10-09T09:00:00Z",
+        operation_id="causal-start",
+    )
+
+
+def _assert_prose_refused(*, plan: Any, config: StoreConfig, epoch: str) -> None:
+    before_comments = _comments(config=config)
+    before_pointer = _pointer(config=config)
+    with pytest.raises(plan.PlanProgressRefusedError, match="deadline"):
+        plan.append_handoff(
+            config=config,
+            epic_id=_EPIC,
+            body="approach: replay the old command with a new label",
+            author="causal-writer",
+            now=_DEADLINE,
+            next_action=_action(plan=plan),
+            operation_id="prose-is-not-recovery",
+            expected_epoch=epoch,
+        )
+    assert _comments(config=config) == before_comments
+    assert _pointer(config=config) == before_pointer
+
+
+def _recovery(*, plan: Any, epoch: str) -> Any:
+    return plan.CausalRecovery(
+        required_result=_RESULT,
+        previous_epoch=epoch,
+        failure_evidence="factory run 01FAIL exited 1 before a checkpoint",
+        cause="host",
+        next_operation=f"impl:{_TARGET}",
+        attempt_id="attempt-host-01",
+        attempt_deadline="2026-10-09T10:15:00Z",
+    )
+
+
+def _assert_invalid_recoveries(*, plan: Any, config: StoreConfig, recovery: Any) -> None:
+    invalid = (
+        replace(recovery, previous_epoch="stale"),
+        replace(recovery, required_result={"repo": _REPO, "item_status": {"item_id": "other"}}),
+        replace(recovery, failure_evidence=""),
+        replace(recovery, cause="cosmetic"),
+        replace(recovery, cause="unknown", next_operation="impl:retry-without-diagnosis"),
+        replace(recovery, next_operation="I will try a different approach."),
+        replace(
+            recovery,
+            cause="unknown",
+            next_operation="diagnose-this-is-not-a-supported-operation",
+        ),
+        replace(recovery, next_operation=""),
+        replace(recovery, attempt_id=""),
+        replace(recovery, attempt_deadline=_DEADLINE),
+        replace(recovery, attempt_deadline="not-a-time"),
+        replace(recovery, attempt_deadline="not-a-timeZ"),
+        replace(recovery, claim_receipt="self-claimed"),
+    )
+    for index, candidate in enumerate(invalid):
+        comments = _comments(config=config)
+        pointer = _pointer(config=config)
+        with pytest.raises(plan.PlanProgressRefusedError, match="causal recovery"):
+            plan.set_next_action(
+                config=config,
+                epic_id=_EPIC,
+                action=_action(plan=plan),
+                session="causal-writer",
+                now=_DEADLINE,
+                recovery=candidate,
+                operation_id=f"invalid-recovery-{index}",
+                expected_epoch=recovery.previous_epoch,
+            )
+        assert _comments(config=config) == comments
+        assert _pointer(config=config) == pointer
+    with pytest.raises(plan.PlanProgressRefusedError, match="not expired"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_action(plan=plan),
+            session="causal-writer",
+            now="2026-10-09T09:30:00Z",
+            recovery=recovery,
+            operation_id="premature-recovery",
+            expected_epoch=recovery.previous_epoch,
+        )
+
+
+def _recover_interrupted_write(
+    *, plan: Any, config: StoreConfig, recovery: Any, epoch: str, monkeypatch: pytest.MonkeyPatch
+) -> Any:
+    original_update = _client(config=config).update_issue
+    failures = 1
+
+    def _fail_pointer_once(*, issue_id: str, **changes: Any) -> None:
+        nonlocal failures
+        if failures:
+            failures -= 1
+            raise RuntimeError("simulated interruption after prepared event and handoff")
+        original_update(issue_id=issue_id, **changes)
+
+    monkeypatch.setattr(_client(config=config), "update_issue", _fail_pointer_once)
+    with pytest.raises(RuntimeError, match="simulated interruption"):
+        plan.append_handoff(
+            config=config,
+            epic_id=_EPIC,
+            body="Measured host failure; authorize the bounded operation.",
+            author="causal-writer",
+            now=_DEADLINE,
+            next_action=_action(plan=plan),
+            recovery=recovery,
+            operation_id="causal-recovery",
+            expected_epoch=epoch,
+        )
+    partial_count = len(_comments(config=config))
+    completed = plan.append_handoff(
+        config=config,
+        epic_id=_EPIC,
+        body="Measured host failure; authorize the bounded operation.",
+        author="causal-writer",
+        now=_DEADLINE,
+        next_action=_action(plan=plan),
+        recovery=recovery,
+        operation_id="causal-recovery",
+        expected_epoch=epoch,
+    )
+    assert completed.deadline == _DEADLINE
+    assert len(_comments(config=config)) == partial_count + 1
+    assert _pointer(config=config)["budget"] == {
+        "deadline": _DEADLINE,
+        "max_handoffs": 3,
+    }
+    return completed
+
+
+def _assert_recovery_event(*, config: StoreConfig, epoch: str) -> None:
+    event_text = _comments(config=config)[-1]["text"]
+    assert isinstance(event_text, str)
+    event = json.loads(event_text.split("\n", maxsplit=1)[1])
+    assert event["event_kind"] == "recovery"
+    assert event["recovery"] == {
+        "attempt_deadline": "2026-10-09T10:15:00Z",
+        "attempt_id": "attempt-host-01",
+        "cause": "host",
+        "claim_receipt": None,
+        "execution_receipt": None,
+        "failure_evidence": "factory run 01FAIL exited 1 before a checkpoint",
+        "next_operation": f"impl:{_TARGET}",
+        "outcome_receipt": None,
+        "previous_epoch": epoch,
+        "required_result": _RESULT,
+    }
+
+
+def _assert_retry_identity(
+    *, plan: Any, config: StoreConfig, recovery: Any, start_epoch: str, completed_epoch: str
+) -> None:
+    committed_comments = _comments(config=config)
+    retry = plan.append_handoff(
+        config=config,
+        epic_id=_EPIC,
+        body="Measured host failure; authorize the bounded operation.",
+        author="causal-writer",
+        now=_DEADLINE,
+        next_action=_action(plan=plan),
+        recovery=recovery,
+        operation_id="causal-recovery",
+        expected_epoch=start_epoch,
+    )
+    assert retry.idempotent
+    assert _comments(config=config) == committed_comments
+    with pytest.raises(plan.PlanProgressRefusedError, match="attempt-host-01"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_action(plan=plan),
+            session="causal-writer",
+            now="2026-10-09T10:01:00Z",
+            recovery=recovery,
+            operation_id="duplicate-attempt",
+            expected_epoch=completed_epoch,
+        )
+    assert _comments(config=config) == committed_comments
+
+
+def _assert_recovery_requires_an_expired_unsatisfied_obligation(
+    *,
+    plan: Any,
+    config: StoreConfig,
+    recovery: Any,
+    completed_epoch: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    observation = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_result_observation"
+    )
+    writer = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_writer"
+    )
+
+    def _satisfied(**_kwargs: Any) -> Any:
+        return observation.satisfied(
+            repo=_REPO,
+            target=f"item-status:{_TARGET}:closed",
+            source="ledger",
+            now="2026-10-09T10:01:00Z",
+            evidence=f"ledger record {_TARGET} at status closed",
+            detail="target is satisfied",
+        )
+
+    monkeypatch.setattr(writer, "read_result", _satisfied)
+    with pytest.raises(plan.PlanProgressRefusedError, match="not expired"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_action(plan=plan),
+            session="causal-writer",
+            now="2026-10-09T10:01:00Z",
+            recovery=replace(
+                recovery,
+                previous_epoch=completed_epoch,
+                attempt_id="attempt-after-satisfaction",
+            ),
+            operation_id="recovery-after-satisfaction",
+            expected_epoch=completed_epoch,
+        )
+
+
+def _assert_malformed_recovery_event_refused(*, config: StoreConfig) -> None:
+    event_module = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_event"
+    )
+    raw = _comments(config=config)[-1]["text"]
+    assert isinstance(raw, str)
+    payload = json.loads(raw.split("\n", maxsplit=1)[1])
+    payload["recovery"] = []
+    with pytest.raises(Exception, match="malformed event"):
+        event_module.parse_progress_events(
+            comments=[{"text": f"plan-progress-event\n{json.dumps(payload)}"}]
+        )
+
+
+def test_expiry_requires_one_typed_causal_recovery_and_reconciles_its_retry(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    assert hasattr(plan, "CausalRecovery"), "Scenario 147 requires typed causal recovery"
+    monkeypatch.setenv("LIVESPEC_BEADS_FAKE", "1")
+    reset_fake_singleton()
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    config = _config(project_root=project_root)
+    _seed(project_root=project_root, config=config)
+    with pytest.raises(plan.PlanProgressRefusedError, match="not expired"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_action(plan=plan),
+            session="causal-writer",
+            now="2026-10-09T09:00:00Z",
+            recovery=_recovery(plan=plan, epoch="no-obligation"),
+            operation_id="recovery-before-obligation",
+        )
+    start = _start(plan=plan, config=config)
+    _assert_prose_refused(plan=plan, config=config, epoch=start.epoch)
+    recovery = _recovery(plan=plan, epoch=start.epoch)
+    _assert_invalid_recoveries(plan=plan, config=config, recovery=recovery)
+    completed = _recover_interrupted_write(
+        plan=plan,
+        config=config,
+        recovery=recovery,
+        epoch=start.epoch,
+        monkeypatch=monkeypatch,
+    )
+    _assert_recovery_event(config=config, epoch=start.epoch)
+    _assert_retry_identity(
+        plan=plan,
+        config=config,
+        recovery=recovery,
+        start_epoch=start.epoch,
+        completed_epoch=completed.epoch,
+    )
+    _client(config=config).update_issue(issue_id=_TARGET, status="closed")
+    _assert_recovery_requires_an_expired_unsatisfied_obligation(
+        plan=plan,
+        config=config,
+        recovery=recovery,
+        completed_epoch=completed.epoch,
+        monkeypatch=monkeypatch,
+    )
+    _assert_malformed_recovery_event_refused(config=config)
+
+
+def _drive_repo(*, tmp_path: Path) -> Path:
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    _ = (project_root / ".livespec.jsonc").write_text(
+        json.dumps({"livespec-orchestrator-beads-fabro": {"connection": {"prefix": "bd-ib"}}}),
+        encoding="utf-8",
+    )
+    return project_root
+
+
+def _assert_caller_prose_refused(
+    *, plan: Any, config: StoreConfig, epoch: str
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    prose = "I will try a different approach."
+    prose_action = plan.NextAction(
+        kind="spec-op",
+        ref=prose,
+        text=prose,
+        required_result=_RESULT,
+        budget=plan.ResultBudget(deadline="2026-10-10T10:00:00Z", max_handoffs=9),
+    )
+    prose_recovery = plan.CausalRecovery(
+        required_result=_RESULT,
+        previous_epoch=epoch,
+        failure_evidence="host provider returned usageLimitExceeded",
+        cause="host",
+        next_operation=prose,
+        attempt_id="attempt-prose-is-not-an-operation",
+        attempt_deadline="2026-10-09T10:15:00Z",
+    )
+    unchanged_pointer = _pointer(config=config)
+    unchanged_comments = _comments(config=config)
+    with pytest.raises(plan.PlanProgressRefusedError, match="executable authorized operation"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=prose_action,
+            session="causal-writer",
+            now=_DEADLINE,
+            operation_id="caller-prose",
+            expected_epoch=epoch,
+            recovery=prose_recovery,
+        )
+    assert _pointer(config=config) == unchanged_pointer
+    assert _comments(config=config) == unchanged_comments
+    return unchanged_pointer, unchanged_comments
+
