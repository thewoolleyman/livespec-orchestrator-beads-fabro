+def _assert_bounded_recovery(
+    *,
+    plan: Any,
+    config: StoreConfig,
+    observation: Any,
+    monkeypatch: pytest.MonkeyPatch,
+    start_epoch: str,
+) -> None:
+    _assert_unsupported_recovery_refused(plan=plan, config=config, start_epoch=start_epoch)
+    recovery_operation = f"impl:{_TARGET}"
+    completed = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=_action(plan=plan),
+        session="resume-writer",
+        now=_DEADLINE,
+        recovery=plan.CausalRecovery(
+            required_result=_RESULT,
+            previous_epoch=start_epoch,
+            failure_evidence="ledger read recovered after an authenticated probe",
+            cause="host",
+            next_operation=recovery_operation,
+            attempt_id="attempt-resume-01",
+            attempt_deadline=_ATTEMPT_DEADLINE,
+        ),
+        operation_id="resume-recovery",
+        expected_epoch=start_epoch,
+    )
+    observed = observation.unsatisfied(
+        repo=_REPO,
+        target=f"item_status {_TARGET} status closed",
+        source="ledger",
+        now="2026-10-09T10:01:00Z",
+        evidence=f"ledger record {_TARGET} at status ready",
+        detail="target remains ready",
+    )
+    _set_observation(monkeypatch=monkeypatch, observed=observed)
+    authorized = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now="2026-10-09T10:01:00Z",
+    )
+    assert not authorized.ask
+    assert authorized.next_action == recovery_operation
+    assert authorized.reason == "bounded causal recovery attempt attempt-resume-01"
+    assert authorized.findings == (
+        "plan-progress-tracking: expired; "
+        f"result={_IDENTITY}; deadline={_DEADLINE}; handoffs=0/2; "
+        "observation=unsatisfied; evidence="
+        f"ledger record {_TARGET} at status ready; authorized-recovery=attempt-resume-01 "
+        f"until {_ATTEMPT_DEADLINE}",
+    )
+
+    attempt_expired = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now=_ATTEMPT_DEADLINE,
+    )
+    assert attempt_expired.ask
+    assert attempt_expired.next_action is None
+    assert attempt_expired.reason == "causal recovery attempt attempt-resume-01 expired"
+    assert f"recovery=diagnose-plan-progress:{_EPIC}" in attempt_expired.findings[0]
+    assert _pointer(config=config)["budget"] == {
+        "deadline": _DEADLINE,
+        "max_handoffs": 2,
+    }
+    assert completed.deadline == _DEADLINE
+
+    raw = _comments(config=config)[-1]["text"]
+    assert isinstance(raw, str)
+    payload = json.loads(raw.split("\n", maxsplit=1)[1])
+    payload.update({"operation_id": "interrupted-resume", "phase": "prepared"})
+    _client(config=config).add_comment(
+        issue_id=_EPIC,
+        body=f"plan-progress-event\n{json.dumps(payload)}",
+    )
+    partial = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now="2026-10-09T10:02:00Z",
+    )
+    assert partial.ask
+    assert partial.next_action is None
+    assert partial.reason == "partial plan progress must be reconciled before dispatch"
+    assert partial.findings == (
+        "plan-progress-tracking: unobservable; "
+        f"result={_IDENTITY}; detail=partial write interrupted-resume; "
+        f"recovery=diagnose-plan-progress:{_EPIC}",
+    )
+
