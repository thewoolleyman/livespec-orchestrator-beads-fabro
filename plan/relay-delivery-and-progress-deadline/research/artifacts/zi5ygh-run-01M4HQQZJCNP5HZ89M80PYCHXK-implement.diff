+    pending_recovery,
+    refuse_duplicate_attempt,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_operation import (
+    plan_progress_lock,
+    progress_operation_id,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_storage import (
+    finish_progress_write,
+    is_live_plan,
+    write_picker_plan_action,
+    write_untracked_plan_action,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    ProgressWrite,
+    ResultBudget,
+    TrackedNextAction,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_recovery import CausalRecovery
+from livespec_orchestrator_beads_fabro.commands._plan_result_observation import (
+    ResultObservation,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_reader import read_result
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro._beads_client import BeadsClient, BeadsRecord
+    from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+__all__: list[str] = ["write_plan_action"]
+
+
+def write_plan_action(  # noqa: PLR0913 -- one atomic public primitive carries every mutation identity.
+    *,
+    config: StoreConfig,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    operation_id: str | None,
+    expected_epoch: str | None,
+    handoff_body: str | None = None,
+    recovery: CausalRecovery | None = None,
+    human_decision: str | None = None,
+) -> ProgressWrite:
+    """Validate, prepare, apply, and commit one pointer mutation under an epic lock."""
+    resolved_operation = operation_id or progress_operation_id(
+        epic_id=epic_id,
+        action=action,
+        session=session,
+        now=now,
+        handoff_body=handoff_body,
+        human_decision=human_decision,
+    )
+    with plan_progress_lock(config=config, epic_id=epic_id):
+        client = make_beads_client(config=config)
+        record = client.show_issue(issue_id=epic_id)
+        if not is_live_plan(config=config, record=record):
+            return write_untracked_plan_action(
+                client=client,
+                record=record,
+                epic_id=epic_id,
+                action=action,
+                session=session,
+                now=now,
+                operation_id=resolved_operation,
+                handoff_body=handoff_body,
+            )
+        return _write_tracked(
+            client=client,
+            record=record,
+            config=config,
+            epic_id=epic_id,
+            action=action,
+            session=session,
+            now=now,
+            operation_id=resolved_operation,
+            expected_epoch=expected_epoch,
+            handoff_body=handoff_body,
+            recovery=recovery,
+            human_decision=human_decision,
+        )
+
+
+def _write_tracked(  # noqa: PLR0913 -- internal transaction receives the public mutation facts.
+    *,
+    client: BeadsClient,
+    record: BeadsRecord,
+    config: StoreConfig,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    operation_id: str,
+    expected_epoch: str | None,
+    handoff_body: str | None,
+    recovery: CausalRecovery | None,
+    human_decision: str | None,
+) -> ProgressWrite:
+    comments = client.list_comments(issue_id=epic_id)
+    events = parse_progress_events(comments=comments)
+    duplicate = committed_operation(events=events, operation_id=operation_id)
+    if duplicate is not None:
+        return duplicate.write_result(idempotent=True)
+    pending = pending_recovery(events=events, operation_id=operation_id, recovery=recovery)
+    if pending is not None:
+        return finish_progress_write(
+            client=client,
+            record=record,
+            epic_id=epic_id,
+            action=replace(
+                action,
+                required_result=pending.required_result,
+                budget=ResultBudget(
+                    deadline=pending.deadline,
+                    max_handoffs=pending.max_handoffs,
+                ),
+            ),
+            session=session,
+            now=now,
+            event=pending,
+            handoff_body=handoff_body,
+            comments=comments,
+        )
+    refuse_duplicate_attempt(events=events, recovery=recovery)
+    current = latest_committed(events=events)
+    decision = decide_progress_update(
+        epic_id=epic_id,
+        current=current,
+        candidate=action,
+        now=now,
+        operation_id=operation_id,
+        expected_epoch=expected_epoch,
+        is_handoff=handoff_body is not None,
+        observation=_observation(config=config, current=current, now=now),
+        recovery=recovery,
+        human_decision=human_decision,
+    )
+    if decision.event is None:
+        return write_picker_plan_action(
+            client=client,
+            record=record,
+            epic_id=epic_id,
+            action=decision.action,
+            session=session,
+            now=now,
+            operation_id=operation_id,
+            handoff_body=handoff_body,
+        )
+    client.add_comment(issue_id=epic_id, body=render_progress_event(event=decision.event))
+    return finish_progress_write(
+        client=client,
+        record=record,
+        epic_id=epic_id,
+        action=decision.action,
+        session=session,
+        now=now,
+        event=decision.event,
+        handoff_body=handoff_body,
+        comments=[],
+    )
+
+
+def _observation(
+    *, config: StoreConfig, current: ProgressEvent | None, now: str
+) -> ResultObservation | None:
+    if current is None:
+        return None
+    return read_result(
+        project_root=config.repo_root or Path.cwd(),
+        reference=current.required_result,
+        runner=ShellCommandRunner(),
+        now=now,
+    )
