@@ -0,0 +1,69 @@
+"""History lookup and retry reconciliation for durable progress events."""
+
+from __future__ import annotations
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import ProgressEvent
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    PlanProgressRefusedError,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_recovery import CausalRecovery
+
+__all__: list[str] = [
+    "committed_operation",
+    "latest_committed",
+    "pending_recovery",
+    "refuse_duplicate_attempt",
+]
+
+
+def latest_committed(*, events: tuple[ProgressEvent, ...]) -> ProgressEvent | None:
+    """Return the newest durable event, excluding an incomplete prepared mate."""
+    committed = [event for event in events if event.phase == "committed"]
+    return committed[-1] if committed else None
+
+
+def committed_operation(
+    *, events: tuple[ProgressEvent, ...], operation_id: str
+) -> ProgressEvent | None:
+    """Return a committed retry identity so the caller can recover its result."""
+    matches = [
+        event
+        for event in events
+        if event.operation_id == operation_id and event.phase == "committed"
+    ]
+    return matches[-1] if matches else None
+
+
+def pending_recovery(
+    *,
+    events: tuple[ProgressEvent, ...],
+    operation_id: str,
+    recovery: CausalRecovery | None,
+) -> ProgressEvent | None:
+    """Recover the matching prepared recovery or refuse an unreconciled write."""
+    if not events or events[-1].phase == "committed":
+        return None
+    pending = events[-1]
+    if (
+        pending.operation_id == operation_id
+        and pending.recovery is not None
+        and pending.recovery == recovery
+    ):
+        return pending
+    raise PlanProgressRefusedError.partial(
+        operation_id=pending.operation_id,
+        same_operation=pending.operation_id == operation_id,
+    )
+
+
+def refuse_duplicate_attempt(
+    *, events: tuple[ProgressEvent, ...], recovery: CausalRecovery | None
+) -> None:
+    """Refuse reuse of a causal attempt identity across distinct operations."""
+    if recovery is None:
+        return
+    if any(
+        event.recovery is not None and event.recovery.attempt_id == recovery.attempt_id
+        for event in events
+    ):
+        raise PlanProgressRefusedError.duplicate_attempt(attempt_id=recovery.attempt_id)
