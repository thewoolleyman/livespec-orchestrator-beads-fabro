@@ -0,0 +1,76 @@
+"""Host-shared serialization and stable operation identity for plan writes."""
+
+from __future__ import annotations
+
+import errno
+import hashlib
+import json
+import socket
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import TYPE_CHECKING
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    TrackedNextAction,
+    action_metadata,
+)
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+__all__: list[str] = [
+    "plan_progress_lock",
+    "progress_operation_id",
+]
+
+_LOCK_RETRY_SECONDS = 0.01
+
+
+def progress_operation_id(
+    *,
+    epic_id: str,
+    action: TrackedNextAction,
+    session: str,
+    now: str,
+    handoff_body: str | None,
+    human_decision: str | None = None,
+) -> str:
+    """Derive a retry-stable id when a caller does not supply one."""
+    payload = {
+        "epic_id": epic_id,
+        "action": action_metadata(action=action),
+        "session": session,
+        "now": now,
+        "handoff_body": handoff_body,
+        "human_decision": human_decision,
+    }
+    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+    return f"operation-{hashlib.sha256(encoded).hexdigest()[:20]}"
+
+
+@contextmanager
+def plan_progress_lock(*, config: StoreConfig, epic_id: str) -> Iterator[None]:
+    """Serialize same-host writers without filesystem or ledger lock state."""
+    identity = f"{config.database}\0{epic_id}".encode()
+    digest = hashlib.sha256(identity).hexdigest().encode()
+    address = b"\0livespec-plan-progress-" + digest
+    lease = _acquire_host_lease(address=address)
+    try:
+        yield
+    finally:
+        lease.close()
+
+
+def _acquire_host_lease(*, address: bytes) -> socket.socket:
+    """Bind one Linux abstract-socket name, waiting for its current owner."""
+    while True:
+        lease = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            lease.bind(address)
+        except OSError as error:
+            lease.close()
+            retry_seconds = {errno.EADDRINUSE: _LOCK_RETRY_SECONDS}[error.errno or 0]
+            time.sleep(retry_seconds)
+        else:
+            return lease
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_picker.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_picker.py
