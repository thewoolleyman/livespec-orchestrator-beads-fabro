+def _assert_unsupported_recovery_refused(
+    *, plan: Any, config: StoreConfig, start_epoch: str
+) -> None:
+    invalid_operation = f"impl:{_TARGET} --resume-after-ledger-diagnosis"
+    comments = _comments(config=config)
+    pointer = _pointer(config=config)
+    with pytest.raises(plan.PlanProgressRefusedError, match="executable authorized operation"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_action(plan=plan),
+            session="resume-writer",
+            now=_DEADLINE,
+            recovery=plan.CausalRecovery(
+                required_result=_RESULT,
+                previous_epoch=start_epoch,
+                failure_evidence="ledger read recovered after an authenticated probe",
+                cause="host",
+                next_operation=invalid_operation,
+                attempt_id="attempt-resume-invalid",
+                attempt_deadline=_ATTEMPT_DEADLINE,
+            ),
+            operation_id="resume-recovery-invalid",
+            expected_epoch=start_epoch,
+        )
+    assert _comments(config=config) == comments
+    assert _pointer(config=config) == pointer
