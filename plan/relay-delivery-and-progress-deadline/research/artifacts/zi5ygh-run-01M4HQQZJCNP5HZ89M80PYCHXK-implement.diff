@@ -0,0 +1,34 @@
+"""Read-only action selection for the drive operator router."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from livespec_orchestrator_beads_fabro.commands._drive_config import (
+    is_config_action,
+    run_config_action,
+)
+from livespec_orchestrator_beads_fabro.commands._drive_plan_progress_diagnosis import (
+    is_plan_progress_diagnosis_action,
+    run_plan_progress_diagnosis,
+)
+
+__all__: list[str] = [
+    "is_read_only_action",
+    "run_read_only_action",
+]
+
+
+def is_read_only_action(*, action_id: str) -> bool:
+    """Whether an action id selects any read-only drive handler."""
+    return is_config_action(action_id=action_id) or is_plan_progress_diagnosis_action(
+        action_id=action_id
+    )
+
+
+def run_read_only_action(*, repo: Path, action_id: str) -> dict[str, Any]:
+    """Run the selected read-only handler."""
+    if is_config_action(action_id=action_id):
