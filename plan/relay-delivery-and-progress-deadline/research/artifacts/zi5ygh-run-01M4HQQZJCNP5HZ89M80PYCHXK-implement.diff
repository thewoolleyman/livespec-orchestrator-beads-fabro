+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_drive_plan_progress_diagnosis.py
@@ -0,0 +1,78 @@
+"""Read-only executor for the plan-progress diagnosis action.
+
+The unattended resume emits ``diagnose-plan-progress:<epic>`` when a tracked
+obligation is expired, unobservable, partial, or missing its durable progress
+history.  This module is the matching executor: it repeats the authoritative
+progress observation through the same reader as resume, reports the measured
+finding, and writes nothing.  Recording a recovery attempt remains a separate
+sanctioned plan write, and neither this successful read nor its transport
+status claims that the target was fulfilled.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any, cast
+
+from livespec_orchestrator_beads_fabro._beads_client import make_beads_client
+from livespec_orchestrator_beads_fabro._store_ready_dwell import utc_now_iso
+from livespec_orchestrator_beads_fabro.commands._config import resolve_store_config
+from livespec_orchestrator_beads_fabro.commands._plan_next_action import (
+    NEXT_ACTION_METADATA_KEY,
+    NextAction,
+    parse_next_action,
+    record_metadata,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_resume import (
+    evaluate_resume_progress,
+)
+
+__all__: list[str] = [
+    "PLAN_PROGRESS_DIAGNOSIS_PREFIX",
+    "is_plan_progress_diagnosis_action",
+    "run_plan_progress_diagnosis",
+]
+
+PLAN_PROGRESS_DIAGNOSIS_PREFIX = "diagnose-plan-progress:"
+
+
+def is_plan_progress_diagnosis_action(*, action_id: str) -> bool:
+    """Whether an action id selects the plan-progress diagnosis executor."""
+    return action_id.startswith(PLAN_PROGRESS_DIAGNOSIS_PREFIX)
+
+
+def run_plan_progress_diagnosis(*, repo: Path, action_id: str) -> dict[str, Any]:
+    """Execute one bounded authoritative observation without ledger mutation."""
+    epic_id = action_id.removeprefix(PLAN_PROGRESS_DIAGNOSIS_PREFIX)
+    config = resolve_store_config(cwd=repo, work_items_arg=None)
+    client = make_beads_client(config=config)
+    record = client.show_issue(issue_id=epic_id)
+    action = cast(
+        "NextAction",
+        parse_next_action(value=record_metadata(record=record).get(NEXT_ACTION_METADATA_KEY)),
+    )
+    diagnosis = evaluate_resume_progress(
+        config=config,
+        epic_id=epic_id,
+        action=action,
+        comments=client.list_comments(issue_id=epic_id),
+        now=utc_now_iso(),
+    )
+    return {
+        "action_id": action_id,
+        "kind": "plan-progress-diagnosis",
+        "work_item_ref": epic_id,
+        "status": "green",
+        "diagnosis": {
+            "executed": True,
+            "findings": list(diagnosis.findings),
+            "reason": diagnosis.reason,
+            "authorized_next_operation": diagnosis.next_action,
+            "ledger_mutation": False,
+            "target_fulfillment": "not-asserted",
+        },
+        "summary": (
+            f"Executed read-only plan progress diagnosis for {epic_id}; no recovery, "
+            "execution, or target-fulfillment receipt was recorded."
+        ),
+    }
