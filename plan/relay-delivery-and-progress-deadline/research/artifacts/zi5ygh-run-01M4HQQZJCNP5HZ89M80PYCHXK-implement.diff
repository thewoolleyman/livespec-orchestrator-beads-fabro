@@ -0,0 +1,152 @@
+"""Read-only plan-progress decision that precedes unattended resume dispatch."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, cast
+
+from livespec_orchestrator_beads_fabro.commands._dispatcher_io import ShellCommandRunner
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import (
+    ProgressEvent,
+    parse_progress_events,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_limits import (
+    deadline_reached,
+    progress_expiry,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import TrackedNextAction
+from livespec_orchestrator_beads_fabro.commands._plan_result_observation import (
+    OBSERVATION_SATISFIED,
+    OBSERVATION_UNOBSERVABLE,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_reader import read_result
+from livespec_orchestrator_beads_fabro.commands._plan_result_reference import (
+    parse_result_reference,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_targets import ResultReference
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+__all__: list[str] = [
+    "ResumeProgressDecision",
+    "evaluate_resume_progress",
+]
+
+
+@dataclass(frozen=True, kw_only=True)
+class ResumeProgressDecision:
+    """A progress finding and any bounded operation it permits."""
+
+    findings: tuple[str, ...] = ()
+    reason: str | None = None
+    next_action: str | None = None
+
+
+def evaluate_resume_progress(
+    *,
+    config: StoreConfig,
+    epic_id: str,
+    action: TrackedNextAction,
+    comments: list[dict[str, Any]],
+    now: str,
+) -> ResumeProgressDecision:
+    """Observe one tracked pointer and refuse unsafe unattended continuation."""
+    events = parse_progress_events(comments=comments)
+    if not events:
+        return ResumeProgressDecision(
+            findings=(_missing_finding(epic_id=epic_id, action=action),),
+            reason="plan progress history is missing for tracked pointer",
+        )
+    newest = events[-1]
+    if newest.phase == "prepared":
+        return ResumeProgressDecision(
+            findings=(_partial_finding(epic_id=epic_id, event=newest),),
+            reason="partial plan progress must be reconciled before dispatch",
+        )
+    current = cast("ProgressEvent", _latest_committed(events=events))
+    observed = read_result(
+        project_root=config.repo_root or Path.cwd(),
+        reference=current.required_result,
+        runner=ShellCommandRunner(),
+        now=now,
+    )
+    if observed.status == OBSERVATION_UNOBSERVABLE:
+        finding = (
+            "plan-progress-tracking: unobservable; "
+            f"result={current.result_identity}; deadline={current.deadline}; "
+            f"handoffs={current.accepted_handoffs}/{current.max_handoffs}; "
+            f"source={observed.source}; detail={observed.detail}; "
+            f"recovery={_diagnosis(epic_id=epic_id)}"
+        )
+        return ResumeProgressDecision(
+            findings=(finding,),
+            reason="unobservable plan progress requires diagnosis before dispatch",
+        )
+    if observed.status == OBSERVATION_SATISFIED:
+        return ResumeProgressDecision()
+    expiry = progress_expiry(current=current, now=now)
+    if expiry is None:
+        return ResumeProgressDecision()
+    return _expired_decision(
+        epic_id=epic_id,
+        current=current,
+        observation_evidence=observed.evidence,
+        now=now,
+    )
+
+
+def _expired_decision(
+    *, epic_id: str, current: ProgressEvent, observation_evidence: str, now: str
+) -> ResumeProgressDecision:
+    recovery = current.recovery
+    prefix = (
+        "plan-progress-tracking: expired; "
+        f"result={current.result_identity}; deadline={current.deadline}; "
+        f"handoffs={current.accepted_handoffs}/{current.max_handoffs}; "
+        f"observation=unsatisfied; evidence={observation_evidence}; "
+    )
+    if recovery is None:
+        return ResumeProgressDecision(
+            findings=(f"{prefix}recovery={_diagnosis(epic_id=epic_id)}",),
+            reason="expired plan progress requires causal diagnosis or recovery",
+        )
+    if deadline_reached(now=now, deadline=recovery.attempt_deadline):
+        return ResumeProgressDecision(
+            findings=(f"{prefix}recovery={_diagnosis(epic_id=epic_id)}",),
+            reason=f"causal recovery attempt {recovery.attempt_id} expired",
+        )
+    return ResumeProgressDecision(
+        findings=(
+            f"{prefix}authorized-recovery={recovery.attempt_id} until {recovery.attempt_deadline}",
+        ),
+        reason=f"bounded causal recovery attempt {recovery.attempt_id}",
+        next_action=recovery.next_operation,
+    )
+
+
+def _latest_committed(*, events: tuple[ProgressEvent, ...]) -> ProgressEvent | None:
+    committed = [event for event in events if event.phase == "committed"]
+    return committed[-1] if committed else None
+
+
+def _missing_finding(*, epic_id: str, action: TrackedNextAction) -> str:
+    parsed = parse_result_reference(value=action.required_result)
+    identity = cast("ResultReference", parsed).identity
+    return (
+        f"plan-progress-tracking: missing; result={identity}; "
+        f"recovery={_diagnosis(epic_id=epic_id)}"
+    )
+
+
+def _partial_finding(*, epic_id: str, event: ProgressEvent) -> str:
+    return (
+        "plan-progress-tracking: unobservable; "
+        f"result={event.result_identity}; detail=partial write {event.operation_id}; "
+        f"recovery={_diagnosis(epic_id=epic_id)}"
+    )
+
+
+def _diagnosis(*, epic_id: str) -> str:
+    return f"diagnose-plan-progress:{epic_id}"
