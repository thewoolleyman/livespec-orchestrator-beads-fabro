+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_decision.py
@@ -0,0 +1,210 @@
+"""Pure continuity and boundary decisions for one plan-progress mutation."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from typing import cast
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import (
+    ProgressEvent,
+    continued_progress_event,
+    progress_epoch,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_limits import (
+    progress_expiry,
+    raise_expired_progress,
+    validate_action_tracking,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_picker import (
+    PICKER_KINDS,
+    decide_picker_update,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    PlanProgressRefusedError,
+    ResultBudget,
+    TrackedNextAction,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_recovery import (
+    CausalRecovery,
+    validate_causal_recovery,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_observation import (
+    OBSERVATION_SATISFIED,
+    ResultObservation,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_targets import (
+    ResultReference,
+)
+
+__all__: list[str] = [
+    "ProgressDecision",
+    "decide_progress_update",
+]
+
+
+@dataclass(frozen=True, kw_only=True)
+class ProgressDecision:
+    """The effective pointer and prepared event a validated mutation may write."""
+
+    action: TrackedNextAction
+    event: ProgressEvent | None
+
+
+def decide_progress_update(  # noqa: PLR0913 -- pure decision needs every candidate/prior fact.
+    *,
+    epic_id: str,
+    current: ProgressEvent | None,
+    candidate: TrackedNextAction,
+    now: str,
+    operation_id: str,
+    expected_epoch: str | None,
+    is_handoff: bool,
+    observation: ResultObservation | None,
+    recovery: CausalRecovery | None,
+    human_decision: str | None,
+) -> ProgressDecision:
+    """Preserve an unmet budget or begin a fresh epoch after satisfaction."""
+    if candidate.kind in PICKER_KINDS:
+        action, event = decide_picker_update(
+            current=current,
+            candidate=candidate,
+            now=now,
+            operation_id=operation_id,
+            expected_epoch=expected_epoch,
+            is_handoff=is_handoff,
+            observation=observation,
+            recovery=recovery,
+            human_decision=human_decision,
+        )
+        return ProgressDecision(action=action, event=event)
+    if human_decision is not None:
+        raise PlanProgressRefusedError.unexpected_human_decision()
+    parsed, candidate_budget = validate_action_tracking(action=candidate)
+    if current is None:
+        if expected_epoch is not None:
+            raise PlanProgressRefusedError.stale(expected=expected_epoch, current=None)
+        if recovery is not None:
+            raise PlanProgressRefusedError.recovery_not_expired()
+        return _initial_decision(
+            parsed=parsed,
+            candidate=candidate,
+            budget=candidate_budget,
+            now=now,
+            operation_id=operation_id,
+            is_handoff=is_handoff,
+        )
+    if expected_epoch != current.epoch:
+        raise PlanProgressRefusedError.stale(expected=expected_epoch, current=current.epoch)
+    observed = cast("ResultObservation", observation)
+    if observed.status == OBSERVATION_SATISFIED:
+        if recovery is not None:
+            raise PlanProgressRefusedError.recovery_not_expired()
+        return _initial_decision(
+            parsed=parsed,
+            candidate=candidate,
+            budget=candidate_budget,
+            now=now,
+            operation_id=operation_id,
+            is_handoff=is_handoff,
+            previous_epoch=current.epoch,
+            observation_status=observed.status,
+            observation_evidence=observed.evidence,
+        )
+    if parsed.identity != current.result_identity:
+        raise PlanProgressRefusedError.renamed_result()
+    return _continuation_decision(
+        epic_id=epic_id,
+        current=current,
+        candidate=candidate,
+        now=now,
+        operation_id=operation_id,
+        is_handoff=is_handoff,
+        observed=observed,
+        recovery=recovery,
+    )
+
+
+def _continuation_decision(  # noqa: PLR0913 -- continuation needs candidate and prior facts.
+    *,
+    epic_id: str,
+    current: ProgressEvent,
+    candidate: TrackedNextAction,
+    now: str,
+    operation_id: str,
+    is_handoff: bool,
+    observed: ResultObservation,
+    recovery: CausalRecovery | None,
+) -> ProgressDecision:
+    expiry = progress_expiry(current=current, now=now)
+    if expiry is None and recovery is not None:
+        raise PlanProgressRefusedError.recovery_not_expired()
+    if expiry is not None and recovery is None:
+        raise_expired_progress(current=current, expiry=expiry)
+    if recovery is not None:
+        pointer_operation = {
+            "impl": f"impl:{candidate.ref.strip()}",
+            "spec-op": candidate.ref.strip(),
+        }[candidate.kind]
+        validate_causal_recovery(
+            recovery=recovery,
+            current_epoch=current.epoch,
+            current_result_identity=current.result_identity,
+            now=now,
+            authorized_operation=(
+                f"diagnose-plan-progress:{epic_id}"
+                if recovery.cause == "unknown"
+                else pointer_operation
+            ),
+        )
+    accepted = current.accepted_handoffs + int(is_handoff)
+    budget = ResultBudget(deadline=current.deadline, max_handoffs=current.max_handoffs)
+    effective = replace(candidate, required_result=current.required_result, budget=budget)
+    return ProgressDecision(
+        action=effective,
+        event=continued_progress_event(
+            previous=current,
+            operation_id=operation_id,
+            event_kind=(
+                "recovery" if recovery is not None else "handoff" if is_handoff else "pointer"
+            ),
+            accepted_handoffs=accepted,
+            observation_status=observed.status,
+            observation_evidence=observed.evidence,
+            recovery=recovery,
+            human_decision=None,
+        ),
+    )
+
+
+def _initial_decision(  # noqa: PLR0913 -- an epoch records each required initial field.
+    *,
+    parsed: ResultReference,
+    candidate: TrackedNextAction,
+    budget: ResultBudget,
+    now: str,
+    operation_id: str,
+    is_handoff: bool,
+    previous_epoch: str | None = None,
+    observation_status: str = "not-observed",
+    observation_evidence: str = "no prior obligation",
+) -> ProgressDecision:
+    accepted = int(is_handoff)
+    event = ProgressEvent(
+        epoch=progress_epoch(previous_epoch=previous_epoch, operation_id=operation_id),
+        previous_epoch=previous_epoch,
+        operation_id=operation_id,
+        event_kind="handoff" if is_handoff else "pointer",
+        phase="prepared",
+        required_result=candidate.required_result or {},
+        result_identity=parsed.identity,
+        deadline=budget.deadline,
+        max_handoffs=budget.max_handoffs,
+        started_at=now,
+        accepted_handoffs=accepted,
+        handoff_baseline=accepted,
+        observation_status=observation_status,
+        observation_evidence=observation_evidence,
+        recovery=None,
+        human_decision=None,
+    )
+    return ProgressDecision(action=candidate, event=event)
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_event.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_event.py
new file mode 100644
index 00000000..c6079351
--- /dev/null
+++ b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_event.py
@@ -0,0 +1,197 @@
+"""Durable fixed-first-line plan progress events on the existing epic."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import asdict, dataclass, replace
+from typing import Any, cast
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    PlanProgressRefusedError,
+    ProgressWrite,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_recovery import CausalRecovery
+
+__all__: list[str] = [
+    "PLAN_PROGRESS_EVENT_PREFIX",
+    "ProgressEvent",
+    "committed_event",
+    "continued_progress_event",
+    "parse_progress_events",
+    "progress_epoch",
+    "render_progress_event",
+]
+
+PLAN_PROGRESS_EVENT_PREFIX = "plan-progress-event"
+
+
+@dataclass(frozen=True, kw_only=True)
+class ProgressEvent:
+    """One prepared or committed mutation of a result obligation epoch."""
+
+    epoch: str
+    previous_epoch: str | None
+    operation_id: str
+    event_kind: str
+    phase: str
+    required_result: dict[str, object]
+    result_identity: str
+    deadline: str
+    max_handoffs: int
+    started_at: str
+    accepted_handoffs: int
+    handoff_baseline: int
+    observation_status: str
+    observation_evidence: str
+    recovery: CausalRecovery | None
+    human_decision: str | None
+
+    def write_result(self, *, idempotent: bool = False) -> ProgressWrite:
+        """Project the event into the public sanctioned-writer result."""
+        return ProgressWrite(
+            epoch=self.epoch,
+            operation_id=self.operation_id,
+            deadline=self.deadline,
+            max_handoffs=self.max_handoffs,
+            accepted_handoffs=self.accepted_handoffs,
+            idempotent=idempotent,
+        )
+
+
+def render_progress_event(*, event: ProgressEvent) -> str:
+    """Render one fixed-first-line event with a canonical JSON payload."""
+    payload = json.dumps(asdict(event), sort_keys=True, separators=(",", ":"))
+    return f"{PLAN_PROGRESS_EVENT_PREFIX}\n{payload}"
+
+
+def parse_progress_events(*, comments: list[dict[str, Any]]) -> tuple[ProgressEvent, ...]:
+    """Read every progress event, refusing a prefixed record that is malformed."""
+    events: list[ProgressEvent] = []
+    for comment in comments:
+        raw = comment.get("text")
+        if not isinstance(raw, str) or not raw.startswith(f"{PLAN_PROGRESS_EVENT_PREFIX}\n"):
+            continue
+        try:
+            payload = json.loads(raw.split("\n", maxsplit=1)[1])
+            events.append(_event(value=payload))
+        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
+            raise PlanProgressRefusedError.malformed_history() from error
+    return tuple(events)
+
+
+def committed_event(*, prepared: ProgressEvent) -> ProgressEvent:
+    """Return the immutable committed mate of one prepared event."""
+    return replace(prepared, phase="committed")
+
+
+def continued_progress_event(  # noqa: PLR0913 -- the event records each continuity fact.
+    *,
+    previous: ProgressEvent,
+    operation_id: str,
+    event_kind: str,
+    accepted_handoffs: int,
+    observation_status: str,
+    observation_evidence: str,
+    recovery: CausalRecovery | None,
+    human_decision: str | None,
+) -> ProgressEvent:
+    """Prepare the next immutable epoch while retaining the original obligation."""
+    return replace(
+        previous,
+        epoch=progress_epoch(previous_epoch=previous.epoch, operation_id=operation_id),
+        previous_epoch=previous.epoch,
+        operation_id=operation_id,
+        event_kind=event_kind,
+        phase="prepared",
+        accepted_handoffs=accepted_handoffs,
+        observation_status=observation_status,
+        observation_evidence=observation_evidence,
+        recovery=recovery,
+        human_decision=human_decision,
+    )
+
+
+def progress_epoch(*, previous_epoch: str | None, operation_id: str) -> str:
+    """Derive the stable epoch identity for one fenced operation."""
+    material = f"{previous_epoch or 'root'}\0{operation_id}".encode()
+    return f"epoch-{hashlib.sha256(material).hexdigest()[:20]}"
+
+
+def _event(*, value: object) -> ProgressEvent:
+    if not isinstance(value, dict):
+        raise _type_error(detail="progress event payload is not an object")
+    fields = cast("dict[str, Any]", value)
+    required_result = fields["required_result"]
+    if not isinstance(required_result, dict):
+        raise _type_error(detail="progress event required_result is not an object")
+    event = ProgressEvent(
+        epoch=_string(fields=fields, name="epoch"),
+        previous_epoch=_optional_string(fields=fields, name="previous_epoch"),
+        operation_id=_string(fields=fields, name="operation_id"),
+        event_kind=_string(fields=fields, name="event_kind"),
+        phase=_string(fields=fields, name="phase"),
+        required_result=dict(cast("dict[str, object]", required_result)),
+        result_identity=_string(fields=fields, name="result_identity"),
+        deadline=_string(fields=fields, name="deadline"),
+        max_handoffs=_integer(fields=fields, name="max_handoffs"),
+        started_at=_string(fields=fields, name="started_at"),
+        accepted_handoffs=_integer(fields=fields, name="accepted_handoffs"),
+        handoff_baseline=_integer(fields=fields, name="handoff_baseline"),
+        observation_status=_string(fields=fields, name="observation_status"),
+        observation_evidence=_string(fields=fields, name="observation_evidence"),
+        recovery=_recovery(value=fields.get("recovery")),
+        human_decision=_optional_string(fields=fields, name="human_decision"),
+    )
+    if event.phase not in {"prepared", "committed"}:
+        raise _value_error(detail="progress event phase is not recognized")
+    return event
+
+
+def _recovery(*, value: object) -> CausalRecovery | None:
+    if value is None:
+        return None
+    if not isinstance(value, dict):
+        raise _type_error(detail="progress event recovery is not an object or null")
+    fields = cast("dict[str, Any]", value)
+    return CausalRecovery(
+        required_result=dict(cast("dict[str, object]", fields["required_result"])),
+        previous_epoch=_string(fields=fields, name="previous_epoch"),
+        failure_evidence=_string(fields=fields, name="failure_evidence"),
+        cause=_string(fields=fields, name="cause"),
+        next_operation=_string(fields=fields, name="next_operation"),
+        attempt_id=_string(fields=fields, name="attempt_id"),
+        attempt_deadline=_string(fields=fields, name="attempt_deadline"),
+        claim_receipt=_optional_string(fields=fields, name="claim_receipt"),
+        execution_receipt=_optional_string(fields=fields, name="execution_receipt"),
+        outcome_receipt=_optional_string(fields=fields, name="outcome_receipt"),
+    )
+
+
+def _string(*, fields: dict[str, Any], name: str) -> str:
+    value = fields[name]
+    if not isinstance(value, str):
+        raise _type_error(detail=f"progress event {name} is not a string")
+    return value
+
+
+def _optional_string(*, fields: dict[str, Any], name: str) -> str | None:
+    value = fields.get(name)
+    if value is not None and not isinstance(value, str):
+        raise _type_error(detail=f"progress event {name} is not a string or null")
+    return value
+
+
+def _integer(*, fields: dict[str, Any], name: str) -> int:
+    value = fields[name]
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise _type_error(detail=f"progress event {name} is not an integer")
+    return value
+
+
+def _type_error(*, detail: str) -> TypeError:
+    return TypeError(detail)
+
+
+def _value_error(*, detail: str) -> ValueError:
+    return ValueError(detail)
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_history.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_history.py
