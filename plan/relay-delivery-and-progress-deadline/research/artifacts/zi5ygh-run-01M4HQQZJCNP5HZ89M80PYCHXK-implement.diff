+
+
+def _seed_live_plan(*, project_root: Path, config: StoreConfig, epic_id: str) -> None:
+    slug = epic_id.removeprefix("bd-ib-")
+    (project_root / "plan" / slug).mkdir(parents=True)
+    client = _client(config=config)
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=epic_id,
+            issue_type="epic",
+            title="progress plan",
+            description="## Definition of Done\n\n- The target closes.\n",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"plan_slug": slug, "rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=epic_id, status="active")
+
+
+def _seed_target(*, config: StoreConfig) -> None:
+    client = _client(config=config)
+    _ = client.create_issue(
+        draft=IssueDraft(
+            issue_id=_TARGET,
+            issue_type="feature",
+            title="required result",
+            description="still open",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"rank": "a1"},
+        )
+    )
+    client.update_issue(issue_id=_TARGET, status="ready")
+
+
+def _action(*, plan: Any, budget: Any, text: str) -> Any:
+    return plan.NextAction(
+        kind="impl",
+        ref=_TARGET,
+        text=text,
+        required_result=_RESULT,
+        budget=budget,
+    )
+
+
+def _pointer(*, config: StoreConfig, epic_id: str) -> dict[str, Any]:
+    value = _client(config=config).show_issue(issue_id=epic_id)["metadata"]["next_action"]
+    assert isinstance(value, dict)
+    return dict(cast("dict[str, Any]", value))
+
+
+def _prepared_scenario(
+    *, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> tuple[Any, Path, StoreConfig]:
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    monkeypatch.setenv("LIVESPEC_BEADS_FAKE", "1")
+    reset_fake_singleton()
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    _ = (project_root / ".livespec.jsonc").write_text(
+        '{"livespec-orchestrator-beads-fabro":{"connection":{"prefix":"bd-ib"}}}',
+        encoding="utf-8",
+    )
+    config = _config(project_root=project_root)
+    _seed_live_plan(project_root=project_root, config=config, epic_id=_EPIC)
+    _seed_target(config=config)
+    return plan, project_root, config
+
+
+def _writer_sequence(*, plan: Any, config: StoreConfig) -> tuple[Any, Any, Any, Any]:
+    original = plan.ResultBudget(deadline=_DEADLINE, max_handoffs=2)
+    rewritten = plan.ResultBudget(deadline="2026-10-10T10:00:00Z", max_handoffs=99)
+    first = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=_action(plan=plan, budget=original, text="Close the required target."),
+        session="writer-one",
+        now="2026-10-09T09:00:00Z",
+        operation_id="pointer-one",
+    )
+    second = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=_action(plan=plan, budget=rewritten, text="Reword without resetting the budget."),
+        session="writer-two",
+        now="2026-10-09T09:10:00Z",
+        operation_id="pointer-two",
+        expected_epoch=first.epoch,
+    )
+    ordinary = plan.append_handoff(
+        config=config,
+        epic_id=_EPIC,
+        body="The required target is still open.",
+        author="writer-three",
+        now="2026-10-09T09:20:00Z",
+        next_action=_action(plan=plan, budget=rewritten, text="Keep closing the target."),
+        operation_id="handoff-one",
+        expected_epoch=second.epoch,
+    )
+    supervisor = plan.append_supervisor_handoff(
+        config=config,
+        epic_id=_EPIC,
+        slug="progress-plan",
+        body="The supervisor observed no target change.",
+        now="2026-10-09T09:30:00Z",
+        next_action=_action(plan=plan, budget=rewritten, text="Keep closing the target."),
+        operation_id="handoff-two",
+        expected_epoch=ordinary.epoch,
+    )
+    return first, second, ordinary, supervisor
+
+
+def _assert_count_refusal(*, plan: Any, config: StoreConfig, epoch: str) -> None:
+    rewritten = plan.ResultBudget(deadline="2026-10-10T10:00:00Z", max_handoffs=99)
+    comments = _client(config=config).list_comments(issue_id=_EPIC)
+    pointer = _pointer(config=config, epic_id=_EPIC)
+    with pytest.raises(plan.PlanProgressRefusedError, match="max_handoffs"):
+        plan.append_handoff(
+            config=config,
+            epic_id=_EPIC,
+            body="This handoff must never land.",
+            author="writer-four",
+            now="2026-10-09T09:40:00Z",
+            next_action=_action(plan=plan, budget=rewritten, text="Keep closing the target."),
+            operation_id="handoff-three",
+            expected_epoch=epoch,
+        )
+    assert _client(config=config).list_comments(issue_id=_EPIC) == comments
+    assert _pointer(config=config, epic_id=_EPIC) == pointer
+
+
+def _assert_deadline_refusal(*, plan: Any, project_root: Path, config: StoreConfig) -> None:
+    deadline_epic = f"{_EPIC}-deadline"
+    _seed_live_plan(project_root=project_root, config=config, epic_id=deadline_epic)
+    start = plan.set_next_action(
+        config=config,
+        epic_id=deadline_epic,
+        action=_action(
+            plan=plan,
+            budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=20),
+            text="Close the required target.",
+        ),
+        session="deadline-writer",
+        now="2026-10-09T09:00:00Z",
+        operation_id="deadline-start",
+    )
+    comments = _client(config=config).list_comments(issue_id=deadline_epic)
+    pointer = _pointer(config=config, epic_id=deadline_epic)
+    with pytest.raises(plan.PlanProgressRefusedError, match="deadline"):
+        plan.set_next_action(
+            config=config,
+            epic_id=deadline_epic,
+            action=_action(
+                plan=plan,
+                budget=plan.ResultBudget(deadline="2026-10-10T10:00:00Z", max_handoffs=99),
+                text="Do not reset at the boundary.",
+            ),
+            session="deadline-writer",
+            now=_DEADLINE,
+            operation_id="deadline-boundary",
+            expected_epoch=start.epoch,
+        )
+    assert _client(config=config).list_comments(issue_id=deadline_epic) == comments
+    assert _pointer(config=config, epic_id=deadline_epic) == pointer
+
+
+def _assert_invalid_tracking(*, plan: Any, project_root: Path, config: StoreConfig) -> None:
+    invalid: tuple[tuple[str, dict[str, object] | None, object], ...] = (
+        ("human", _RESULT, plan.ResultBudget(deadline=_DEADLINE, max_handoffs=1)),
+        ("human", None, None),
+        ("surprise", _RESULT, plan.ResultBudget(deadline=_DEADLINE, max_handoffs=1)),
+        (
+            "impl",
+            cast("dict[str, object]", {}),
+            plan.ResultBudget(deadline=_DEADLINE, max_handoffs=1),
+        ),
+        ("impl", _RESULT, None),
+        ("impl", _RESULT, plan.ResultBudget(deadline=_DEADLINE, max_handoffs=0)),
+        ("impl", _RESULT, plan.ResultBudget(deadline="2026-10-09T10:00:00", max_handoffs=1)),
+        ("impl", _RESULT, plan.ResultBudget(deadline="not-a-dateZ", max_handoffs=1)),
+    )
+    for index, (kind, result, budget) in enumerate(invalid):
+        epic_id = f"{_EPIC}-invalid-{index}"
+        _seed_live_plan(project_root=project_root, config=config, epic_id=epic_id)
+        with pytest.raises(plan.PlanProgressRefusedError):
+            plan.set_next_action(
+                config=config,
+                epic_id=epic_id,
+                action=plan.NextAction(
+                    kind=kind, ref=_TARGET, text="invalid", required_result=result, budget=budget
+                ),
+                session="invalid-writer",
+                now="2026-10-09T09:00:00Z",
+                operation_id=f"invalid-{index}",
+            )
+
+
+def _assert_malformed_history(*, config: StoreConfig) -> None:
+    event_module = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_event"
+    )
+    raw = _client(config=config).list_comments(issue_id=_EPIC)[0]["text"]
+    assert isinstance(raw, str)
+    payload = json.loads(raw.split("\n", maxsplit=1)[1])
+    malformed: list[object] = [[], {**payload, "required_result": []}]
+    malformed.extend(
+        {**payload, field: value}
+        for field, value in (
+            ("phase", "unknown"),
+            ("epoch", 1),
+            ("previous_epoch", 1),
+            ("accepted_handoffs", True),
+        )
+    )
+    for value in malformed:
+        text = f"{event_module.PLAN_PROGRESS_EVENT_PREFIX}\n{json.dumps(value)}"
+        with pytest.raises(Exception, match="malformed event"):
+            event_module.parse_progress_events(comments=[{"text": text}])
+    with pytest.raises(Exception, match="malformed event"):
+        event_module.parse_progress_events(comments=[{"text": "plan-progress-event\n{"}])
+
+
+def _assert_epoch_safety(*, plan: Any, project_root: Path, config: StoreConfig) -> None:
+    epic_id = f"{_EPIC}-edges"
+    _seed_live_plan(project_root=project_root, config=config, epic_id=epic_id)
+    action = _action(
+        plan=plan,
+        budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=4),
+        text="Close the target.",
+    )
+    with pytest.raises(plan.PlanProgressRefusedError, match="stale prior epoch"):
+        plan.set_next_action(
+            config=config,
+            epic_id=epic_id,
+            action=action,
+            session="edge-writer",
+            now="2026-10-09T09:00:00Z",
+            operation_id="stale-initial",
+            expected_epoch="missing",
+        )
+    start = plan.set_next_action(
+        config=config,
+        epic_id=epic_id,
+        action=action,
+        session="edge-writer",
+        now="2026-10-09T09:00:00Z",
+        operation_id="edge-start",
+    )
+    with pytest.raises(plan.PlanProgressRefusedError, match="stale prior epoch"):
+        plan.set_next_action(
+            config=config,
+            epic_id=epic_id,
+            action=action,
+            session="edge-writer",
+            now="2026-10-09T09:01:00Z",
+            operation_id="stale-continuation",
+            expected_epoch="missing",
+        )
+    renamed = dict(_RESULT)
+    renamed["item_status"] = {"item_id": "bd-ib-other", "status": "closed"}
+    with pytest.raises(plan.PlanProgressRefusedError, match="replaced or renamed"):
+        plan.set_next_action(
+            config=config,
+            epic_id=epic_id,
+            action=replace(action, required_result=renamed),
+            session="edge-writer",
+            now="2026-10-09T09:02:00Z",
+            operation_id="renamed",
+            expected_epoch=start.epoch,
+        )
+    retry = plan.set_next_action(
+        config=config,
+        epic_id=epic_id,
+        action=action,
+        session="edge-writer",
+        now="2026-10-09T09:00:00Z",
+        operation_id="edge-start",
+    )
+    assert retry.idempotent
+    _client(config=config).update_issue(issue_id=_TARGET, status="closed")
+    advanced = plan.set_next_action(
+        config=config,
+        epic_id=epic_id,
+        action=replace(
+            action, budget=plan.ResultBudget(deadline="2026-10-10T10:00:00Z", max_handoffs=5)
+        ),
+        session="edge-writer",
+        now="2026-10-09T09:03:00Z",
+        operation_id="satisfied-advance",
+        expected_epoch=start.epoch,
+    )
+    assert advanced.deadline == "2026-10-10T10:00:00Z"
+    _client(config=config).update_issue(issue_id=_TARGET, status="ready")
+
+    committed = _client(config=config).list_comments(issue_id=epic_id)[-1]["text"]
+    assert isinstance(committed, str)
+    payload = json.loads(committed.split("\n", maxsplit=1)[1])
+    payload.update({"operation_id": "partial", "phase": "prepared"})
+    _client(config=config).add_comment(
+        issue_id=epic_id, body=f"plan-progress-event\n{json.dumps(payload)}"
+    )
+    for operation_id, suffix in (("other", "unreconciled"), ("partial", "must reconcile")):
+        with pytest.raises(plan.PlanProgressRefusedError, match=suffix):
+            plan.set_next_action(
+                config=config,
+                epic_id=epic_id,
+                action=action,
+                session="edge-writer",
+                now="2026-10-09T09:04:00Z",
+                operation_id=operation_id,
+                expected_epoch=advanced.epoch,
+            )
+    untracked = replace(config, repo_root=None)
+    result = plan.set_next_action(
+        config=untracked,
+        epic_id=epic_id,
+        action=action,
+        session="compatibility-writer",
+        now="2026-10-09T09:05:00Z",
+        operation_id="untracked",
+    )
+    assert result.deadline == _DEADLINE
+
+
+def test_every_writer_retains_the_first_budget_and_refuses_exact_boundaries(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    assert hasattr(plan, "ResultBudget"), "Scenario 147 requires a typed result budget"
+    assert hasattr(plan, "PlanProgressRefusedError")
+    plan, project_root, config = _prepared_scenario(tmp_path=tmp_path, monkeypatch=monkeypatch)
+    first, second, ordinary, supervisor = _writer_sequence(plan=plan, config=config)
+
+    assert [first.accepted_handoffs, second.accepted_handoffs] == [0, 0]
+    assert [ordinary.accepted_handoffs, supervisor.accepted_handoffs] == [1, 2]
+    assert _pointer(config=config, epic_id=_EPIC)["budget"] == {
+        "deadline": _DEADLINE,
+        "max_handoffs": 2,
+    }
+    _assert_count_refusal(plan=plan, config=config, epoch=supervisor.epoch)
+    _assert_deadline_refusal(plan=plan, project_root=project_root, config=config)
+    _assert_invalid_tracking(plan=plan, project_root=project_root, config=config)
+    _assert_malformed_history(config=config)
+    _assert_epoch_safety(plan=plan, project_root=project_root, config=config)
+
+    types = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_progress_types"
+    )
+    for value in (
+        {},
+        {"deadline": 1, "max_handoffs": 1},
+        {"deadline": _DEADLINE, "max_handoffs": True},
+    ):
+        assert types.parse_budget(value=value) is None
+    assert (
+        types.action_metadata(
+            action=plan.NextAction(
+                kind="impl", ref=_TARGET, text="partial", required_result=_RESULT
+            )
+        )["budget"]
+        is None
+    )
+    invalid_pointers: tuple[dict[str, object], ...] = (
+        {"kind": "impl", "ref": _TARGET, "text": "x", "required_result": "bad"},
+        {"kind": "impl", "ref": _TARGET, "text": "x", "budget": {}},
+    )
+    for value in invalid_pointers:
+        assert plan.parse_next_action(value=value) is None
+    parsed = plan.parse_next_action(value=_pointer(config=config, epic_id=_EPIC))
+    assert parsed is not None and parsed.budget is not None
