@@ -0,0 +1,166 @@
+"""Typed plan result budgets, pointer actions, and write outcomes."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, cast
+
+__all__: list[str] = [
+    "PlanProgressRefusedError",
+    "ProgressWrite",
+    "ResultBudget",
+    "TrackedNextAction",
+    "action_metadata",
+    "parse_budget",
+]
+
+
+class PlanProgressRefusedError(Exception):
+    """Expected refusal before a plan-progress mutation."""
+
+    @classmethod
+    def malformed_history(cls) -> PlanProgressRefusedError:
+        return cls("plan progress history contains a malformed event; reconcile it before writing")
+
+    @classmethod
+    def stale(cls, *, expected: str | None, current: str | None) -> PlanProgressRefusedError:
+        return cls(f"stale prior epoch: expected {expected!r}, current is {current!r}")
+
+    @classmethod
+    def renamed_result(cls) -> PlanProgressRefusedError:
+        return cls(
+            "the unmet required result cannot be replaced or renamed without causal recovery"
+        )
+
+    @classmethod
+    def picker_tracking(cls, *, kind: str) -> PlanProgressRefusedError:
+        return cls(f"next_action kind {kind} requires null required_result and budget")
+
+    @classmethod
+    def unknown_kind(cls, *, kind: str) -> PlanProgressRefusedError:
+        return cls(f"next_action kind {kind!r} is not recognized")
+
+    @classmethod
+    def invalid_result(cls, *, detail: str) -> PlanProgressRefusedError:
+        return cls(f"required_result is invalid: {detail}")
+
+    @classmethod
+    def missing_budget(cls) -> PlanProgressRefusedError:
+        return cls("a dispatchable next_action requires a result budget")
+
+    @classmethod
+    def invalid_max_handoffs(cls) -> PlanProgressRefusedError:
+        return cls("budget max_handoffs must be a positive integer")
+
+    @classmethod
+    def expired_handoffs(cls, *, maximum: int) -> PlanProgressRefusedError:
+        return cls(f"required result expired at max_handoffs {maximum}")
+
+    @classmethod
+    def expired_deadline(cls, *, deadline: str) -> PlanProgressRefusedError:
+        return cls(f"required result expired at deadline {deadline}")
+
+    @classmethod
+    def partial(cls, *, operation_id: str, same_operation: bool) -> PlanProgressRefusedError:
+        suffix = " the same operation must reconcile" if same_operation else ""
+        return cls(f"partial plan-progress write {operation_id!r} is unreconciled;{suffix}")
+
+    @classmethod
+    def causal_recovery(cls, *, detail: str) -> PlanProgressRefusedError:
+        return cls(f"causal recovery is invalid: {detail}")
+
+    @classmethod
+    def recovery_not_expired(cls) -> PlanProgressRefusedError:
+        return cls("causal recovery is invalid: the obligation is not expired")
+
+    @classmethod
+    def duplicate_attempt(cls, *, attempt_id: str) -> PlanProgressRefusedError:
+        return cls(f"causal recovery attempt {attempt_id!r} was already recorded")
+
+    @classmethod
+    def human_decision_required(cls) -> PlanProgressRefusedError:
+        return cls("a human next_action requires an actual non-empty human decision")
+
+    @classmethod
+    def unexpected_human_decision(cls) -> PlanProgressRefusedError:
+        return cls("human_decision is only valid for a human next_action")
+
+    @classmethod
+    def utc_required(cls, *, field: str) -> PlanProgressRefusedError:
+        return cls(f"{field} must be an absolute UTC timestamp ending in Z")
+
+    @classmethod
+    def utc_invalid(cls, *, field: str, value: str) -> PlanProgressRefusedError:
+        return cls(f"{field} is not a valid UTC timestamp: {value}")
+
+
+@dataclass(frozen=True, kw_only=True)
+class ResultBudget:
+    """The immutable absolute and accepted-handoff limits of one obligation."""
+
+    deadline: str
+    max_handoffs: int
+
+
+@dataclass(frozen=True, kw_only=True)
+class TrackedNextAction:
+    """The five-field typed pointer stored on an open live plan epic."""
+
+    kind: str
+    ref: str
+    text: str
+    required_result: dict[str, object] | None = None
+    budget: ResultBudget | None = None
+
+
+@dataclass(frozen=True, kw_only=True)
+class ProgressWrite:
+    """The durable epoch one sanctioned pointer write committed."""
+
+    epoch: str
+    operation_id: str
+    deadline: str | None
+    max_handoffs: int | None
+    accepted_handoffs: int
+    idempotent: bool = False
+
+
+def action_metadata(
+    *, action: TrackedNextAction, include_null_tracking: bool = False
+) -> dict[str, object]:
+    """Render a tracked five-field pointer or an unchanged legacy pointer."""
+    if action.required_result is None and action.budget is None and not include_null_tracking:
+        return {
+            "kind": action.kind,
+            "ref": action.ref,
+            "text": action.text,
+        }
+    budget: dict[str, object] | None = None
+    if action.budget is not None:
+        budget = {
+            "deadline": action.budget.deadline,
+            "max_handoffs": action.budget.max_handoffs,
+        }
+    return {
+        "kind": action.kind,
+        "ref": action.ref,
+        "text": action.text,
+        "required_result": action.required_result,
+        "budget": budget,
+    }
+
+
+def parse_budget(*, value: object) -> ResultBudget | None:
+    """Read the fixed two-field budget shape, or None when missing or malformed."""
+    if not isinstance(value, dict):
+        return None
+    fields = cast("dict[str, Any]", value)
+    if set(fields) != {"deadline", "max_handoffs"}:
+        return None
+    deadline = fields.get("deadline")
+    max_handoffs = fields.get("max_handoffs")
+    if not isinstance(deadline, str):
+        return None
+    if not isinstance(max_handoffs, int) or isinstance(max_handoffs, bool):
+        return None
+    return ResultBudget(deadline=deadline, max_handoffs=max_handoffs)
