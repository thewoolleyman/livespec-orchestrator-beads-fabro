@@ -0,0 +1,73 @@
+"""Validation and exact expiry boundaries for tracked plan result budgets."""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import ProgressEvent
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    PlanProgressRefusedError,
+    ResultBudget,
+    TrackedNextAction,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_reference import (
+    parse_result_reference,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_targets import (
+    ResultReference,
+)
+
+__all__: list[str] = [
+    "deadline_reached",
+    "progress_expiry",
+    "raise_expired_progress",
+    "validate_action_tracking",
+]
+
+_DISPATCHABLE_KINDS = frozenset({"impl", "spec-op"})
+
+
+def validate_action_tracking(*, action: TrackedNextAction) -> tuple[ResultReference, ResultBudget]:
+    """Return a valid dispatchable result and budget or refuse the pointer."""
+    if action.kind not in _DISPATCHABLE_KINDS:
+        raise PlanProgressRefusedError.unknown_kind(kind=action.kind)
+    parsed = parse_result_reference(value=action.required_result)
+    if not isinstance(parsed, ResultReference):
+        raise PlanProgressRefusedError.invalid_result(detail=parsed.detail)
+    budget = action.budget
+    if budget is None:
+        raise PlanProgressRefusedError.missing_budget()
+    if budget.max_handoffs <= 0:
+        raise PlanProgressRefusedError.invalid_max_handoffs()
+    _ = _utc(value=budget.deadline, field="budget deadline")
+    return parsed, budget
+
+
+def deadline_reached(*, now: str, deadline: str) -> bool:
+    """Whether an absolute UTC deadline is reached, including exact equality."""
+    return _utc(value=now, field="current time") >= _utc(value=deadline, field="deadline")
+
+
+def progress_expiry(*, current: ProgressEvent, now: str) -> str | None:
+    """Return the first reached immutable limit, including its exact boundary."""
+    if current.accepted_handoffs >= current.max_handoffs:
+        return "handoffs"
+    if deadline_reached(now=now, deadline=current.deadline):
+        return "deadline"
+    return None
+
+
+def raise_expired_progress(*, current: ProgressEvent, expiry: str) -> None:
+    """Raise the typed refusal for a previously measured expiry kind."""
+    if expiry == "handoffs":
+        raise PlanProgressRefusedError.expired_handoffs(maximum=current.max_handoffs)
+    raise PlanProgressRefusedError.expired_deadline(deadline=current.deadline)
+
+
+def _utc(*, value: str, field: str) -> datetime:
+    if not value.endswith("Z"):
+        raise PlanProgressRefusedError.utc_required(field=field)
+    try:
+        return datetime.fromisoformat(value.removesuffix("Z") + "+00:00")
+    except ValueError as error:
+        raise PlanProgressRefusedError.utc_invalid(field=field, value=value) from error
diff --git a/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_operation.py b/.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_plan_progress_operation.py
