+    parse_next_action,
+    record_metadata,
+    set_next_action,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_event import (
+    PLAN_PROGRESS_EVENT_PREFIX,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_resume import (
+    ResumeProgressDecision,
+    evaluate_resume_progress,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_progress_storage import is_live_plan
+
+if TYPE_CHECKING:
+    from livespec_orchestrator_beads_fabro._beads_client import BeadsRecord
+    from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+__all__: list[str] = ["resume_directive"]
+
+_DISPATCHABLE_KINDS: tuple[str, ...] = ("impl", "spec-op")
+_DESCRIPTION_FIELD = "description"
+
+
+def resume_directive(
+    *, config: StoreConfig, epic_id: str, unattended: bool, now: str | None = None
+) -> ResumeDirective:
+    """Decide whether this resume asks which action to take, or just takes it.
+
+    The epic is read ONCE and both questions are answered from that record — the
+    typed pointer and whether the plan carries its Definition of Done. A second
+    read could not be proven to agree with the first, and the disagreement would
+    be invisible because both reads produce a well-formed epic.
+    """
+    client = make_beads_client(config=config)
+    record = client.show_issue(issue_id=epic_id)
+    pointer = record_metadata(record=record).get(NEXT_ACTION_METADATA_KEY)
+    action = parse_next_action(value=pointer)
+    resolved_now = utc_now_iso() if now is None else now
+    progress = _resume_progress(
+        config=config,
+        epic_id=epic_id,
+        record=record,
+        action=action,
+        pointer=pointer,
+        now=resolved_now,
+        comments=client.list_comments(issue_id=epic_id),
+    )
+    findings = (*_definition_of_done_findings(record=record, epic_id=epic_id), *progress.findings)
+    if not unattended:
+        return ResumeDirective(
+            ask=True, next_action=None, reason="interactive resume", findings=findings
+        )
+    if progress.reason is not None:
+        return ResumeDirective(
+            ask=progress.next_action is None,
+            next_action=progress.next_action,
+            reason=progress.reason,
+            findings=findings,
+        )
+    if findings and not _is_impl(action=action) and not _is_human(action=action):
+        return _gap_directive(
+            config=config,
+            epic_id=epic_id,
+            findings=findings,
+            now=resolved_now,
+        )
+    if action is None:
+        return ResumeDirective(
+            ask=True,
+            next_action=None,
+            reason=f"epic {epic_id} carries no typed next_action",
+            findings=findings,
+        )
+    identifier = dispatchable_action_id(action=action)
+    if identifier is None:
+        return ResumeDirective(
+            ask=True,
+            next_action=None,
+            reason=_picker_reason(action=action),
+            findings=findings,
+        )
+    return ResumeDirective(
+        ask=False,
+        next_action=identifier,
+        reason="unattended resume takes the typed next_action",
+        findings=findings,
+    )
+
+
+def _resume_progress(  # noqa: PLR0913 -- one read supplies every progress authority fact.
+    *,
+    config: StoreConfig,
+    epic_id: str,
+    record: BeadsRecord,
+    action: NextAction | None,
+    pointer: object,
+    now: str,
+    comments: list[dict[str, Any]],
+) -> ResumeProgressDecision:
+    if action is None or not is_live_plan(config=config, record=record):
+        return ResumeProgressDecision()
+    if _legacy_pointer(pointer=cast("dict[str, Any]", pointer)):
+        return ResumeProgressDecision(findings=("plan-progress-tracking: missing",))
+    tracked = action.required_result is not None and action.budget is not None
+    has_history = any(
+        isinstance(comment.get("text"), str)
+        and cast("str", comment["text"]).startswith(f"{PLAN_PROGRESS_EVENT_PREFIX}\n")
+        for comment in comments
+    )
+    if not tracked and not has_history:
+        return ResumeProgressDecision()
+    decision = evaluate_resume_progress(
+        config=config,
+        epic_id=epic_id,
+        action=action,
+        comments=comments,
+        now=now,
+    )
+    if tracked:
+        return decision
+    return ResumeProgressDecision(findings=decision.findings)
+
+
+def _legacy_pointer(*, pointer: dict[str, Any]) -> bool:
+    return "required_result" not in pointer or "budget" not in pointer
+
+
+def _is_impl(*, action: NextAction | None) -> bool:
+    """Whether the existing pointer is the one the gap must NOT overwrite.
+
+    `impl` ALONE, as the clause words it. A `spec-op` pointer is dispatchable and
+    is still replaced, because a plan that has not said what done means has
+    nothing for a spec operation to ratify toward — whereas an `impl` pointer
+    names work already filed, groomed and admitted, and overwriting it would
+    strand a live dispatch behind a question nobody is present to answer.
+    """
+    return action is not None and action.kind == IMPL_KIND
+
+
+def _is_human(*, action: NextAction | None) -> bool:
+    """Whether the existing pointer already raises the required picker."""
+    return action is not None and action.kind == HUMAN_KIND
+
+
+def _definition_of_done_findings(*, record: BeadsRecord, epic_id: str) -> tuple[str, ...]:
+    description = record.get(_DESCRIPTION_FIELD)
+    text = description if isinstance(description, str) else ""
+    if plan_definition_of_done(description=text).present:
+        return ()
+    return (missing_section_finding(epic_id=epic_id),)
+
+
+def _gap_directive(
+    *, config: StoreConfig, epic_id: str, findings: tuple[str, ...], now: str
+) -> ResumeDirective:
+    """Point the plan at a human and report why, without authoring assertions."""
+    _ = set_next_action(
+        config=config,
+        epic_id=epic_id,
+        action=NextAction(kind=HUMAN_KIND, ref="", text=missing_section_gap_text()),
+        session=PLAN_RESUME_ACTOR,
+        now=now,
+        human_decision="Maintainer-authored Definition of Done assertions are required.",
+    )
+    return ResumeDirective(
+        ask=True,
+        next_action=None,
+        reason=f"epic {epic_id} carries no plan Definition of Done section",
+        findings=findings,
+    )
+
+
+def _picker_reason(*, action: NextAction) -> str:
+    if action.kind in _DISPATCHABLE_KINDS:
+        return f"next_action kind {action.kind} carries an empty ref"
+    return f"next_action kind {action.kind} raises the picker"
