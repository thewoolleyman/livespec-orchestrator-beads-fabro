+def test_unattended_resume_withholds_expired_or_unobservable_dispatch_and_exposes_recovery(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    assert (
+        "now" in inspect.signature(plan.resume_directive).parameters
+    ), "Scenario 148 requires a deterministic progress boundary"
+    monkeypatch.setenv("LIVESPEC_BEADS_FAKE", "1")
+    reset_fake_singleton()
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    config = _config(project_root=project_root)
+    _seed(project_root=project_root, config=config)
+    start = _start(plan=plan, config=config)
+    observation = importlib.import_module(
+        "livespec_orchestrator_beads_fabro.commands._plan_result_observation"
+    )
+    _assert_observable_progress_continues(
+        plan=plan, config=config, observation=observation, monkeypatch=monkeypatch
+    )
+    _assert_expired(plan=plan, config=config, observation=observation, monkeypatch=monkeypatch)
+    _assert_unobservable(plan=plan, config=config, observation=observation, monkeypatch=monkeypatch)
+    _assert_missing_history(plan=plan, project_root=project_root, config=config)
+    _assert_bounded_recovery(
+        plan=plan,
+        config=config,
+        observation=observation,
+        monkeypatch=monkeypatch,
+        start_epoch=start.epoch,
+    )
