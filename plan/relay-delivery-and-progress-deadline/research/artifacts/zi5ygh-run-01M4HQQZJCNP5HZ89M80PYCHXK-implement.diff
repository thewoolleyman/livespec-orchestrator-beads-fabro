@@ -0,0 +1,111 @@
+"""Typed causal recovery for one expired plan result obligation."""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import datetime
+
+from livespec_orchestrator_beads_fabro.commands._plan_progress_types import (
+    PlanProgressRefusedError,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_reference import (
+    parse_result_reference,
+)
+from livespec_orchestrator_beads_fabro.commands._plan_result_targets import (
+    ResultReference,
+)
+
+__all__: list[str] = [
+    "CausalRecovery",
+    "validate_causal_recovery",
+]
+
+_CAUSES = frozenset({"host", "item", "unknown"})
+_WORK_ITEM_ID = r"[a-z][a-z0-9]*(?:-[a-z0-9]+)+(?:\.\d+)?"
+_SPEC_TOPIC = r"[a-z0-9]+(?:-[a-z0-9]+)*"
+_IMPL_OPERATION = rf"impl:{_WORK_ITEM_ID}"
+_DIAGNOSIS_OPERATION = rf"diagnose-plan-progress:{_WORK_ITEM_ID}"
+_SPEC_OPERATION = rf"(?:propose-change|revise|critique|prune-history):{_SPEC_TOPIC}"
+_EXECUTABLE_OPERATION = re.compile(
+    "|".join(
+        (
+            _IMPL_OPERATION,
+            _DIAGNOSIS_OPERATION,
+            _SPEC_OPERATION,
+        )
+    )
+)
+
+
+@dataclass(frozen=True, kw_only=True)
+class CausalRecovery:
+    """Evidence and authority for exactly one bounded recovery attempt."""
+
+    required_result: dict[str, object]
+    previous_epoch: str
+    failure_evidence: str
+    cause: str
+    next_operation: str
+    attempt_id: str
+    attempt_deadline: str
+    claim_receipt: str | None = None
+    execution_receipt: str | None = None
+    outcome_receipt: str | None = None
+
+
+def validate_causal_recovery(
+    *,
+    recovery: CausalRecovery,
+    current_epoch: str,
+    current_result_identity: str,
+    now: str,
+    authorized_operation: str,
+) -> None:
+    """Refuse anything other than a fresh, causal, executable attempt."""
+    parsed = parse_result_reference(value=recovery.required_result)
+    invalid_result = not isinstance(parsed, ResultReference)
+    if invalid_result or parsed.identity != current_result_identity:
+        raise PlanProgressRefusedError.causal_recovery(detail="required result changed")
+    if recovery.previous_epoch != current_epoch:
+        raise PlanProgressRefusedError.causal_recovery(detail="previous epoch is stale")
+    if not recovery.failure_evidence.strip():
+        raise PlanProgressRefusedError.causal_recovery(detail="failure evidence is empty")
+    if recovery.cause not in _CAUSES:
+        raise PlanProgressRefusedError.causal_recovery(detail="cause is not recognized")
+    if not recovery.next_operation.strip():
+        raise PlanProgressRefusedError.causal_recovery(detail="next operation is empty")
+    if (
+        _EXECUTABLE_OPERATION.fullmatch(recovery.next_operation) is None
+        or recovery.next_operation != authorized_operation
+    ):
+        raise PlanProgressRefusedError.causal_recovery(
+            detail="next operation is not an executable authorized operation"
+        )
+    if not recovery.attempt_id.strip():
+        raise PlanProgressRefusedError.causal_recovery(detail="attempt id is empty")
+    deadline = _utc(value=recovery.attempt_deadline)
+    if deadline <= _utc(value=now):
+        raise PlanProgressRefusedError.causal_recovery(detail="attempt deadline is not future")
+    receipts = (
+        recovery.claim_receipt,
+        recovery.execution_receipt,
+        recovery.outcome_receipt,
+    )
+    if receipts != (None, None, None):
+        raise PlanProgressRefusedError.causal_recovery(
+            detail="a fresh attempt cannot assert claim, execution, or outcome receipts"
+        )
+
+
+def _utc(*, value: str) -> datetime:
+    if not value.endswith("Z"):
+        raise PlanProgressRefusedError.causal_recovery(
+            detail="attempt deadline must be an absolute UTC timestamp"
+        )
+    try:
+        return datetime.fromisoformat(value.removesuffix("Z") + "+00:00")
+    except ValueError as error:
+        raise PlanProgressRefusedError.causal_recovery(
+            detail=f"attempt deadline is invalid: {value}"
+        ) from error
