+"""Scenario 148: legacy pointers read safely and upgrade on sanctioned writes."""
+
+from __future__ import annotations
+
+import importlib
+import json
+from pathlib import Path
+from typing import Any, cast
+
+import pytest
+from livespec_orchestrator_beads_fabro._beads_client import (
+    FakeBeadsClient,
+    IssueDraft,
+    make_beads_client,
+    reset_fake_singleton,
+)
+from livespec_orchestrator_beads_fabro.types import StoreConfig
+
+_REPO = "livespec-orchestrator-beads-fabro"
+_EPIC = "bd-ib-legacy-plan"
+_NONE_EPIC = "bd-ib-none-plan"
+_NONE_HANDOFF_EPIC = "bd-ib-none-handoff-plan"
+_TARGET = "bd-ib-legacy-target"
+_DEADLINE = "2026-10-09T12:00:00Z"
+_RESULT: dict[str, object] = {
+    "repo": _REPO,
+    "item_status": {"item_id": _TARGET, "status": "closed"},
+}
+
+
+def _config(*, project_root: Path) -> StoreConfig:
+    return StoreConfig(
+        tenant=_REPO,
+        prefix="bd-ib",
+        server_user=_REPO,
+        database=_REPO,
+        bd_path="bd",
+        fake=True,
+        repo_root=project_root,
+    )
+
+
+def _client(*, config: StoreConfig) -> FakeBeadsClient:
+    client = make_beads_client(config=config)
+    assert isinstance(client, FakeBeadsClient)
+    return client
+
+
+def _seed_epic(
+    *, project_root: Path, config: StoreConfig, epic_id: str, slug: str, metadata: dict[str, Any]
+) -> None:
+    (project_root / "plan" / slug).mkdir(parents=True)
+    _ = _client(config=config).create_issue(
+        draft=IssueDraft(
+            issue_id=epic_id,
+            issue_type="epic",
+            title=slug,
+            description="## Definition of Done\n\n- The target closes.\n",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"plan_slug": slug, "rank": "a1", **metadata},
+        )
+    )
+    _client(config=config).update_issue(issue_id=epic_id, status="active")
+
+
+def _seed(*, project_root: Path, config: StoreConfig) -> None:
+    _seed_epic(
+        project_root=project_root,
+        config=config,
+        epic_id=_EPIC,
+        slug="legacy-plan",
+        metadata={
+            "next_action": {
+                "kind": "impl",
+                "ref": _TARGET,
+                "text": "Close the legacy target.",
+            },
+            "last_session": "legacy-writer at 2026-10-09T09:00:00Z",
+        },
+    )
+    _seed_epic(
+        project_root=project_root,
+        config=config,
+        epic_id=_NONE_EPIC,
+        slug="none-plan",
+        metadata={},
+    )
+    _seed_epic(
+        project_root=project_root,
+        config=config,
+        epic_id=_NONE_HANDOFF_EPIC,
+        slug="none-handoff-plan",
+        metadata={},
+    )
+    _ = _client(config=config).create_issue(
+        draft=IssueDraft(
+            issue_id=_TARGET,
+            issue_type="feature",
+            title="required result",
+            description="still open",
+            assignee=None,
+            created_at="2026-10-09T08:00:00Z",
+            metadata={"rank": "a1"},
+        )
+    )
+    _client(config=config).update_issue(issue_id=_TARGET, status="ready")
+
+
+def _metadata(*, config: StoreConfig, epic_id: str) -> dict[str, Any]:
+    value = _client(config=config).show_issue(issue_id=epic_id)["metadata"]
+    assert isinstance(value, dict)
+    return dict(cast("dict[str, Any]", value))
+
+
+def _comments(*, config: StoreConfig, epic_id: str) -> list[dict[str, Any]]:
+    return _client(config=config).list_comments(issue_id=epic_id)
+
+
+def _tracked_action(*, plan: Any) -> Any:
+    return plan.NextAction(
+        kind="impl",
+        ref=_TARGET,
+        text="Close the typed target.",
+        required_result=_RESULT,
+        budget=plan.ResultBudget(deadline=_DEADLINE, max_handoffs=3),
+    )
+
+
+def _assert_legacy_read_only(*, plan: Any, config: StoreConfig) -> Any:
+    before_metadata = _metadata(config=config, epic_id=_EPIC)
+    before_comments = _comments(config=config, epic_id=_EPIC)
+    legacy = plan.parse_next_action(value=before_metadata["next_action"])
+    assert legacy == plan.NextAction(
+        kind="impl",
+        ref=_TARGET,
+        text="Close the legacy target.",
+    )
+    directive = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now="2026-10-09T09:30:00Z",
+    )
+    assert not directive.ask
+    assert directive.next_action == f"impl:{_TARGET}"
+    assert directive.findings == ("plan-progress-tracking: missing",)
+    assert _metadata(config=config, epic_id=_EPIC) == before_metadata
+    assert _comments(config=config, epic_id=_EPIC) == before_comments
+    return legacy
+
+
+def _assert_upgrade(*, plan: Any, config: StoreConfig, legacy: Any) -> Any:
+    before_metadata = _metadata(config=config, epic_id=_EPIC)
+    with pytest.raises(plan.PlanProgressRefusedError):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=legacy,
+            session="legacy-writer",
+            now="2026-10-09T09:31:00Z",
+            operation_id="legacy-without-tracking",
+        )
+    assert _metadata(config=config, epic_id=_EPIC) == before_metadata
+    upgraded = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=_tracked_action(plan=plan),
+        session="legacy-writer",
+        now="2026-10-09T09:32:00Z",
+        operation_id="legacy-upgrade",
+    )
+    pointer = _metadata(config=config, epic_id=_EPIC)["next_action"]
+    assert isinstance(pointer, dict)
+    assert set(pointer) == {"kind", "ref", "text", "required_result", "budget"}
+    assert pointer["required_result"] == _RESULT
+    assert pointer["budget"] == {"deadline": _DEADLINE, "max_handoffs": 3}
+    return upgraded
+
+
+def _assert_human_decision_retains_obligation(
+    *, plan: Any, config: StoreConfig, epoch: str
+) -> None:
+    comments = _comments(config=config, epic_id=_EPIC)
+    with pytest.raises(plan.PlanProgressRefusedError, match="human decision"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=plan.NextAction(kind="human", ref="", text="Approve the deployment."),
+            session="legacy-writer",
+            now="2026-10-09T09:33:00Z",
+            operation_id="invented-human",
+            expected_epoch=epoch,
+        )
+    with pytest.raises(plan.PlanProgressRefusedError, match="stale prior epoch"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=plan.NextAction(kind="human", ref="", text="Approve the deployment."),
+            session="legacy-writer",
+            now="2026-10-09T09:33:00Z",
+            human_decision="Maintainer authorization is required.",
+            operation_id="stale-human-decision",
+            expected_epoch="epoch-stale",
+        )
+    with pytest.raises(plan.PlanProgressRefusedError, match="only valid for a human"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=_tracked_action(plan=plan),
+            session="legacy-writer",
+            now="2026-10-09T09:33:00Z",
+            human_decision="not a human pointer",
+            operation_id="misplaced-human-decision",
+            expected_epoch=epoch,
+        )
+    recovery = plan.CausalRecovery(
+        required_result=_RESULT,
+        previous_epoch=epoch,
+        failure_evidence="The required item is still ready.",
+        cause="unknown",
+        next_operation=f"diagnose-plan-progress:{_EPIC}",
+        attempt_id="picker-recovery",
+        attempt_deadline="2026-10-09T10:00:00Z",
+    )
+    with pytest.raises(plan.PlanProgressRefusedError, match="dispatchable next_action"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=plan.NextAction(kind="human", ref="", text="Approve the deployment."),
+            session="legacy-writer",
+            now="2026-10-09T09:33:00Z",
+            human_decision="Maintainer authorization is required.",
+            operation_id="human-with-recovery",
+            expected_epoch=epoch,
+            recovery=recovery,
+        )
+    assert _comments(config=config, epic_id=_EPIC) == comments
+    continued_epoch = _assert_none_continuation_boundaries(
+        plan=plan,
+        config=config,
+        epoch=epoch,
+    )
+    decided = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=plan.NextAction(kind="human", ref="", text="Approve the deployment."),
+        session="legacy-writer",
+        now=_DEADLINE,
+        human_decision="Maintainer authorization is required before deployment.",
+        operation_id="real-human-decision",
+        expected_epoch=continued_epoch,
+    )
+    pointer = _metadata(config=config, epic_id=_EPIC)["next_action"]
+    assert pointer == {
+        "kind": "human",
+        "ref": "",
+        "text": "Approve the deployment.",
+        "required_result": None,
+        "budget": None,
+    }
+    raw = _comments(config=config, epic_id=_EPIC)[-1]["text"]
+    assert isinstance(raw, str)
+    event = json.loads(raw.split("\n", maxsplit=1)[1])
+    assert event["event_kind"] == "human-decision"
+    assert event["required_result"] == _RESULT
+    assert event["deadline"] == _DEADLINE
+    assert event["human_decision"] == ("Maintainer authorization is required before deployment.")
+    assert decided.deadline == _DEADLINE
+    directive = plan.resume_directive(
+        config=config,
+        epic_id=_EPIC,
+        unattended=True,
+        now="2026-10-09T09:35:00Z",
+    )
+    assert directive.ask
+    assert directive.next_action is None
+    assert directive.reason == "next_action kind human raises the picker"
+    assert directive.findings[0].startswith("plan-progress-tracking: unobservable;")
+
+
+def _assert_none_continuation_boundaries(*, plan: Any, config: StoreConfig, epoch: str) -> str:
+    none = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=plan.NextAction(kind="none", ref="", text="No action while the result remains."),
+        session="legacy-writer",
+        now="2026-10-09T09:33:00Z",
+        operation_id="none-before-expiry",
+        expected_epoch=epoch,
+    )
+    _client(config=config).update_issue(issue_id=_TARGET, status="closed")
+    satisfied_none = plan.set_next_action(
+        config=config,
+        epic_id=_EPIC,
+        action=plan.NextAction(kind="none", ref="", text="The result is currently satisfied."),
+        session="legacy-writer",
+        now="2026-10-09T09:33:30Z",
+        operation_id="none-after-satisfaction",
+        expected_epoch=none.epoch,
+    )
+    _client(config=config).update_issue(issue_id=_TARGET, status="ready")
+    with pytest.raises(plan.PlanProgressRefusedError, match="expired at deadline"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_EPIC,
+            action=plan.NextAction(kind="none", ref="", text="Cannot hide expiry."),
+            session="legacy-writer",
+            now=_DEADLINE,
+            operation_id="none-at-expiry",
+            expected_epoch=satisfied_none.epoch,
+        )
+    return satisfied_none.epoch
+
+
+def _assert_none_pointer_uses_explicit_nulls(*, plan: Any, config: StoreConfig) -> None:
+    with pytest.raises(plan.PlanProgressRefusedError, match="stale prior epoch"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_NONE_EPIC,
+            action=plan.NextAction(kind="none", ref="", text="No next action."),
+            session="none-writer",
+            now="2026-10-09T09:35:00Z",
+            operation_id="stale-none-pointer",
+            expected_epoch="epoch-missing",
+        )
+    with pytest.raises(plan.PlanProgressRefusedError, match="only valid for a human"):
+        plan.set_next_action(
+            config=config,
+            epic_id=_NONE_EPIC,
+            action=plan.NextAction(kind="none", ref="", text="No next action."),
+            session="none-writer",
+            now="2026-10-09T09:35:00Z",
+            human_decision="There is no human decision.",
+            operation_id="misplaced-none-decision",
+        )
+    result = plan.set_next_action(
+        config=config,
+        epic_id=_NONE_EPIC,
+        action=plan.NextAction(kind="none", ref="", text="No next action is currently required."),
+        session="none-writer",
+        now="2026-10-09T09:35:00Z",
+        operation_id="none-pointer",
+    )
+    pointer = _metadata(config=config, epic_id=_NONE_EPIC)["next_action"]
+    assert pointer == {
+        "kind": "none",
+        "ref": "",
+        "text": "No next action is currently required.",
+        "required_result": None,
+        "budget": None,
+    }
+    assert result.epoch == ""
+    assert _comments(config=config, epic_id=_NONE_EPIC) == []
+    directive = plan.resume_directive(
+        config=config,
+        epic_id=_NONE_EPIC,
+        unattended=True,
+        now="2026-10-09T09:36:00Z",
+    )
+    assert directive.findings == ()
+
+    handoff = plan.append_handoff(
+        config=config,
+        epic_id=_NONE_HANDOFF_EPIC,
+        body="No result obligation has started.",
+        author="none-writer",
+        now="2026-10-09T09:36:00Z",
+        next_action=plan.NextAction(kind="none", ref="", text="No next action."),
+        operation_id="none-handoff",
+    )
+    assert handoff.epoch == ""
+    assert _comments(config=config, epic_id=_NONE_HANDOFF_EPIC)[0]["text"].startswith(
+        "plan-handoff-entry\n"
+    )
+
+
+def test_legacy_pointer_read_and_next_sanctioned_write_supply_tracking(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("LIVESPEC_BEADS_FAKE", "1")
+    reset_fake_singleton()
+    project_root = tmp_path / _REPO
+    project_root.mkdir()
+    config = _config(project_root=project_root)
+    _seed(project_root=project_root, config=config)
+    plan = importlib.import_module("livespec_orchestrator_beads_fabro.commands.plan")
+    legacy = _assert_legacy_read_only(plan=plan, config=config)
+    upgraded = _assert_upgrade(plan=plan, config=config, legacy=legacy)
+    _assert_human_decision_retains_obligation(
+        plan=plan,
+        config=config,
+        epoch=upgraded.epoch,
+    )
+    _assert_none_pointer_uses_explicit_nulls(plan=plan, config=config)
