+            request=_request(config=config, journal_path=journal, attempt_id="attempt-0002")
+        )
+    )
+
+    assert "attempt-0002" in refusal.detail
+    assert _ATTEMPT_ID in refusal.detail
+    assert _recorded_receipts(config=config) == ReceiptSet()
