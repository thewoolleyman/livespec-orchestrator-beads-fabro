+def _seed(*, tmp_path: Path, authority: AuthorityState | None = None) -> StoreConfig:
+    """A tenant holding one plan epic whose chain records one recovery attempt."""
+    repo = tmp_path / _PROJECT_NAME
+    repo.mkdir()
