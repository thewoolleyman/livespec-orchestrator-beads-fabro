+        request=TransitionRequest(
+            operation_id=f"seed-{head.epoch}",
+            observed_head=head,
+            authority=authority,
+            event_kind="recovery",
+            author="seed-session",
+            now=_NOW,
+        ),
+    )
+    assert isinstance(committed, CommittedTransition)
