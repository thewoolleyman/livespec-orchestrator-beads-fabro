+def _journal(*, tmp_path: Path, records: tuple[dict[str, Any], ...]) -> Path:
+    path = tmp_path / "dispatcher-journal.jsonl"
+    _ = path.write_text(
+        "".join(f"{json.dumps(record, sort_keys=True)}\n" for record in records),
+        encoding="utf-8",
