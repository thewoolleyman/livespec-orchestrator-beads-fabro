/usr/local/bin/with-homelab-aws.sh
--role
homelab-workload
/home/ubuntu/.nix-profile/bin/hl
param
run
--bind
BEADS_DOLT_PASSWORD=/homelab/v1/services/dolt/production/beads-password
--bind
GITHUB_APP_ID=/homelab/v1/providers/github/mi-homelab-factory-bot/app-id
--bind
GITHUB_PRIVATE_KEY=/homelab/v1/providers/github/mi-homelab-factory-bot/private-key
--bind
CLAUDE_CODE_OAUTH_TOKEN=/homelab/v1/providers/anthropic/claude-code/oauth-token
--
