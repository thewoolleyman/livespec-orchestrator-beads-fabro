// Project-local livespec configuration for livespec-orchestrator-beads-fabro.
// This plugin dogfoods livespec: the SPECIFICATION/ tree at the repo
// root is the live spec; this plugin's own impl tracking lives in a
// per-repo beads TENANT DATABASE on the shared dolt-server (NOT in JSONL
// files at the repo root — that is the plaintext sibling's substrate).
//
// Authority:
//   livespec/SPECIFICATION/contracts.md
//     §"Cross-repo coordination — pin-and-bump"
//     §"`compat` block" (the schema this file populates)
//   dev-tooling/implementation/research/beads-schema-mapping.md
//     §2.1 (the verified v1.0.5 server-mode FLAGS connection model)
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Maintainer opt-in 2026-08-21: the foreman may convene the cross-vendor
  // consensus panel on a blocked session and act on its typed verdict through
  // foreman-act, instead of only surfacing it. Absent (or unrecognized) this
  // key resolves to the fail-closed default "report-only". The contract floors
  // are NOT relaxed by this setting: the foreman still escalates and does not
  // act on panel dissent, any insufficient-information verdict, a decision that
  // is human-gated by design, or a failed audit-journal append. Brings this repo
  // in line with livespec-overseer, livespec-console-beads-fabro and
  // livespec-dev-tooling, which already carry this value.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  "codex_full_access": {
    "fleet_listed": true
  },
  // Fleet-default credential-injection wrapper (argv-form command prefix). The
  // bin/*.py credential self-heal (bin/_bootstrap.py) re-execs the process
  // through this prefix when BEADS_DOLT_PASSWORD is absent, so the 1Password
  // Environment wrapper injects the shared fleet tenant secret before any beads
  // CLI runs. Backend-agnostic per livespec core's config schema (a non-empty
  // array of strings); the secret backend + injected vars are this project's
  // own concern and are NEVER committed here.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "harnesses": {
    "claude": { "status": "supported", "canonical_command": "livespec-orchestrator-beads-fabro:next" },
    "codex":  { "status": "supported", "canonical_command": "livespec-orchestrator-beads-fabro:next" }
  },
  // ACTIVE spec_governance overrides. Maintainer-directed fleet-wide autonomy
  // lever rollout (epic livespec-jvdvx4, child livespec-jvdvx4.15): these
  // levers were shipped in livespec core (Increments 1-2) but never armed
  // here. The levers still at their safe defaults are enumerated in the
  // commented reference block below, which carries their unarmed shape;
  // `dispatcher.merge_on_review_cap` is likewise left at its safe default
  // in the `dispatcher` block further down, not here.
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    // ratification_review: "auto-spawn" is inert without a configured
    // reviewer model (effective.py's effective_ratification_review returns
    // requires_input=True when ratification_reviewer_model is None) — set
    // to "sonnet" (livespec core's own convention uses "fable", but that
    // model was returning 529 Overloaded server-side errors when this was
    // set, per maintainer direction 2026-08-24).
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": "sonnet",
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: the three levers this repo has NOT armed.
  // Left commented at their safe defaults deliberately:
  //   doctor_dispositions: unmapped check_ids still escalate to a human —
  //     population is deferred to a dedicated follow-up (per-check_id
  //     judgment call, not a mechanical rollout).
  //   drift_acceptance_mode: the only non-human value (consensus) is inert,
  //     pending the not-yet-built Increment-3 cross-vendor panel.
  //   ratification_min_review_age_seconds: the shipped default of 1 second
  //     imposes no practical floor, so there is nothing to override.
  //   "spec_governance": {
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1
  //   }
  //
  // Cross-spec citation allowlist for doctor's no-cross-spec-reference
  // invariant. contracts.md §"pi skill surface" cites livespec core's
  // Driver-shipped-hooks and Plugin-distribution contracts by section
  // rather than restating them — restating a sibling-owned contract here
  // is exactly what the no-cross-spec-reference rule exists to prevent.
  "external_references": {
    "livespec": [
      "SPECIFICATION/contracts.md §\"Driver-shipped hooks\"",
      "SPECIFICATION/contracts.md §\"Plugin distribution\""
    ]
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by typed cross-tenant `depends_on` refs so the Dispatcher
  // readiness gate can fail closed on still-open sibling work.
  "cross_repo_targets": {
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    // Substrate marker. The plaintext sibling declares "jsonl"; this
    // plugin's substrate is a beads/Dolt tenant DB.
    "format": "beads",
    "compat": {
      // semver range and pinned tag against livespec. The pinned value
      // is a placeholder until the first livespec release tag; the next
      // bump-pin PR will set a real release tag here. Doctor's
      // contract-version-compatibility invariant fires `warn` against
      // "master" pins; that is expected during bootstrap.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.38.5"
    },
    // Per-repo beads tenant CONNECTION block. These keys are read by
    // commands/_config.py and overlaid by the LIVESPEC_BD_PATH /
    // LIVESPEC_BEADS_FAKE environment variables. The tenant PASSWORD is
    // deliberately ABSENT — it is supplied only via the BEADS_DOLT_PASSWORD
    // environment variable at bd-call time and is NEVER committed here.
    //
    // `tenant` == `database` == `server_user` is the load-bearing tenant
    // identity (one Dolt name serves all three). It is the ABBREVIATED
    // `livespec-orch-beads-fabro` (25 chars), NOT the repo/plugin/package name
    // `livespec-orchestrator-beads-fabro` (33 chars): Dolt/MySQL caps SQL
    // usernames at 32, so the 33-char name cannot be the tenant.
    // The issue-ID `prefix` is DECOUPLED from the tenant DB name: it is the
    // short, readable `bd-ib` (bd's server-stored create-prefix), matching the
    // git-jsonl sibling's `bd-gj`. Existing items keep their historical
    // `livespec-impl-beads-*` IDs; new items get `bd-ib-*`. TCP-only (no
    // `socket` key): the dolt socket dir is 0750 dolt:dolt and
    // untraversable by sandboxed callers, matching the family-wide
    // server-mode connection model.
    //
    // `fake` selects the hermetic in-memory backend (the default CI tier
    // and the no-live-connection runtime fallback). It is false here so the
    // committed config describes the real connection; CI and tests set
    // LIVESPEC_BEADS_FAKE=1 to force the fake.
    "connection": {
      "tenant": "livespec-orch-beads-fabro",
      "prefix": "bd-ib",
      "database": "livespec-orch-beads-fabro",
      "server_user": "livespec-orch-beads-fabro",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the four
    // policy settings in SPECIFICATION/contracts.md §"The four policy settings"
    // are moved off their safe defaults so ready work is ADMITTED and ACCEPTED
    // without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The other two levers, `merge_on_review_cap` and `groom_cut_approval`,
    // deliberately STAY at their safe `false` / `human` defaults and are NOT
    // listed here: a review that cannot converge within the `review_fix_cap`
    // rounds of §"The three rework caps" is precisely the case that must reach
    // a human, per the design record cited in that section, and approving a
    // drafted groom cut is a human's call until livespec core ratifies the
    // consensus tier. A design-human-gated (spec-change-tier) item still
    // cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "auto_approve_ready": true,
      "wip_cap": 10,
      "acceptance_mode": "ai-only",
      "default_factory": "hp",
      // NAMED WORKFLOW VARIANTS — variant name -> directory, relative to this
      // repository's root. The reserved `implement-work-item` name is NEVER
      // read from here and registering it is refused before any run exists;
      // every OTHER name a dispatch may select — by `--workflow-name`, by an
      // item's recorded `dispatch_workflow` pin, or by `default_workflow` —
      // has to appear here or the dispatch is refused rather than silently
      // falling back to the reserved graph under the selected name.
      //
      // `groom-work-item` is the two-phase groom variant of
      // SPECIFICATION/contracts.md §"Grooming and slice-size calibration" ->
      // "Consensus-gated automated groom cut": its propose phase drafts a
      // decomposition, files nothing and terminates at a needs-human outcome
      // carrying the draft, and its apply phase files the approved slices and
      // regrooms the original out. The ratified clause requires a repository
      // that grooms this way to register the variant HERE, and that
      // registration is also what puts the directory in scope for the two
      // payload gates — `check-seam-equivalence` and
      // `check-no-fleet-toolchain-literals` read every directory this table
      // names, exactly as they read the bundle.
      //
      // Deliberately NO `default_workflow` key beside it: the reserved
      // workflow stays this repository's default, and a groom run is selected
      // explicitly through the Dispatcher's groom door.
      "workflows": {
        "groom-work-item": ".fabro/workflows/groom-work-item"
      },
      // The three DISPATCH-TIME BASELINE CONFORMANCE premises the factory
      // sandbox's prepare chain establishes: installing the commit-refuse
      // Mechanism, and the two Verifiers proving the hook and the plugin
      // resolution are actually there. Each is a typed integration point with a
      // CLOSED mode enumeration — "no_op" (the sandbox skips the step),
      // "shell_argv" (an "argv" array beside the mode, run verbatim), or
      // "internal_livespec_dev_tooling" (this fleet's own invocation, rendered
      // from the plugin's fleet-defaults module).
      //
      // THIS repository is a fleet member and does carry that tooling, so it
      // declares the internal mode for all three and its resolved values are the
      // committed workflow.toml prepare steps. Note what the mode costs even
      // here: it is UNSUPPORTED and may be unreliable, and it couples this
      // repository to the livespec-dev-tooling package. An adopter that carries
      // none of this fleet's tooling declares "no_op" instead — explicitly, so
      // the skip is a recorded choice rather than a silent degrade, which is
      // exactly what leaving these keys absent would be (and what the
      // Dispatcher's dispatch-time warning says out loud).
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      // The two TOOLCHAIN premises the sandbox prepare chain establishes
      // before the conformance gate above — fields
      // `dispatcher.prepare_toolchain.mise` (the version-manager install) and
      // `dispatcher.prepare_toolchain.lefthook` (the hook-manager install).
      // Each is an argv the Dispatcher resolves ONCE and renders into the
      // workflow payload's prepare steps as `inputs.prepare_toolchain_*`; the
      // committed payload spells NO fleet tool of its own (the
      // fleet-toolchain literal ban scans it), so the fleet member's actual
      // commands live HERE. An adopter without either tool declares nothing
      // and the step resolves to the ratified explicit no-op.
      //
      // WHY THE VERSION-MANAGER INSTALL IS ANONYMOUS (work-item bd-ib-bic7hb,
      // root-caused 2026-07-26 by live capture inside the sandbox image):
      // `mise install` resolves the aqua-backed pins in .mise.toml through
      // api.github.com, and its aqua backend automatically picks up
      // GITHUB_TOKEN (or GH_TOKEN / GITHUB_API_TOKEN) when one is present.
      // The Dispatcher's run-config overlay projects an ephemeral App
      // INSTALLATION token as GITHUB_TOKEN, so leaving it in scope silently
      // made a third-party PUBLIC-repo metadata fetch a consumer of the
      // factory's own App-installation credit — one 5000/hr primary
      // rate-limit bucket shared with every `gh`, janitor and merge-poll
      // call the fleet makes. When it emptied, mise got
      //   403 {"message": "API rate limit exceeded for installation ID ..."}
      // the prepare step exited 1, and the run died before ANY agent work
      // while the admitted work-item was left stranded in `active` (two
      // dispatches of bd-ib-pme57n, 2026-07-26 20:02:42Z and 20:05:17Z; in
      // the same sandbox and the same second, the ANONYMOUS request for the
      // same URL returned 200 while the credentialed one returned 403).
      // Anonymous is the right posture, not a workaround: the fetch reads
      // public release metadata only, so it needs no credential at all, and
      // the anonymous bucket (60/hr per egress IP) is touched ~2-3 times per
      // dispatch. All three variable names are scrubbed because mise accepts
      // any of them; the scrub is scoped to this ONE command — every later
      // step, and every agent node, still sees the full credential
      // environment. The durable prevention (pre-bake the aqua-backed tools
      // into the sandbox image) remains open on bd-ib-bic7hb behind bd-ib-dwv.
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      // Detection-coverage anchor: the ledger item the two detection skills
      // (capture-impl-gaps, capture-spec-drift) append their attributed ATTEMPT
      // and all-or-nothing COMPLETED-coverage records to, per contracts.md
      // §"Detection coverage records and staleness facts". The anchor is
      // provisioned ONCE by the operator through capture-work-item — creating it
      // is a consent-native act, not something the implementation may do on the
      // operator's behalf — and its id is then written here.
      //
      // Provisioned 2026-09-09 through capture-work-item as bd-ib-j5fzyo while
      // working plan bd-ib-jxvgq5, after the v109 post-revise capture proved that
      // an empty value prevents even an aborted ATTEMPT from being recorded.
      // This is a standing anchor, not a unit of work: it MUST remain backlog and
      // MUST NOT be closed, regroomed, dispatched, or parented to a plan. Only
      // record_detection_run may append comments; a hand-authored coverage-shaped
      // comment could falsely advance a computed coverage point and is forbidden.
      "detection_coverage_anchor": "bd-ib-j5fzyo",
      // Merge-count trigger for the drift-staleness fact. Declared
      // API-configurable (see .claude-plugin/api-configurable-keys.json); left at
      // its ratified default of 1 here, so any landing on the default branch since
      // the last completed drift coverage point surfaces the fact.
      "drift_capture_merge_threshold": 1,
      // How long a Fabro run parked in a human-input-required state may hold a
      // scheduler slot while its work-item is still live, per contracts.md
      // §"A factory run never awaits a human". Past this bound the reconciler
      // exports the run and answers its own Abandon option; the work-item is
      // left exactly as it was, so the decision keeps waiting in the ledger.
      // Left at its ratified default of 1800 here.
      //
      // NOT API-configurable, deliberately: lowering it makes the Dispatcher
      // terminate parked runs sooner, so it is editable only by a committed
      // change to this file. `0` disables the arm outright — no run is
      // inspected and none is held — which is the escape hatch for a factory
      // whose parked runs must be left strictly alone.
      "blocked_run_grace_seconds": 1800,
      // No "dispatcher.codex_models" block: this repo inherits the plugin's
      // built-in fleet default ACP adapters for every node class (contracts.md
      // section "Codex ACP node model pins", v107) -- the implementer nodes run
      // the Claude Opus 5 adapter and the publish (pr) node runs the Claude
      // Haiku 4.5 adapter. Both are model-agnostic Claude adapters with no
      // OpenAI/Codex catalog exposure.
      //
      // This repo formerly pinned "codex_models.pr" to the Codex model
      // "gpt-5.4-mini" (maintainer-directed 2026-08-22, to hold steady-state
      // Codex subscription burn). That slug was dropped from the ChatGPT-account
      // Codex catalog, breaking the pr stage of every unconfigured repo; v107
      // moved the pr fleet default to Claude Haiku and this repo dropped its
      // override to take that default. To route a node class back to Codex,
      // add a "codex_models.<implementer|pr>" table (any model), or use
      // "acp_nodes.<node>" for any adapter.
      // Per-node ACP adapters (contracts.md, the "ACP node adapter
      // configuration" material), the PER-REPOSITORY layer. There is NO
      // `acp_nodes` override as of 2026-08-28: the review node reverts to the
      // workflow default, which is the Claude Opus 4.8 review adapter
      // (contracts.md documents that `review` is NOT Codex-backed by default).
      // The prior gpt-5.6-terra override (maintainer direction 2026-08-26) was
      // removed after three consecutive review non-convergences at the Codex
      // review gate: each exhausted review_fix_cap and escalated
      // otherwise-correct work to a human. Maintainer direction 2026-08-28:
      // move review back to Opus. The `pr` node now takes the fleet Claude
      // Haiku default (see the codex_models note above; a mechanical git/gh
      // node with no design judgement); review reverts to Opus.
      // The repo-config negative control lives in
      // tests/integration/test_codex_adapter_baked_path_scenarios90_91.py.
      //
      // Per-node ACP turn ceilings, restoring THIS repository's pre-v0.80.0
      // effective values through the surface contracts.md section "ACP node
      // timeouts" (v081) provides. The plugin's built-in default is 1800s for
      // every node; that default is the maintainer's ruling and is deliberately
      // NOT relitigated here -- it stays in force fleet-wide and, in this repo,
      // for every node absent from this table.
      //
      // WHY THIS REPO OVERRIDES, with the measurement rather than a preference.
      // bd-ib-tsna (the per-node adapter configuration item) was the first
      // dispatch to run under the 1800s default. Both of its `implement`
      // attempts died with "ACP turn timed out" at a recorded stage duration of
      // 1800038 ms -- the configured ceiling to 38 milliseconds, which is the
      // signature of a constant rather than of a slow turn. The turn was
      // PRODUCTIVE when it was cut: its exported stage diff carried 3004 lines
      // across the three new adapter-resolution modules. Two 30-minute turns
      // were burned and the run reached the human gate with nothing published.
      //
      // The values below are exactly what this repository shipped BEFORE the
      // v0.80.0 default reduction -- implement 14400s (raised deliberately after
      // two heavy items died near 120 minutes), janitor and fix 3600s. Every
      // other node (pr, review, review_fix, disposition, and the terminal
      // handlers) already matched 1800s before the change and is therefore
      // omitted, so this table restores prior behaviour rather than inventing
      // new headroom. cnkf's own intake triage named this override as the
      // operator follow-up owed once evidence appeared; the run above is that
      // evidence.
      "node_timeouts": {
        "implement": 14400,
        "janitor": 3600,
        "fix": 3600
      },
      "factories": {
        "vps": {
          "server": "https://vps.perch-rudd.ts.net:32276"
        },
        "hp": {
          "server": "https://hp-xubuntu.perch-rudd.ts.net:32276"
        }
      }
    }
    // The Dispatcher also resolves its `fabro`
    // engine binary by the precedence: the LIVESPEC_FABRO_BIN environment
    // variable (highest) > this block's `dispatcher.fabro_bin` key > a built-in
    // default that probes `$HOME/.fabro/bin/fabro` (host under the credential
    // wrapper, which sanitizes PATH but preserves HOME) and falls back to a
    // PATH lookup for `fabro` (the orchestrator container, where it lives at
    // /usr/local/bin/fabro). No live value is committed here: the default works
    // in both envs. To pin an exact path, add a `fabro_bin` key to the
    // `dispatcher` block above.
  },
  // The three orchestrator-side contract CLIs, named in argv form per
  // livespec/SPECIFICATION/contracts.md §"Orchestrator CLI contract — the
  // three named CLIs" and §"CLI shape conventions" (one binary per side
  // with subcommands). Paths are project-root-relative; callability is
  // verified by the `config-named-cli-callability` doctor invariant.
  "orchestrator": {
    "name": "livespec-orchestrator-beads-fabro",
    "spec_reader": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "spec-reader"],
    "gap_capture": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "gap-capture"],
    "drift_capture": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "drift-capture"]
  }
}
