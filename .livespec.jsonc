// Project-local livespec configuration for livespec-orchestrator-beads-fabro.
// This plugin dogfoods livespec: the SPECIFICATION/ tree at the repo
// root is the live spec; this plugin's own impl tracking lives in a
// per-repo beads TENANT DATABASE on the shared dolt-server (NOT in JSONL
// files at the repo root — that is the plaintext sibling's substrate).
//
// Authority:
//   livespec/SPECIFICATION/contracts.md
//     §"Cross-repo coordination — pin-and-bump"
//     §"`compat` block" (the schema this file populates)
//   dev-tooling/implementation/research/beads-schema-mapping.md
//     §2.1 (the verified v1.0.5 server-mode FLAGS connection model)
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Maintainer opt-in 2026-08-21: the foreman may convene the cross-vendor
  // consensus panel on a blocked session and act on its typed verdict through
  // foreman-act, instead of only surfacing it. Absent (or unrecognized) this
  // key resolves to the fail-closed default "report-only". The contract floors
  // are NOT relaxed by this setting: the foreman still escalates and does not
  // act on panel dissent, any insufficient-information verdict, a decision that
  // is human-gated by design, or a failed audit-journal append. Brings this repo
  // in line with livespec-overseer, livespec-console-beads-fabro and
  // livespec-dev-tooling, which already carry this value.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  "codex_full_access": {
    "fleet_listed": true
  },
  // Fleet-default credential-injection wrapper (argv-form command prefix). The
  // bin/*.py credential self-heal (bin/_bootstrap.py) re-execs the process
  // through this prefix when BEADS_DOLT_PASSWORD is absent, so the 1Password
  // Environment wrapper injects the shared fleet tenant secret before any beads
  // CLI runs. Backend-agnostic per livespec core's config schema (a non-empty
  // array of strings); the secret backend + injected vars are this project's
  // own concern and are NEVER committed here.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  // Operator-owned work uses this exact Git author independently of the
  // GitHub App that transports a push. The listed bot pairs are reserved for
  // exclusively mechanical release and dependency-pin commits; they never
  // replace the operator author in a Dispatcher/Fabro implementation run.
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      {
        "name": "livespec-pr-bot[bot]",
        "email": "livespec-pr-bot[bot]@users.noreply.github.com"
      },
      {
        "name": "livespec-pr-bot[bot]",
        "email": "283469463+livespec-pr-bot[bot]@users.noreply.github.com"
      },
      {
        "name": "thewoolleyman-factory-bot[bot]",
        "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com"
      },
      {
        "name": "thewoolleyman-factory-bot[bot]",
        "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com"
      }
    ]
  },
  "harnesses": {
    "claude": { "status": "supported", "canonical_command": "livespec-orchestrator-beads-fabro:next" },
    "codex":  { "status": "supported", "canonical_command": "livespec-orchestrator-beads-fabro:next" }
  },
  // ACTIVE spec_governance overrides. Maintainer-directed fleet-wide autonomy
  // lever rollout (epic livespec-jvdvx4, child livespec-jvdvx4.15): these
  // levers were shipped in livespec core (Increments 1-2) but never armed
  // here. The commented reference block below carries the COMPLETE ten-key
  // manifest at its safe defaults (the consumer-side guard
  // `check-spec-governance-default-block` requires every installed manifest
  // key there, armed or not); the three levers this repo has NOT armed are
  // called out above it. `dispatcher.merge_on_review_cap` is likewise left
  // at its safe default in the `dispatcher` block further down, not here.
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    // ratification_review: "auto-spawn" is inert without a configured
    // reviewer model (effective.py's effective_ratification_review returns
    // requires_input=True when ratification_reviewer_model is None). The
    // reviewer model is the OpenAI Codex model gpt-6-astra, driven in a
    // separate read-only Codex session, per maintainer direction 2026-10-10
    // (it was "sonnet" from 2026-08-24, chosen over livespec core's "fable"
    // convention when that model returned 529 Overloaded errors).
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": "gpt-6-astra",
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: the complete safe-default reference block.
  // Seven of these ten levers are armed in the ACTIVE block above; the three
  // left at their safe defaults deliberately are:
  //   doctor_dispositions: unmapped check_ids still escalate to a human —
  //     population is deferred to a dedicated follow-up (per-check_id
  //     judgment call, not a mechanical rollout).
  //   drift_acceptance_mode: the only non-human value (consensus) is inert,
  //     pending the not-yet-built Increment-3 cross-vendor panel.
  //   ratification_min_review_age_seconds: the shipped default of 1 second
  //     imposes no practical floor, so there is nothing to override.
  // The guard parses the commented object below against the installed
  // livespec-runtime manifest, so keep every key at its safe default here
  // even when the active block overrides it (bd-ib-lj3d, bd-ib-fqjk).
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus")
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn")
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string or null)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green")
  //     "spec_pr_merge": "manual"
  //   }
  //
  // Cross-spec citation allowlist for doctor's no-cross-spec-reference
  // invariant. contracts.md §"pi skill surface" cites livespec core's
  // Driver-shipped-hooks and Plugin-distribution contracts by section
  // rather than restating them — restating a sibling-owned contract here
  // is exactly what the no-cross-spec-reference rule exists to prevent.
  "external_references": {
    "livespec": [
      "SPECIFICATION/contracts.md §\"Driver-shipped hooks\"",
      "SPECIFICATION/contracts.md §\"Plugin distribution\""
    ]
  },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by typed cross-tenant `depends_on` refs so the Dispatcher
  // readiness gate can fail closed on still-open sibling work.
  "cross_repo_targets": {
    "livespec-overseer": {
      "github_url": "https://github.com/thewoolleyman/livespec-overseer",
      "local_clone": "/data/projects/livespec-overseer",
      "default_branch": "master"
    },
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    // Substrate marker. The plaintext sibling declares "jsonl"; this
    // plugin's substrate is a beads/Dolt tenant DB.
    "format": "beads",
    "compat": {
      // semver range and pinned tag against livespec. The pinned value
      // is a placeholder until the first livespec release tag; the next
      // bump-pin PR will set a real release tag here. Doctor's
      // contract-version-compatibility invariant fires `warn` against
      // "master" pins; that is expected during bootstrap.
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.42.1"
    },
    // Per-repo beads tenant CONNECTION block. These keys are read by
    // commands/_config.py and overlaid by the LIVESPEC_BD_PATH /
    // LIVESPEC_BEADS_FAKE environment variables. The tenant PASSWORD is
    // deliberately ABSENT — it is supplied only via the BEADS_DOLT_PASSWORD
    // environment variable at bd-call time and is NEVER committed here.
    //
    // `tenant` == `database` == `server_user` is the load-bearing tenant
    // identity (one Dolt name serves all three). It is the ABBREVIATED
    // `livespec-orch-beads-fabro` (25 chars), NOT the repo/plugin/package name
    // `livespec-orchestrator-beads-fabro` (33 chars): Dolt/MySQL caps SQL
    // usernames at 32, so the 33-char name cannot be the tenant.
    // The issue-ID `prefix` is DECOUPLED from the tenant DB name: it is the
    // short, readable `bd-ib` (bd's server-stored create-prefix), matching the
    // git-jsonl sibling's `bd-gj`. Existing items keep their historical
    // `livespec-impl-beads-*` IDs; new items get `bd-ib-*`. TCP-only (no
    // `socket` key): the dolt socket dir is 0750 dolt:dolt and
    // untraversable by sandboxed callers, matching the family-wide
    // server-mode connection model.
    //
    // `fake` selects the hermetic in-memory backend (the default CI tier
    // and the no-live-connection runtime fallback). It is false here so the
    // committed config describes the real connection; CI and tests set
    // LIVESPEC_BEADS_FAKE=1 to force the fake.
    "connection": {
      "tenant": "livespec-orch-beads-fabro",
      "prefix": "bd-ib",
      "database": "livespec-orch-beads-fabro",
      "server_user": "livespec-orch-beads-fabro",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the four
    // policy settings in SPECIFICATION/contracts.md §"The four policy settings"
    // are moved off their safe defaults so ready work is ADMITTED and ACCEPTED
    // without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The other two levers, `merge_on_review_cap` and `groom_cut_approval`,
    // deliberately STAY at their safe `false` / `human` defaults and are NOT
    // listed here: a review that cannot converge within the `review_fix_cap`
    // rounds of §"The three rework caps" is precisely the case that must reach
    // a human, per the design record cited in that section, and approving a
    // drafted groom cut is a human's call until livespec core ratifies the
    // consensus tier. A design-human-gated (spec-change-tier) item still
    // cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "auto_approve_ready": true,
      "wip_cap": 10,
      "acceptance_mode": "ai-only",
      "default_factory": "hp",
      // THE DELIBERATE OPERATOR FLOOR, and the only currency form with any
      // blocking authority at admission: a dispatch refuses before claim when
      // the EXECUTING plugin release is below this value. Ambient staleness
      // never blocks, however far behind the executing build is, so absent this
      // key the currency gate can only warn. A release that cannot be observed
      // at all is recorded undetermined and the dispatch proceeds — an
      // unobservable build must never fail open into a false refusal — and a
      // git-checkout plugin root is exempt before the floor is even read.
      //
      // 0.161.0 IS THE FIRST FALLBACK-CAPABLE RELEASE, which is what Scenario
      // 127's "New grammar is version-gated against the resolved factory"
      // requires this value to name. It is the first PUBLISHED release in which
      // the whole ratified new-grammar surface resolves: the closed candidate
      // schema and ordered chain (first released in 0.147.0), plus the
      // structured candidate form with catalog-derived identity, plus
      // per-candidate `config_options` and the factory capability gate that
      // keeps such a chain from running green against an engine which cannot
      // configure it.
      //
      // WHY NOT 0.147.0, where `fallbacks` first parsed. A build in the
      // 0.147.0–0.160.x range understands the array but can resolve neither a
      // structured `agent` entry nor `config_options` — it REFUSES them as
      // unknown keys, which is loud rather than silent, but it is also exactly
      // the range this plan's own proof has to exclude. A build BELOW 0.147.0 is
      // the genuinely dangerous one: it tolerates `fallbacks` as an unknown key
      // on a legacy entry and silently ignores the operator's whole chain, so
      // the configured fallback never happens and nothing in the record says so.
      //
      // This key is NOT in the API-configurable manifest, for the same reason
      // `require_invoker` is not: a safety floor an automated surface could
      // lower or delete is not a floor. Raise it by hand, through a committed
      // change, when a release fixes something a dispatch must not run without.
      "minimum_release": "0.161.0",
      "fabro_sandbox_image": "ghcr.io/thewoolleyman/livespec-fabro-sandbox:python-agent-v1.92.0",
      // THE COMMITTED MIRROR of the capability set the sandbox image above
      // publishes at /etc/livespec/sandbox-capabilities — one lowercase
      // snake_case name per entry. A *sandbox capability* is a named surface
      // the sandbox can exercise for proof, and the dod_gate node checks each
      // factory_captured assertion's surface against this set in BOTH
      // directions: an assertion needing a capability the set lacks is a
      // finding naming the capability, and a host_captured or human_attested
      // declaration a capability COULD exercise is refused naming it.
      //
      // THE PUBLISHED FILE IS THE AUTHORITY, not this array. The gate reads
      // the file where the image publishes one and uses this mirror only as
      // the fallback; the mirror exists so a HOST-side surface — the capture
      // and groom filing displays above all — can show the set without
      // spending a sandbox. A name here the image does not publish is
      // reported by the gate as a configuration mismatch against this file,
      // which is journaled and never fails the gate. Delete the key and the
      // set is UNKNOWN rather than empty: the gate then reports
      // `sandbox-capabilities: unpublished`, withholds the
      // missing-capability finding, and applies every other check unchanged.
      //
      // `terminal` is the baseline every image carries (a shell plus this
      // repository's own toolchain). `tmux` is deliberate — the
      // factory-tier acceptance tests drive private tmux sockets — and
      // `headless_browser` is what makes a web-interface assertion
      // screenshot-provable in-sandbox. `herdr` is NOT here: the image does
      // not carry it yet, and it is added to this array by the image slice
      // that adds it to the image, never ahead of it.
      //
      // NOT API-configurable, deliberately, for the same reason
      // `minimum_release` is not: an automated surface that could add a name
      // the image does not carry would make the gate pass an assertion no
      // sandbox can prove. Edit it by hand, in the same change that moves
      // `fabro_sandbox_image`.
      "sandbox_capabilities": ["terminal", "headless_browser", "tmux", "herdr"],
      // NAMED WORKFLOW VARIANTS — variant name -> directory, relative to this
      // repository's root. The reserved `implement-work-item` name is NEVER
      // read from here and registering it is refused before any run exists;
      // every OTHER name a dispatch may select — by `--workflow-name`, by an
      // item's recorded `dispatch_workflow` pin, or by `default_workflow` —
      // has to appear here or the dispatch is refused rather than silently
      // falling back to the reserved graph under the selected name.
      //
      // `groom-work-item` is the two-phase groom variant of
      // SPECIFICATION/contracts.md §"Grooming and slice-size calibration" ->
      // "Consensus-gated automated groom cut": its propose phase drafts a
      // decomposition, files nothing and terminates at a needs-human outcome
      // carrying the draft, and its apply phase files the approved slices and
      // regrooms the original out. The ratified clause requires a repository
      // that grooms this way to register the variant HERE, and that
      // registration is also what puts the directory in scope for the two
      // payload gates — `check-seam-equivalence` and
      // `check-no-fleet-toolchain-literals` read every directory this table
      // names, exactly as they read the bundle.
      //
      // Deliberately NO `default_workflow` key beside it: the reserved
      // workflow stays this repository's default, and a groom run is selected
      // explicitly through the Dispatcher's groom door.
      "workflows": {
        "groom-work-item": ".fabro/workflows/groom-work-item"
      },
      // The three DISPATCH-TIME BASELINE CONFORMANCE premises the factory
      // sandbox's prepare chain establishes: installing the commit-refuse
      // Mechanism, and the two Verifiers proving the hook and the plugin
      // resolution are actually there. Each is a typed integration point with a
      // CLOSED mode enumeration — "no_op" (the sandbox skips the step),
      // "shell_argv" (an "argv" array beside the mode, run verbatim), or
      // "internal_livespec_dev_tooling" (this fleet's own invocation, rendered
      // from the plugin's fleet-defaults module).
      //
      // THIS repository is a fleet member and does carry that tooling, so it
      // declares the internal mode for all three and its resolved values are the
      // committed workflow.toml prepare steps. Note what the mode costs even
      // here: it is UNSUPPORTED and may be unreliable, and it couples this
      // repository to the livespec-dev-tooling package. An adopter that carries
      // none of this fleet's tooling declares "no_op" instead — explicitly, so
      // the skip is a recorded choice rather than a silent degrade, which is
      // exactly what leaving these keys absent would be (and what the
      // Dispatcher's dispatch-time warning says out loud).
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      // The two TOOLCHAIN premises the sandbox prepare chain establishes
      // before the conformance gate above — fields
      // `dispatcher.prepare_toolchain.mise` (the version-manager install) and
      // `dispatcher.prepare_toolchain.lefthook` (the hook-manager install).
      // Each is an argv the Dispatcher resolves ONCE and renders into the
      // workflow payload's prepare steps as `inputs.prepare_toolchain_*`; the
      // committed payload spells NO fleet tool of its own (the
      // fleet-toolchain literal ban scans it), so the fleet member's actual
      // commands live HERE. An adopter without either tool declares nothing
      // and the step resolves to the ratified explicit no-op.
      //
      // WHY THE VERSION-MANAGER INSTALL IS ANONYMOUS (work-item bd-ib-bic7hb,
      // root-caused 2026-07-26 by live capture inside the sandbox image):
      // `mise install` resolves the aqua-backed pins in .mise.toml through
      // api.github.com, and its aqua backend automatically picks up
      // GITHUB_TOKEN (or GH_TOKEN / GITHUB_API_TOKEN) when one is present.
      // The Dispatcher's run-config overlay projects an ephemeral App
      // INSTALLATION token as GITHUB_TOKEN, so leaving it in scope silently
      // made a third-party PUBLIC-repo metadata fetch a consumer of the
      // factory's own App-installation credit — one 5000/hr primary
      // rate-limit bucket shared with every `gh`, janitor and merge-poll
      // call the fleet makes. When it emptied, mise got
      //   403 {"message": "API rate limit exceeded for installation ID ..."}
      // the prepare step exited 1, and the run died before ANY agent work
      // while the admitted work-item was left stranded in `active` (two
      // dispatches of bd-ib-pme57n, 2026-07-26 20:02:42Z and 20:05:17Z; in
      // the same sandbox and the same second, the ANONYMOUS request for the
      // same URL returned 200 while the credentialed one returned 403).
      // Anonymous is the right posture, not a workaround: the fetch reads
      // public release metadata only, so it needs no credential at all, and
      // the anonymous bucket (60/hr per egress IP) is touched ~2-3 times per
      // dispatch. All three variable names are scrubbed because mise accepts
      // any of them; the scrub is scoped to this ONE command — every later
      // step, and every agent node, still sees the full credential
      // environment. The durable prevention (pre-bake the aqua-backed tools
      // into the sandbox image) remains open on bd-ib-bic7hb behind bd-ib-dwv.
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      // WHERE the post-merge janitor runs its fresh-checkout check suite
      // (bd-ib-26deyw). `cluster_job` delegates it to the maintainer-owned k3s
      // cluster through the shared dev-tooling delegated gate: the janitor
      // checkout's tree is pushed to the gates mirror, a gate Job runs the
      // suite in a pod, and this host reports that Job's own verdict. The
      // alternative is `host_local`, which is also what silence means, and
      // which is where every doubt resolves — an absent block, an absent key, a
      // value of the wrong type and an unrecognised word all keep the suite
      // running here, because only a declaration spelling the cluster value
      // exactly should move a repository's gate onto another machine.
      //
      // A LOST VERDICT IS RED, NOT GREEN, and that is not configurable: a gate
      // that was asked and did not answer reports the post-merge gate failed
      // naming the missing cluster verdict, because an item must never close on
      // a reading nobody took. That holds for whichever venue is declared here;
      // it is the cluster arm's verdict reading, not this key's doing.
      //
      // THIS REPOSITORY DECLARES `cluster_job`, AND IT PREVIOUSLY DECLARED
      // `host_local` FOR A REASON THAT IS NOW GONE. That reason was a property
      // of the shared gate pod rather than of this repository: the Job's
      // command used to be fixed in the dev-tooling package as four `just`
      // invocations ending in `just warm-typecheck` and `just hook_gate=1
      // check`, neither of which exists here, so the pod aborted on a GREEN
      // TREE — measured 2026-10-17 as Job
      // `gate-livespec-orchestrator-beads-fabro-ee118f8fd5dc`, which died with
      // "error: Variable 'hook_gate' overridden on the command line but not
      // present in justfile" against a tree whose master CI was green.
      //
      // THAT POD COMMAND IS NOW REPO-AGNOSTIC. The pinned dev-tooling resolves
      // it through `gate_remote_delegate.declared_gate_check_suite`, which
      // reads a `gate_check_suite` declaration out of the consuming
      // repository's own `[tool.livespec_dev_tooling]` block and otherwise
      // falls through to `install-worktree-pack`,
      // `install-commit-refuse-hooks`, `check-pre-push`. Measured against this
      // tree: `just --summary` lists all three of those recipes and this
      // repository's `pyproject.toml` declares no `gate_check_suite`, so the
      // Job runs that fall-through — this repository's own pre-push aggregate,
      // not another repository's recipes. Scope searched: this repository's
      // full `just --summary` and its `pyproject.toml`.
      //
      // THE POSITIVE CONTROL IS A REAL JOB, not that measurement. Gate Job
      // `gate-livespec-orchestrator-beads-fabro-1c5e8de33c1f` in namespace
      // `gates` ran this repository's own declared suite against tree
      // 1c5e8de33c1f5c1376e7027e89a6d7d55de03fa1 (master 655306cb, `ci-green`
      // success) under livespec-dev-tooling v1.112.5 and reported PASSED, 92
      // targets and 0 failed, with livespec core resolved at v0.42.1.
      //
      // WHAT IS STILL A PREMISE OF THE DISPATCHING HOST, AND WHICH WAY IT
      // FAILS. The cluster venue reaches the gate FROM that host, so it needs
      // the host's gates kubeconfig and a `render-gate-job.sh` — the in-repo
      // copy, or the converged
      // `/usr/local/lib/ci-runner-k3s/gates/render-gate-job.sh`. The client
      // returns the converged path unchecked on purpose, so an absent one fails
      // AT THE SEAM: the run reports `NO_VERDICT` and the paragraph above turns
      // that into a RED post-merge outcome naming the missing cluster verdict.
      // A host that cannot reach the gate therefore makes merges loud rather
      // than falsely green.
      //
      // The deferral that asked for the move is the archived livespec plan
      // k3s-on-gmktec-for-vps-usage (epic livespec-sab5gn), reconsidered once
      // R4 — the delegated pre-push gate — had been live-exercised with
      // independent replays on 2026-10-12 and 2026-10-13.
      "janitor": {
        "venue": "cluster_job"
      },
      // Detection-coverage anchor: the ledger item the two detection skills
      // (capture-impl-gaps, capture-spec-drift) append their attributed ATTEMPT
      // and all-or-nothing COMPLETED-coverage records to, per contracts.md
      // §"Detection coverage records and staleness facts". The anchor is
      // provisioned ONCE by the operator through capture-work-item — creating it
      // is a consent-native act, not something the implementation may do on the
      // operator's behalf — and its id is then written here.
      //
      // Provisioned 2026-09-09 through capture-work-item as bd-ib-j5fzyo while
      // working plan bd-ib-jxvgq5, after the v109 post-revise capture proved that
      // an empty value prevents even an aborted ATTEMPT from being recorded.
      // This is a standing anchor, not a unit of work: it MUST remain backlog and
      // MUST NOT be closed, regroomed, dispatched, or parented to a plan. Only
      // record_detection_run may append comments; a hand-authored coverage-shaped
      // comment could falsely advance a computed coverage point and is forbidden.
      "detection_coverage_anchor": "bd-ib-j5fzyo",
      // Merge-count trigger for the drift-staleness fact. Declared
      // API-configurable (see .claude-plugin/api-configurable-keys.json); left at
      // its ratified default of 1 here, so any landing on the default branch since
      // the last completed drift coverage point surfaces the fact.
      "drift_capture_merge_threshold": 1,
      // How long a Fabro run parked in a human-input-required state may hold a
      // scheduler slot while its work-item is still live, per contracts.md
      // §"A factory run never awaits a human". Past this bound the reconciler
      // exports the run and answers its own Abandon option; the work-item is
      // left exactly as it was, so the decision keeps waiting in the ledger.
      // Left at its ratified default of 1800 here.
      //
      // NOT API-configurable, deliberately: lowering it makes the Dispatcher
      // terminate parked runs sooner, so it is editable only by a committed
      // change to this file. `0` disables the arm outright — no run is
      // inspected and none is held — which is the escape hatch for a factory
      // whose parked runs must be left strictly alone.
      "blocked_run_grace_seconds": 1800,
      // The structured "acp_nodes" entries below put implement and fix on Codex
      // (codex-acp / gpt-6-sol, effort high) with a Claude Opus 5 fallback.
      // They ran gpt-5.6-terra from 2026-10-18 (PR #3265) until the R205
      // quality rule fired on 2026-10-19 (R219: two candidate-attributable
      // implement failures in the first five Codex runs, bd-ib-rz5m3z and
      // bd-ib-davaxq); Sol is the maintainer-authorized smarter fallback ruled
      // 2026-10-18 for exactly that case. The other nodes keep a Terra fallback;
      // dod_gate, review_fix and review on Claude Opus 5, and proof_capture,
      // proof_verify, pr and disposition on Claude Sonnet 5.5 at medium effort,
      // each with a Codex Terra fallback, so a Claude session-headroom
      // exhaustion no longer leaves a node without a candidate. The Sonnet 5.5
      // step is maintainer-approved 2026-10-19 (relayed by the coordinator,
      // R207 step 2) ahead of the fifth measured Codex implement run, because
      // the Anthropic seven-day budget was projected to run out that night. Maintainer direction 2026-10-18 (plan
      // fabro-currency, maintainer item 40; R209 relayed by the coordinator):
      // implement and fix run Terra, quality-conservative, with the Codex burn
      // watched per run; GPT-6 Luna was the first choice and is the burn
      // fallback. This is also the Codex-adapter dispatch the plan Definition
      // of Done and bd-ib-iud52v require. Maintainer direction
      // 2026-10-14 (bd-ib-5pxtaw): gpt-6-astra is reserved for consensus and
      // reviews OUTSIDE the factory nodes (ratification_reviewer_model above)
      // and goes on no factory node for now. implement and fix ran codex-acp /
      // gpt-6-astra from 2026-10-14 01:57 (75983fbe) until this change; at the
      // factory cap that drew the maintainer's Codex session budget down.
      //
      // "dispatcher.codex_models" IS RETIRED and setting it now REFUSES the
      // dispatch before claim, printing the equivalent "acp_nodes" entries.
      // This repo formerly pinned "codex_models.pr" to the Codex model
      // "gpt-5.4-mini" (maintainer-directed 2026-08-22, to hold steady-state
      // Codex subscription burn). That slug was dropped from the ChatGPT-account
      // Codex catalog, breaking the pr stage of every unconfigured repo; v107
      // moved the pr fleet default to Claude Haiku and this repo dropped its
      // override to take that default. To route ONE node to Codex, write a
      // structured entry for that node --
      // "acp_nodes.<node>": {"agent": "codex-acp", "model": ..., "effort": ...}
      // -- or any adapter via the manual "acp_nodes.<node>" form. There is no
      // class-shaped shorthand: each node is named individually.
      // Per-node ACP adapters (contracts.md, the "ACP node adapter
      // configuration" material), the PER-REPOSITORY layer. History: from
      // 2026-08-28 there was no `acp_nodes` override and the review node took
      // the workflow default, the Claude Opus 4.8 review adapter (contracts.md
      // documents that `review` is NOT Codex-backed by default); the current
      // per-node entries are described above.
      // The prior gpt-5.6-terra override (maintainer direction 2026-08-26) was
      // removed after three consecutive review non-convergences at the Codex
      // review gate: each exhausted review_fix_cap and escalated
      // otherwise-correct work to a human. Maintainer direction 2026-08-28:
      // move review back to Opus. The `pr` node now takes the fleet Claude
      // Haiku default (see the built-in defaults note above; a mechanical
      // git/gh node with no design judgement); review reverts to Opus.
      // The repo-config negative control lives in
      // tests/integration/test_codex_adapter_baked_path_scenarios90_91.py.
      //
      // Per-node ACP turn ceilings, restoring THIS repository's pre-v0.80.0
      // effective values through the surface contracts.md section "ACP node
      // timeouts" (v081) provides. The plugin's built-in default is 1800s for
      // every node; that default is the maintainer's ruling and is deliberately
      // NOT relitigated here -- it stays in force fleet-wide and, in this repo,
      // for every node absent from this table.
      //
      // WHY THIS REPO OVERRIDES, with the measurement rather than a preference.
      // bd-ib-tsna (the per-node adapter configuration item) was the first
      // dispatch to run under the 1800s default. Both of its `implement`
      // attempts died with "ACP turn timed out" at a recorded stage duration of
      // 1800038 ms -- the configured ceiling to 38 milliseconds, which is the
      // signature of a constant rather than of a slow turn. The turn was
      // PRODUCTIVE when it was cut: its exported stage diff carried 3004 lines
      // across the three new adapter-resolution modules. Two 30-minute turns
      // were burned and the run reached the human gate with nothing published.
      //
      // The values below are exactly what this repository shipped BEFORE the
      // v0.80.0 default reduction -- implement 14400s (raised deliberately after
      // two heavy items died near 120 minutes), janitor and fix 3600s. Every
      // other node (pr, review, review_fix, disposition, and the terminal
      // handlers) already matched 1800s before the change and is therefore
      // omitted, so this table restores prior behaviour rather than inventing
      // new headroom. cnkf's own intake triage named this override as the
      // operator follow-up owed once evidence appeared; the run above is that
      // evidence.
      // Per-node ACP adapters, the PER-REPOSITORY layer (contracts.md, "ACP
      // node adapter configuration"). Each structured entry names an agent
      // and a model from the committed catalogs plus an effort the agent
      // accepts; it replaces the workflow default's environment completely,
      // and the resolver derives read-only mode from node posture (review and
      // disposition). An agent, model or effort the catalogs do not list is
      // refused before claim.
      // Repository additions to the shipped model snapshot, based on the
      // Codex 0.162.1 account catalog fetched 2026-10-14. Listing establishes
      // local discovery; factory reachability is separate evidence.
      // Prices are the published Standard, short-context USD per 1M tokens,
      // verified 2026-10-14 (gpt-5.6-terra: 2026-10-18, base rates for prompts up
      // to 272K tokens; cache writes are 1.25x input) at
      // https://developers.openai.com/api/docs/models/
      // followed by each model id below. The existing four-rate schema holds
      // base rates, not long-context or service-tier multipliers.
      "model_catalog": {
        // Claude Sonnet 5.5 is not in the shipped snapshot. Prices are the
        // Anthropic first-party API rates (claude-api reference, cached
        // 2026-10-06): 2.00 input and 10.00 output USD per 1M tokens, cache
        // reads 0.20, and cache writes at the 1.25x-input five-minute rate.
        "anthropic/claude-sonnet-5-5": {
          "display_name": "Claude Sonnet 5.5",
          "pricing": {
            "model": "claude-sonnet-5-5",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-6.1-sol": {
          "display_name": "GPT-6.1 Sol",
          "pricing": {
            "model": "gpt-6.1-sol",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.1
          }
        },
        "openai/gpt-6-astra": {
          "display_name": "GPT-6 Astra",
          "pricing": {
            "model": "gpt-6-astra",
            "input_usd_per_million": 10.0,
            "output_usd_per_million": 50.0,
            "cache_write_usd_per_million": 12.5,
            "cache_read_usd_per_million": 1.0
          }
        },
        "openai/gpt-6-sol": {
          "display_name": "GPT-6 Sol",
          "pricing": {
            "model": "gpt-6-sol",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-5.6-terra": {
          "display_name": "GPT-5.6 Terra",
          "pricing": {
            "model": "gpt-5.6-terra",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 12.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-6-luna": {
          "display_name": "GPT-6 Luna",
          "pricing": {
            "model": "gpt-6-luna",
            "input_usd_per_million": 0.1,
            "output_usd_per_million": 0.5,
            "cache_write_usd_per_million": 0.125,
            "cache_read_usd_per_million": 0.01
          }
        }
      },
      "acp_nodes": {
        "dod_gate": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "implement": { "agent": "codex-acp", "model": "gpt-6-sol", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "fix": { "agent": "codex-acp", "model": "gpt-6-sol", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "review_fix": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "proof_capture": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "proof_verify": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "review": { "agent": "claude-acp", "model": "claude-opus-5", "effort": "high", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "pr": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] },
        "disposition": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium", "fallbacks": [{ "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high" }] }
      },
      // `review_fix` is a DIFFERENT node from `fix` and was absent here, so it
      // fell to the 1800 s default. Measured 2026-10-09/10 on run
      // 01M4HA8YVAAH (bd-ib-4ipmub): review_fix@1 and review_fix@2 both ended
      // "ACP turn timed out ... last update at 1800000 ms" while finishing a
      // Red-Green pair plus this repository's full check (7,194 tests under
      // load), and the second left an open Red the engine checkpoint could not
      // commit (bd-ib-qhv7qs). Two hours covers the pair, the coverage rerun
      // and the full gate with the same headroom `implement` has.
      //
      // `janitor` runs the full check aggregate, which slows with factory
      // load. Measured 2026-10-14 on run 01M4WVQ7E9N6 (bd-ib-jtl5ir): janitor
      // timed out at 3600 s about two thirds of the way through `just check`
      // with hp at load 15-23 and at its concurrency cap of 10. 4340 is an
      // INTERIM partial mitigation (bd-ib-qieqc6.2): every node timeout feeds
      // the Codex credential-lifetime floor, and 4340 is the largest janitor
      // value that keeps that floor under the bound
      // tests/test_factory_checkpoint_declaration.py guards -- measured
      // against the 530000 s bound that test carried at the time; bd-ib-xi63mq
      // has since re-measured and raised it, so 4340 is no longer the ceiling
      // that reasoning derived. The full raise to
      // 7200 follows once the Codex freshness gate applies only to dispatches
      // that route a node to Codex.
      //
      // Both PUBLICATION stages run this repository's declared check suite
      // inside a push hook, so each needs the suite's whole wall clock plus the
      // push itself. Measured on hp, four runs lost a GREEN janitor's work at
      // the 1800 s default: bd-ib-vlctc3 (run 01M4TYK09SRPPT5W9EDG4VWGG0) and
      // bd-ib-zddbkq (01M4VQP22484T20JNXP53FJ41E) inside `publish_draft`'s push,
      // bd-ib-s6bowj (01M4VQV7APGJS3ZAA38YAB7106) inside `pr_refresh` at about
      // 96% of its suite. They are raised TOGETHER on purpose: a refresh
      // bounded at half its sibling's budget fails on the same suite one stage
      // later (bd-ib-xi63mq, Scenario 177).
      //
      // `proof_grade` and `proof_grade_route` are declared DOWNWARD, the only
      // entries here that are. The grade is one `gh pr view` plus a sub-second
      // parse of that payload through the acceptance pass's own record reader,
      // and the route is a `cat` of one counter file -- neither runs a suite, a
      // push or an agent turn -- so the 1800 s default is three times a generous
      // budget for either. The reason to say so rather than inherit the default
      // is that the grade sits on the single edge out of a `verified` replay and
      // the route closes a cycle back into it, so the derivation bills them at
      // that node's own visit count and every one of those seconds lands in the
      // Codex credential-lifetime floor
      // tests/test_factory_checkpoint_declaration.py guards: inherited, the two
      // nodes demanded 31320 s more of a token's remaining life than declared at
      // 600 (bd-ib-kcq6pu).
      "node_timeouts": {
        "implement": 14400,
        "janitor": 4340,
        "fix": 3600,
        "review_fix": 7200,
        "publish_draft": 3600,
        "pr_refresh": 3600,
        "proof_grade": 600,
        "proof_grade_route": 600
      },
      // ACTIVE inventory, not endpoint history: an unnamed `reconcile-runs`
      // pass surveys every entry. Intentionally stopped or retired factories
      // must stay absent so the host timer never contacts them.
      //
      // Each entry may also carry an optional `bin` key: the absolute path to
      // the engine CLIENT binary that factory's server speaks to. It wins over
      // the global `fabro_bin` resolution described below (including over an
      // explicit `--fabro-bin`), because it states a COMPATIBILITY constraint
      // rather than a preference -- a Petri-era client cannot talk to a 0.254
      // server, nor the reverse -- and it is what makes an upgrade candidate
      // runnable BESIDE production on one host. Omit it, as `hp` does, and
      // that factory resolves the global binary exactly as before the key
      // existed. A `bin` naming no file, or a file with no execute bit, is
      // refused before the item is claimed.
      //
      // Each entry may ALSO carry an optional `environment` key: the id of an
      // environment in THAT factory's server-managed catalog, which the
      // dispatch passes as `fabro run --environment`. On a Petri-era server
      // the environment is selected from the run intent's id ALONE, and that
      // selection overrides the `[run.environment]` id the workflow declares
      // (the workflow's env and resources overlays still apply to whichever
      // environment was selected). A run intent naming none sends `default`,
      // so a dispatch to such a server landed in `buildpack-deps:noble` with
      // no `mise` on PATH and died in a prepare step -- a failure that names
      // nothing about the placement. Omit it, as `hp` does, and NO flag is
      // emitted at all: the pinned 0.254 engine has no such flag and keeps
      // selecting from the workflow, so an unconditional one would kill every
      // dispatch to that engine at argument parsing. A declared `environment`
      // that is not a non-empty string is refused before the item is claimed,
      // naming the factory.
      //
      // Each entry may ALSO carry an optional `secret_channel` key: the
      // transport that factory's engine resolves a projected credential
      // through. The two values are self-describing, never numbered:
      //
      //   "inline_overlay"  -- the value is written into the uncommitted,
      //                        mode-600 run-configuration overlay. The pinned
      //                        0.254 engine offers no secret-reference syntax
      //                        at all, so this is the ONLY thing that works on
      //                        it, and it is what an entry declaring no
      //                        channel resolves to.
      //   "native_secrets"  -- the overlay carries a by-name vault reference
      //                        and the Dispatcher stores each value through
      //                        `fabro secret set` before the launch. Required
      //                        on a Petri-era engine, where a workflow version
      //                        is stored IMMUTABLY ON THE SERVER: an inline
      //                        value there does not expire with the overlay
      //                        file, it persists server-side for the life of
      //                        the version, which is what `fabro inspect`
      //                        returned unredacted on hp run 01M058955QQ5.
      //
      // A value this build does not recognise is REFUSED before the launch
      // rather than falling back to the inline transport -- guessing the
      // inline one on a Petri-era server is precisely the exposure above.
      // The 0.378-nightly upgrade CANDIDATE instance on hp:32278 (plan
      // `fabro-currency` research note 006) is deliberately NOT declared here
      // yet, and the reason is this table's own first rule rather than
      // reluctance. Every declared entry is surveyed by each `reconcile-runs`
      // pass, and a Petri-era server cannot answer the pinned 0.254 client, so
      // an entry without a `bin` pin would add one `ps-failed` error row to
      // every pass until that pin lands. The pin is an absolute host path this
      // repository cannot establish from a sandbox, so the entry belongs with
      // the cutover that measures it (`bd-ib-sxcnj7`), alongside the Ansible
      // per-instance binary override the same item owns. A canary against the
      // candidate therefore declares its entry host-side, where the client
      // path is known, which is also where that canary's proof is captured.
      //
      // Each entry may ALSO carry an optional `docker_host` key: the Docker
      // daemon that runs THAT factory's sandbox containers, spelled as the
      // Docker CLI spells one and passed to it as `--host`. The
      // sandbox-container sweep of each `reconcile-runs` pass addresses it,
      // and an entry declaring none is reported as UNOBSERVED rather than
      // swept through whichever daemon the reconciling host runs. That is not
      // a conservative default, it is the only honest reading: the `server`
      // url beside this key is no evidence of a daemon's whereabouts -- a
      // loopback url is as likely to be a forwarded tunnel as a local engine
      // -- so inferring one fails in the expensive direction, removing a
      // container on the RECONCILING host on the strength of a run status
      // read from a different one. The defect that made this key necessary
      // was exactly that blind spot with the reading reversed: the pass runs
      // on the host carrying the primary checkout, which has never started a
      // sandbox container, so every sweep record read
      // `containers_observed: 0` while twelve `fabro-run-*` containers ran on
      // `hp`, four of them left behind by runs that server reported `failed`
      // (measured 2026-10-14). The reconciling host's own credentials must
      // reach the named daemon; while they do not, the pass says so on every
      // sweep record instead of reporting a clean factory.
      "factories": {
        "hp": {
          "server": "https://hp-xubuntu.perch-rudd.ts.net:32276",
          "docker_host": "ssh://cwoolley@hp-xubuntu.perch-rudd.ts.net"
        }
      }
    }
    // The Dispatcher also resolves its `fabro`
    // engine binary by the precedence: the LIVESPEC_FABRO_BIN environment
    // variable (highest) > this block's `dispatcher.fabro_bin` key > a built-in
    // default that probes `$HOME/.fabro/bin/fabro` (host under the credential
    // wrapper, which sanitizes PATH but preserves HOME) and falls back to a
    // PATH lookup for `fabro` (the orchestrator container, where it lives at
    // /usr/local/bin/fabro). No live value is committed here: the default works
    // in both envs. To pin an exact path, add a `fabro_bin` key to the
    // `dispatcher` block above.
  },
  // The three orchestrator-side contract CLIs, named in argv form per
  // livespec/SPECIFICATION/contracts.md §"Orchestrator CLI contract — the
  // three named CLIs" and §"CLI shape conventions" (one binary per side
  // with subcommands). Paths are project-root-relative; callability is
  // verified by the `config-named-cli-callability` doctor invariant.
  "orchestrator": {
    "name": "livespec-orchestrator-beads-fabro",
    "spec_reader": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "spec-reader"],
    "gap_capture": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "gap-capture"],
    "drift_capture": ["python3", ".claude-plugin/scripts/bin/orchestrator.py", "drift-capture"]
  }
}
