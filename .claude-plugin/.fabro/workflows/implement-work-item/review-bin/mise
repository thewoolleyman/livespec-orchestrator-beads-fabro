#!/bin/sh
# The review Mise boundary. `mise exec` (alias `x`) may replace PATH, so inspect
# the child command before it can route around the review Git and Just
# launchers. Every supported spelling is read: global options before the
# subcommand, runtime tools before the child, the `--` separator, and the
# `-c`/`--command` string form.
set -u

refuse_suite() {
 echo "LIVESPEC_REVIEW_GUARD_REFUSED: stage=review refused a whole-suite check. Run named test ids only, then emit your verdict label." >&2
 exit 1
}

refuse_branch() {
 echo "LIVESPEC_REVIEW_GUARD_REFUSED: stage=review refused a command that moves or edits the run branch. Read the change with git diff, git log and git show, then emit your verdict label." >&2
 exit 1
}

# classify_child EXECUTABLE [ARGUMENT...] refuses a guarded child command.
classify_child() {
 while [ "$#" -gt 0 ]; do
  case "$1" in
   *=*|env|exec|command) shift ;;
   *) break ;;
  esac
 done
 [ "$#" -gt 0 ] || return 0
 case "${1##*/}" in
  livespec-implement-check-suite) refuse_suite ;;
  just)
   shift
   command="" value=0
   for argument in "$@"; do
    if [ "$value" -eq 1 ]; then value=0; continue; fi
    case "$argument" in
     -f|--justfile|-d|--working-directory|--shell|--chooser|--color|--command-color|--dump-format) value=1 ;;
     -*) ;;
     *) command=$argument; break ;;
    esac
   done
   [ "$command" != check ] || refuse_suite
   ;;
  git)
   shift
   sub="" opts=1 value=0
   for argument in "$@"; do
    if [ "$opts" -eq 0 ]; then sub=$argument; break; fi
    if [ "$value" -eq 1 ]; then value=0; continue; fi
    case "$argument" in
     --) opts=0 ;;
     -c|-C|--config-env|--git-dir|--work-tree|--namespace|--super-prefix|--exec-path) value=1 ;;
     -*) ;;
     *) sub=$argument; break ;;
    esac
   done
   case "$sub" in
    rebase|commit|push|merge|reset|cherry-pick|revert|am|pull|checkout|switch|restore|update-ref|clean|apply|add|rm|mv|filter-branch) refuse_branch ;;
    stash) case "${1:-}" in list|show) ;; *) refuse_branch ;; esac ;;
   esac
   ;;
 esac
}

# classify_string COMMAND_TEXT reads each simple command of a `-c` string.
classify_string() {
 segments=$(printf '%s\n' "$1" | tr ';&|()`' '\n\n\n\n\n\n' | tr -d "\"'")
 old_ifs=$IFS
 IFS='
'
 set -f
 for segment in $segments; do
  IFS=$old_ifs
  # shellcheck disable=SC2086
  classify_child $segment
  IFS='
'
 done
 IFS=$old_ifs
 set +f
}

# classify_exec [ARGUMENT...] reads the arguments that follow `mise exec`.
classify_exec() {
 command_string=""
 while [ "$#" -gt 0 ]; do
  case "$1" in
   --) shift; break ;;
   -c|--command)
    if [ "$#" -ge 2 ]; then command_string=$2; shift 2; else shift; fi
    ;;
   --command=*) command_string=${1#--command=}; shift ;;
   -j|--jobs|-E|--env|-C|--cd)
    if [ "$#" -ge 2 ]; then shift 2; else shift; fi
    ;;
   -c?*) command_string=${1#-c}; shift ;;
   -*) shift ;;
   *@*) shift ;;
   *)
    # Without a separator the first plain token is the child; with one,
    # every token before it is a runtime tool.
    separated=0
    for argument in "$@"; do
     if [ "$argument" = "--" ]; then separated=1; break; fi
    done
    [ "$separated" -eq 1 ] || break
    shift
    ;;
  esac
 done
 classify_child "$@"
 [ -z "$command_string" ] || classify_string "$command_string"
}

# classify_mise [ARGUMENT...] reads a whole `mise` invocation. Global options
# precede the subcommand; the first other token names it.
classify_mise() {
 while [ "$#" -gt 0 ]; do
  case "$1" in
   -C|--cd|-E|--env|-j|--jobs) if [ "$#" -ge 2 ]; then shift 2; else shift; fi ;;
   -*) shift ;;
   *) break ;;
  esac
 done
 case "${1:-}" in
  exec|x) shift; classify_exec "$@" ;;
 esac
}

classify_mise "$@"

exec "$LIVESPEC_REVIEW_REAL_MISE" "$@"
