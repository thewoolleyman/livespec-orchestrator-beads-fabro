#!/bin/sh
# The proof_capture Git boundary. Git configuration cannot replace this
# launcher: it receives the full command before Git starts parsing `-c` flags.
#
# The rule it enforces is that proof_capture does not modify the run's
# checkout. A scratch repository a test fixture builds elsewhere is not that
# tree, so `commit` is refused only when the repository the command targets
# shares its common git directory with the checkout named by
# LIVESPEC_PROOF_CAPTURE_PROTECTED_CHECKOUT (the checkout itself, a linked
# worktree of it, or any `-C` / `--git-dir` / `GIT_DIR` route to either).
# `push` is refused for every repository, so a scratch clone publishes nothing.
set -u

readonly_message="LIVESPEC_PROOF_CAPTURE_READ_ONLY: proof_capture is read-only on the repository tree; git commit and git push are refused before repository hooks run. End this turn with preferred_label=fix when a code change is needed."

refuse() {
    echo "$readonly_message" >&2
    exit 1
}

# The absolute, symlink-free common git directory of the repository `git`
# resolves from the arguments given, empty when it resolves none.
common_dir_of() {
    resolved=$(/usr/bin/git "$@" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    (cd "$resolved" 2>/dev/null && pwd -P) || true
}

subcommand=""
options=1
expects_value=0
before_subcommand=0

for argument in "$@"; do
    if [ "$options" -eq 0 ]; then
        subcommand="$argument"
        break
    fi
    if [ "$expects_value" -eq 1 ]; then
        expects_value=0
        before_subcommand=$((before_subcommand + 1))
        continue
    fi
    case "$argument" in
        --)
            options=0
            ;;
        -c|-C|--config-env|--git-dir|--work-tree|--namespace|--super-prefix|--exec-path)
            expects_value=1
            ;;
        --config-env=*|--git-dir=*|--work-tree=*|--namespace=*|--super-prefix=*|--exec-path=*)
            ;;
        -*)
            ;;
        *)
            subcommand="$argument"
            break
            ;;
    esac
    before_subcommand=$((before_subcommand + 1))
done

case "$subcommand" in
    push)
        refuse
        ;;
    commit)
        checkout="${LIVESPEC_PROOF_CAPTURE_PROTECTED_CHECKOUT:-}"
        [ -n "$checkout" ] || refuse
        protected=$(
            unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_NAMESPACE
            common_dir_of -C "$checkout"
        )
        # The target is resolved by Git itself, from the global options in front
        # of the subcommand and the inherited environment, so it is exactly the
        # repository the commit would act on. Anything unresolved fails closed.
        target=$(
            count=$#
            index=0
            while [ "$index" -lt "$count" ]; do
                argument="$1"
                shift
                if [ "$index" -lt "$before_subcommand" ]; then
                    set -- "$@" "$argument"
                fi
                index=$((index + 1))
            done
            common_dir_of "$@"
        )
        if [ -z "$protected" ] || [ -z "$target" ] || [ "$target" = "$protected" ]; then
            refuse
        fi
        # A scratch repository keeps its own hooks: drop only the private
        # hooks-path override this stage's adapter set.
        if [ "${GIT_CONFIG_COUNT:-}" = "1" ] && [ "${GIT_CONFIG_KEY_0:-}" = "core.hooksPath" ]; then
            case "${GIT_CONFIG_VALUE_0:-}" in
                */proof-capture-hooks)
                    unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
                    ;;
            esac
        fi
        ;;
esac

exec /usr/bin/git "$@"
